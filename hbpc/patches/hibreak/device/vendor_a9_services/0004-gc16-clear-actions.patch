+++ b/a9_accessibility_service/src/net/dianqk/hibreak/eink/command_runners/UnixSocketCommandRunner.kt
@@ -54,6 +54,11 @@ class UnixSocketCommandRunner(private val context: Context) : CommandRunner {
             data.writeInterfaceToken("android.ui.ISurfaceComposer")
             if (command == "repaint") {
                 check(sf.transact(1112, data, reply, 0))
+            } else if (command == Commands.FORCE_CLEAR) {
+                // GC16; SurfaceFlinger arms the composer's one-shot mode, repaints and
+                // releases the request after the frame is presented.
+                data.writeInt(4)
+                check(sf.transact(1113, data, reply, 0))
             } else {
                 val fields = command.split(' ').drop(1).map(String::toInt)
                 check(fields.size == 8)
@@ -76,7 +81,9 @@ class UnixSocketCommandRunner(private val context: Context) : CommandRunner {
     private fun deliver(cmds: Array<String>) {
         try {
             val socketCommands = cmds.filter {
-                if (it.startsWith("profile ") || it == "repaint") { displayCommand(it); false }
+                if (it.startsWith("profile ") || it == "repaint" || it == Commands.FORCE_CLEAR) {
+                    displayCommand(it); false
+                }
                 else true
             }
             if (socketCommands.isEmpty()) return
