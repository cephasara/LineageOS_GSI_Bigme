diff --git a/a9_accessibility_service/src/net/dianqk/hibreak/eink/command_runners/UnixSocketCommandRunner.kt b/a9_accessibility_service/src/net/dianqk/hibreak/eink/command_runners/UnixSocketCommandRunner.kt
