     private fun advanced() {
+        // Read by SystemUI when the screen turns off; unknown values show the picture.
+        val labels = SLEEP_SCREEN_LABELS.map(::getString).toTypedArray()
+        fun mode() = SLEEP_SCREEN_MODES.indexOf(Settings.Secure.getString(contentResolver, SLEEP_SCREEN_MODE)).coerceAtLeast(0)
+        ui.row(R.string.eink_sleep_screen, { labels[mode()] }) {
+            MaterialAlertDialogBuilder(this).setTitle(R.string.eink_sleep_screen)
+                .setSingleChoiceItems(labels, mode()) { dialog, which ->
+                    dialog.dismiss()
+                    val value = SLEEP_SCREEN_MODES[which]
+                    // Custom image needs a stored image first; the mode is set once it is saved.
+                    if (value == SLEEP_SCREEN_CUSTOM && !SleepScreenImage.exists(this)) pickSleepImage()
+                    else { Settings.Secure.putString(contentResolver, SLEEP_SCREEN_MODE, value); render() }
+                }.setNegativeButton(android.R.string.cancel, null).show()
+        }
+        ui.note(getString(R.string.eink_sleep_screen_help))
+        if (SLEEP_SCREEN_MODES[mode()] == SLEEP_SCREEN_CUSTOM) {
+            ui.row(R.string.eink_sleep_image, { getString(if (SleepScreenImage.exists(this))
+                R.string.eink_sleep_image_chosen else R.string.eink_sleep_image_none) }) { pickSleepImage() }
+            ui.toggle(R.string.eink_sleep_image_time, R.string.eink_sleep_image_time_help,
+                { Settings.Secure.getInt(contentResolver, SleepScreenImage.SETTING_IMAGE_TIME, 1) != 0 },
+                { if (!updating) Settings.Secure.putInt(contentResolver, SleepScreenImage.SETTING_IMAGE_TIME, if (it) 1 else 0) })
+        }
+        ui.divider()
         ui.row(R.string.eink_service, {
             val manager = getSystemService(AccessibilityManager::class.java)
             val enabled = manager.getEnabledAccessibilityServiceList(AccessibilityServiceInfo.FEEDBACK_ALL_MASK)
@@ -273,5 +299,48 @@ class SettingsActivity : AppCompatActivity(), SharedPreferences.OnSharedPreferen
         }) { startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)) }
     }
 
-    companion object { const val EXTRA_TARGET_APP_ID = "target_app_id" }
+    private val sleepImagePicker = registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) importSleepImage(uri)
+    }
+    private fun pickSleepImage() {
+        try {
+            sleepImagePicker.launch(arrayOf("image/*"))
+        } catch (_: ActivityNotFoundException) {
+            sleepImageError()
+        }
+    }
+    private fun sleepImageError() {
+        MaterialAlertDialogBuilder(this).setMessage(R.string.eink_sleep_image_error)
+            .setPositiveButton(android.R.string.ok, null).show()
+    }
+    /** Decode and store off the main thread, then select the custom image mode. */
+    private fun importSleepImage(uri: Uri) {
+        val app = applicationContext
+        val bounds = windowManager.maximumWindowMetrics.bounds
+        Thread {
+            val stored = try {
+                SleepScreenImage.import(app, uri, bounds.width(), bounds.height()); true
+            } catch (e: Exception) {
+                Log.w("EinkSleepScreen", "custom image import failed", e); false
+            }
+            runOnUiThread {
+                if (isDestroyed) return@runOnUiThread
+                if (stored) {
+                    Settings.Secure.putString(contentResolver, SLEEP_SCREEN_MODE, SLEEP_SCREEN_CUSTOM)
+                    if (page == Page.ADVANCED) render()
+                } else sleepImageError()
+            }
+        }.start()
+    }
+
+    companion object {
+        const val EXTRA_TARGET_APP_ID = "target_app_id"
+        const val SLEEP_SCREEN_MODE = SleepScreenImage.SETTING_MODE
+        const val SLEEP_SCREEN_CUSTOM = "custom"
+        /** Values SystemUI reads; picture is the default. */
+        val SLEEP_SCREEN_MODES = arrayOf("picture", "clock_1", "clock_5", "clock_15", "lockscreen", SLEEP_SCREEN_CUSTOM)
+        val SLEEP_SCREEN_LABELS = intArrayOf(R.string.eink_sleep_picture, R.string.eink_sleep_clock_1,
+            R.string.eink_sleep_clock_5, R.string.eink_sleep_clock_15, R.string.eink_sleep_lock_screen,
+            R.string.eink_sleep_custom)
+    }
 }
diff --git a/a9_accessibility_service/src/net/dianqk/hibreak/eink/SleepScreenImage.kt b/a9_accessibility_service/src/net/dianqk/hibreak/eink/SleepScreenImage.kt
new file mode 100644
index 0000000..497acf8
--- /dev/null
+++ b/a9_accessibility_service/src/net/dianqk/hibreak/eink/SleepScreenImage.kt
@@ -0,0 +1,96 @@
+package net.dianqk.hibreak.eink
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.content.Context
+import android.database.Cursor
+import android.graphics.Bitmap
+import android.graphics.ImageDecoder
+import android.net.Uri
+import android.os.ParcelFileDescriptor
+import android.provider.Settings
+import android.util.Log
+import java.io.File
+import java.io.FileNotFoundException
+import java.io.FileOutputStream
+import java.io.IOException
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+
+/**
+ * Custom sleep screen image. The app keeps its own copy, decoded from the picked document and
+ * downscaled to fit the display, in device-protected storage, so a revoked or deleted source
+ * does not break the sleep screen and SystemUI can read it before the first unlock.
+ */
+object SleepScreenImage {
+    private const val TAG = "EinkSleepScreen"
+    private const val FILE = "sleep_screen_image.png"
+    const val SETTING_MODE = "hibreak_sleep_screen_mode"
+    /** Version token SystemUI uses to reload; empty when no image is stored. */
+    const val SETTING_IMAGE = "hibreak_sleep_screen_image"
+    /** 1 (default): "Locked at" under the image. */
+    const val SETTING_IMAGE_TIME = "hibreak_sleep_screen_image_time"
+
+    fun file(context: Context) = File(context.filesDir, FILE)
+
+    fun exists(context: Context) = file(context).isFile &&
+        !Settings.Secure.getString(context.contentResolver, SETTING_IMAGE).isNullOrEmpty()
+
+    /**
+     * Decode [uri], fit it into the display ([displayWidth] x [displayHeight], used in portrait)
+     * and store it. Call off the main thread.
+     */
+    @Throws(IOException::class)
+    fun import(context: Context, uri: Uri, displayWidth: Int, displayHeight: Int) {
+        val width = min(displayWidth, displayHeight).coerceAtLeast(1)
+        val height = max(displayWidth, displayHeight).coerceAtLeast(1)
+        val bitmap = ImageDecoder.decodeBitmap(ImageDecoder.createSource(context.contentResolver, uri)) { decoder, info, _ ->
+            decoder.allocator = ImageDecoder.ALLOCATOR_SOFTWARE
+            val scale = min(1f, min(width.toFloat() / info.size.width, height.toFloat() / info.size.height))
+            if (scale < 1f) {
+                decoder.setTargetSize((info.size.width * scale).roundToInt().coerceAtLeast(1),
+                    (info.size.height * scale).roundToInt().coerceAtLeast(1))
+            }
+        }
+        val size = "${bitmap.width}x${bitmap.height}"
+        val temp = File(context.filesDir, "$FILE.tmp")
+        try {
+            FileOutputStream(temp).use { out ->
+                if (!bitmap.compress(Bitmap.CompressFormat.PNG, 100, out)) throw IOException("PNG encoding failed")
+                out.fd.sync()
+            }
+        } finally {
+            bitmap.recycle()
+        }
+        if (!temp.renameTo(file(context))) {
+            temp.delete()
+            throw IOException("cannot store the image")
+        }
+        Settings.Secure.putString(context.contentResolver, SETTING_IMAGE, System.currentTimeMillis().toString())
+        Log.i(TAG, "custom image stored $size")
+    }
+}
+
+/**
+ * Read-only access to the stored image for SystemUI: content://net.dianqk.hibreak.eink.sleepscreen/image.
+ * The manifest requires android.permission.STATUS_BAR_SERVICE (signature, held by SystemUI).
+ */
+class SleepScreenImageProvider : ContentProvider() {
+    override fun onCreate() = true
+
+    override fun getType(uri: Uri): String? = if (uri.path == "/image") "image/png" else null
+
+    override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor {
+        if (mode != "r") throw SecurityException("read only")
+        if (uri.path != "/image") throw FileNotFoundException(uri.toString())
+        val file = SleepScreenImage.file(context ?: throw FileNotFoundException("no context"))
+        return ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)
+    }
+
+    override fun query(uri: Uri, projection: Array<out String>?, selection: String?,
+        selectionArgs: Array<out String>?, sortOrder: String?): Cursor? = null
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = throw UnsupportedOperationException()
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?) = 0
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<out String>?) = 0
+}
