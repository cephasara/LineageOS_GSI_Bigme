         filterScreen.addAction(Intent.ACTION_SCREEN_ON)
@@ -90,6 +92,15 @@ class A9AccessibilityService : AccessibilityService(),
         if (wasScreenOn != isScreenOn) brightnessManager.applyBrightness()
     }
 
+    /** Touch scroll mode is for the app: not over the keyguard or shade, not with the screen off. */
+    private fun appWindowInFront(): Boolean {
+        if (!getSystemService(PowerManager::class.java).isInteractive ||
+            getSystemService(KeyguardManager::class.java).isKeyguardLocked) return false
+        // The notification shade (also the keyguard) is a SystemUI system window that takes
+        // focus while expanded. Without the windows list (flag missing) nothing is refused.
+        return windows.none { it.type == AccessibilityWindowInfo.TYPE_SYSTEM && (it.isActive || it.isFocused) }
+    }
+
     override fun onInterrupt() {
         cancelHardwareKeys()
     }
diff --git a/a9_accessibility_service/src/net/dianqk/hibreak/eink/DisplaySettingsManager.kt b/a9_accessibility_service/src/net/dianqk/hibreak/eink/DisplaySettingsManager.kt
