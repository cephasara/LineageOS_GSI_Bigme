index 0000000..4f426b6
--- /dev/null
+++ b/a9_accessibility_service/src/net/dianqk/hibreak/eink/TouchScrollMonitor.kt
@@ -0,0 +1,103 @@
+package net.dianqk.hibreak.eink
+
+import android.hardware.input.InputManagerGlobal
+import android.os.Looper
+import android.os.SystemProperties
+import android.util.Log
+import android.view.Display
+import android.view.InputEvent
+import android.view.InputEventReceiver
+import android.view.InputMonitor
+import android.view.MotionEvent
+import kotlin.math.abs
+import kotlin.math.hypot
+
+/**
+ * Finger drags as scroll events for apps whose scrolling sends no accessibility scroll
+ * events (Chrome, WebView, Flutter). A gesture monitor is a spy: events still reach the
+ * app and pointers are never pilfered. Stylus and mouse input are ignored. A drag starts
+ * after 10 px (the stock threshold); each later move reports its dominant-axis delta.
+ * [allowDrag] is asked once per drag; a refused drag (keyguard, shade, screen off) is ignored.
+ * Kill switch: persist.debug.hibreak.touch_scroll=false (applied at the next app switch).
+ */
+class TouchScrollMonitor(
+    private val looper: Looper,
+    private val allowDrag: () -> Boolean,
+    private val onScroll: (delta: Int, time: Long) -> Unit,
+) {
+    private var monitor: InputMonitor? = null
+    private var receiver: InputEventReceiver? = null
+    private var downX = 0f
+    private var downY = 0f
+    private var lastX = 0f
+    private var lastY = 0f
+    private var dragging = false
+    private var refused = false
+
+    fun setEnabled(wanted: Boolean) {
+        val enabled = wanted && SystemProperties.getBoolean(KILL_SWITCH, true)
+        if (enabled == (monitor != null)) return
+        if (!enabled) {
+            receiver?.dispose()
+            monitor?.dispose()
+            receiver = null
+            monitor = null
+            dragging = false
+            Log.d(TAG, "touch scroll monitor stopped")
+            return
+        }
+        try {
+            val created = InputManagerGlobal.getInstance()
+                .monitorGestureInput("HiBreakEinkScroll", Display.DEFAULT_DISPLAY)
+            monitor = created
+            receiver = object : InputEventReceiver(created.inputChannel, looper) {
+                override fun onInputEvent(event: InputEvent) {
+                    try {
+                        if (event is MotionEvent) onMotion(event)
+                    } finally {
+                        finishInputEvent(event, false)
+                    }
+                }
+            }
+            Log.d(TAG, "touch scroll monitor started")
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "gesture monitor unavailable", e)
+        }
+    }
+
+    private fun onMotion(event: MotionEvent) {
+        if (event.pointerCount < 1 || event.getToolType(0) != MotionEvent.TOOL_TYPE_FINGER) {
+            dragging = false
+            return
+        }
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                downX = event.rawX; downY = event.rawY
+                lastX = downX; lastY = downY
+                dragging = false
+                refused = false
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val x = event.rawX
+                val y = event.rawY
+                if (!dragging && !refused && hypot(x - downX, y - downY) > THRESHOLD_PX) {
+                    dragging = allowDrag()
+                    refused = !dragging
+                }
+                if (dragging) {
+                    val dx = x - lastX
+                    val dy = y - lastY
+                    onScroll((if (abs(dy) >= abs(dx)) dy else dx).toInt(), event.eventTime)
+                }
+                lastX = x; lastY = y
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> dragging = false
+        }
+    }
+
+    companion object {
+        private const val TAG = "HiBreakTouchScroll"
+        private const val KILL_SWITCH = "persist.debug.hibreak.touch_scroll"
+        private const val THRESHOLD_PX = 10f
+    }
+}
