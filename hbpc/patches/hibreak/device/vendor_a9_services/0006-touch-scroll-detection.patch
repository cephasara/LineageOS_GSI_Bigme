 .../hibreak/eink/A9AccessibilityService.kt    |  13 ++-
 .../hibreak/eink/DisplaySettingsManager.kt    |  12 ++
 .../dianqk/hibreak/eink/TouchScrollMonitor.kt | 103 ++++++++++++++++++
 4 files changed, 129 insertions(+), 2 deletions(-)
 create mode 100644 a9_accessibility_service/src/net/dianqk/hibreak/eink/TouchScrollMonitor.kt

