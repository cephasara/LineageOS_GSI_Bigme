     private val finishScrolling = Runnable { setScrolling(false) }
     // A scene writes several display preferences in one apply(); send one batch for them.
     private val applyPending = Runnable { applySettings() }
+    // Only while the foreground app opts into scroll optimization.
+    private val touchScroll = TouchScrollMonitor(handler.looper, touchScrollAllowed) { delta, time ->
+        onViewScrolled(currentAppId, delta, time)
+    }
+
+    private fun updateTouchScroll() = touchScroll.setEnabled(currentAppId.isNotEmpty() &&
+        DisplayProfilePreferences.scrollOptimization(sharedPreferences, currentAppId))
 
     fun onAppChange(packageName: String) {
         if (packageName == currentAppId) return
@@ -58,6 +67,7 @@ class DisplaySettingsManager(
         sharedPreferences.edit()
             .putString(DisplayProfilePreferences.LAST_TARGET_APP, packageName)
             .apply()
+        updateTouchScroll()
         applySettings()
     }
 
@@ -79,6 +89,7 @@ class DisplaySettingsManager(
         ) {
             stopScrolling()
         }
+        if (key == DisplayProfilePreferences.scrollOptimizationKey(currentAppId)) updateTouchScroll()
         handler.removeCallbacks(applyPending)
         handler.post(applyPending)
     }
@@ -98,6 +109,7 @@ class DisplaySettingsManager(
 
     fun destroy() {
         handler.removeCallbacks(applyPending)
+        touchScroll.setEnabled(false)
         stopScrolling()
     }
 
diff --git a/a9_accessibility_service/src/net/dianqk/hibreak/eink/TouchScrollMonitor.kt b/a9_accessibility_service/src/net/dianqk/hibreak/eink/TouchScrollMonitor.kt
