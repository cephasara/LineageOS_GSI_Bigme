@@ -0,0 +1,70 @@
+package net.dianqk.hibreak.eink.button_mapper
+
+import android.app.KeyguardManager
+import android.content.Context
+import android.hardware.input.InputManager
+import android.os.PowerManager
+import android.os.SystemClock
+import android.util.Log
+import android.view.InputDevice
+import android.view.KeyCharacterMap
+import android.view.KeyEvent
+
+/** Send one standard page-key pair to the focused app, not a swipe or media command. */
+class PageButtonAction(private val keyCode: Int) : ButtonAction {
+    init {
+        require(keyCode == KeyEvent.KEYCODE_PAGE_UP || keyCode == KeyEvent.KEYCODE_PAGE_DOWN)
+    }
+
+    override fun execute(context: Context) {
+        val input = context.getSystemService(InputManager::class.java) ?: return
+        // A DOWN whose UP was not accepted must never leave the key pressed.
+        releasePending(input)
+        // Match the existing screen-on-only navigation choices. Do not wake, unlock,
+        // or inject into a keyguard if the state changed while a gesture was pending.
+        if (context.getSystemService(PowerManager::class.java)?.isInteractive != true ||
+            context.getSystemService(KeyguardManager::class.java)?.isKeyguardLocked != false) return
+        val downTime = SystemClock.uptimeMillis()
+        if (!inject(input, event(downTime, KeyEvent.ACTION_DOWN, keyCode, 0))) {
+            Log.w(TAG, "Page key DOWN was not accepted")
+            return
+        }
+        if (!inject(input, event(downTime, KeyEvent.ACTION_UP, keyCode, 0))) {
+            // Retry as a cancelled UP now; if that also fails, on the next action or interrupt.
+            if (!inject(input, event(downTime, KeyEvent.ACTION_UP, keyCode, KeyEvent.FLAG_CANCELED))) {
+                Log.w(TAG, "Page key UP was not accepted; retrying later")
+                synchronized(PageButtonAction) { pending = downTime to keyCode }
+            }
+        }
+    }
+
+    companion object {
+        private const val TAG = "EinkPageKey"
+        private var pending: Pair<Long, Int>? = null
+
+        private fun event(downTime: Long, action: Int, keyCode: Int, flags: Int) = KeyEvent(
+            downTime, SystemClock.uptimeMillis(), action, keyCode, 0, 0,
+            KeyCharacterMap.VIRTUAL_KEYBOARD, 0, flags, InputDevice.SOURCE_KEYBOARD,
+        )
+
+        // Never synchronously wait for dispatch back through accessibility.
+        private fun inject(input: InputManager, event: KeyEvent) = try {
+            input.injectInputEvent(event, InputManager.INJECT_INPUT_EVENT_MODE_ASYNC)
+        } catch (error: SecurityException) {
+            Log.w(TAG, "Page keys require the platform INJECT_EVENTS permission", error)
+            false
+        }
+
+        private fun releasePending(input: InputManager) {
+            val (downTime, keyCode) = synchronized(PageButtonAction) { pending.also { pending = null } } ?: return
+            if (!inject(input, event(downTime, KeyEvent.ACTION_UP, keyCode, KeyEvent.FLAG_CANCELED))) {
+                Log.w(TAG, "Pending page key UP was not accepted")
+            }
+        }
+
+        /** Sends the cancelled UP of a page key left pressed (service interrupt or destroy). */
+        fun releasePending(context: Context) {
+            releasePending(context.getSystemService(InputManager::class.java) ?: return)
+        }
+    }
+}
