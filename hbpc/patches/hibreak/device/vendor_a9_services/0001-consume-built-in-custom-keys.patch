@@ -0,0 +1,54 @@
+package net.dianqk.hibreak.eink
+
+import android.view.InputDevice
+import android.view.KeyEvent
+
+/** Consume only the built-in HiBreak custom keys, not a keyboard's F1/F2. */
+internal class HardwareKeyFilter(
+    private val dispatch: (KeyEvent) -> Unit,
+    private val cancelGesture: (scanCode: Int) -> Unit,
+) {
+    private data class Key(val deviceId: Int, val scanCode: Int)
+    private val presses = mutableMapOf<Key, Long>()
+
+    fun onKeyEvent(event: KeyEvent): Boolean {
+        val key = Key(event.deviceId, event.scanCode)
+        // Keep ownership through UP even if InputDevice disappears during a press.
+        // A reused device ID with another downTime does not inherit that ownership.
+        val owned = presses[key]?.let { it == event.downTime } == true
+        val physical = isCustomKey(event)
+        if (!owned && !physical) return false
+
+        when (event.action) {
+            KeyEvent.ACTION_DOWN -> {
+                if (event.isCanceled) {
+                    // Still own the eventual UP even for a cancelled DOWN.
+                    presses[key] = event.downTime
+                    cancelGesture(event.scanCode)
+                } else if (physical && event.repeatCount == 0 && !owned) {
+                    // A fresh DOWN supersedes a lost UP, without a stale long-press action.
+                    if (presses.containsKey(key)) cancelGesture(event.scanCode)
+                    presses[key] = event.downTime
+                    dispatch(event)
+                }
+                // Duplicate/repeated DOWNs are consumed, never new gestures.
+            }
+            KeyEvent.ACTION_UP -> {
+                if (owned) {
+                    presses.remove(key)
+                    dispatch(event)
+                }
+                // Orphan UPs from the built-in keys are swallowed without an action.
+            }
+            // ACTION_MULTIPLE is not a physical gesture; consume without dispatching.
+        }
+        return true
+    }
+
+    private fun isCustomKey(event: KeyEvent): Boolean {
+        if (event.scanCode != 59 && event.scanCode != 60) return false
+        val device = event.device ?: return false
+        return device.name == "mtk-kpd" && !device.isExternal && !device.isVirtual &&
+            device.supportsSource(InputDevice.SOURCE_KEYBOARD)
+    }
+}
