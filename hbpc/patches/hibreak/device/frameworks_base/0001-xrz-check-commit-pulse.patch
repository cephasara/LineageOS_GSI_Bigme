+++ b/services/core/java/com/android/server/power/PowerManagerService.java
@@ -337,6 +337,8 @@ public final class PowerManagerService extends SystemService
     private final Context mContext;
     private final ServiceThread mHandlerThread;
     private final Handler mHandler;
+    // HiBreak: XRZ anti-ghosting window after touch/button input; null on other panels.
+    private final HiBreakXrzCheckCommit mXrzCheckCommit;
     private final AmbientDisplayConfiguration mAmbientDisplayConfiguration;
     @Nullable
     private final BatterySaverStateMachine mBatterySaverStateMachine;
@@ -1283,6 +1285,7 @@ public final class PowerManagerService extends SystemService
         mHandlerThread.start();
         mHandler = injector.createHandler(mHandlerThread.getLooper(),
                 new PowerManagerHandlerCallback());
+        mXrzCheckCommit = HiBreakXrzCheckCommit.create(mHandlerThread.getLooper());
         mConstants = new Constants(mHandler);
         mAmbientDisplayConfiguration = mInjector.createAmbientDisplayConfiguration(context);
         mAmbientDisplaySuppressionController =
@@ -2281,6 +2284,9 @@ public final class PowerManagerService extends SystemService
 
     private void userActivityInternal(int displayId, long eventTime,
             @PowerManager.UserActivityEvent int event, int flags, int uid) {
+        if (mXrzCheckCommit != null) {
+            mXrzCheckCommit.onUserActivity(event);
+        }
         synchronized (mLock) {
             if (displayId == Display.INVALID_DISPLAY) {
                 if (userActivityNoUpdateLocked(eventTime, event, flags, uid)) {
