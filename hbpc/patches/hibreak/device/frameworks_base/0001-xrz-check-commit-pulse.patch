+package com.android.server.power;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.os.PowerManager;
+import android.os.SystemProperties;
+import android.util.Slog;
+
+/**
+ * HiBreak Pro Color: open the XRZ composer's anti-ghosting window after user input.
+ *
+ * The vendor HWC counts large updates toward the per-app clean frequency only while
+ * {@code vendor.xrz.check_commit} is 1. Like the stock PowerManagerService, set it to 1 on
+ * touch or button user activity and back to 0 800 ms after the last such activity.
+ * The property is written only on 0 -> 1 and 1 -> 0 transitions, on the given looper.
+ * Active only when {@code ro.bigme.force_client_composition} is true (the XRZ panel).
+ */
+final class HiBreakXrzCheckCommit extends Handler {
+    private static final String TAG = "HiBreakXrzCheckCommit";
+    private static final String PROPERTY = "vendor.xrz.check_commit";
+    private static final long RESET_DELAY_MS = 800;
+    private static final int MSG_ACTIVITY = 1;
+    private static final int MSG_RESET = 2;
+
+    private boolean mOpen;
+    private boolean mWarned;
+
+    private HiBreakXrzCheckCommit(Looper looper) {
+        super(looper);
+    }
+
+    /** Returns null on devices without the XRZ panel. */
+    static HiBreakXrzCheckCommit create(Looper looper) {
+        if (!SystemProperties.getBoolean("ro.bigme.force_client_composition", false)) return null;
+        return new HiBreakXrzCheckCommit(looper);
+    }
+
+    /** Called for every user activity; cheap, may run on any thread. */
+    void onUserActivity(@PowerManager.UserActivityEvent int event) {
+        if (event == PowerManager.USER_ACTIVITY_EVENT_TOUCH
+                || event == PowerManager.USER_ACTIVITY_EVENT_BUTTON) {
+            sendEmptyMessage(MSG_ACTIVITY);
+        }
+    }
+
+    @Override
+    public void handleMessage(Message msg) {
+        switch (msg.what) {
+            case MSG_ACTIVITY:
+                if (!mOpen) {
+                    mOpen = set("1");
+                }
+                removeMessages(MSG_RESET);
+                sendEmptyMessageDelayed(MSG_RESET, RESET_DELAY_MS);
+                break;
+            case MSG_RESET:
+                if (mOpen) {
+                    set("0");
+                    mOpen = false;
+                }
+                break;
+        }
+    }
+
+    private boolean set(String value) {
+        try {
+            SystemProperties.set(PROPERTY, value);
+            return true;
+        } catch (RuntimeException e) {
+            // A failing set is retried on every input burst; warn once.
+            if (!mWarned) Slog.w(TAG, "cannot set " + PROPERTY + "=" + value + ": " + e);
+            mWarned = true;
+            return false;
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/power/PowerManagerService.java b/services/core/java/com/android/server/power/PowerManagerService.java
index a8ed63f9d..46ab4d968 100644
