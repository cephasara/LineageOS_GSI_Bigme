+package com.android.internal.telephony;
+
+import android.annotation.NonNull;
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.os.SystemProperties;
+
+import com.android.telephony.Rlog;
+
+/**
+ * HiBreak Pro Color: no 5G (NR) while Wi-Fi is the system default network.
+ *
+ * <p>With 5G SA and Wi-Fi connected, incoming calls stopped arriving after a few idle
+ * minutes; with Wi-Fi off, or on LTE, they did not (cause not established). After Wi-Fi
+ * has been the system default network for {@link #DEBOUNCE_MS}, the phone masks NR out of
+ * its effective allowed network types (see {@link Phone#setHiBreakNrBlockedOnWifi}); it
+ * allows NR again as soon as Wi-Fi stops being the default. Neither change is applied
+ * during a call on any phone: it waits until all phones are idle. The mask is runtime
+ * state only: no allowed-network-types reason or subscription database value changes,
+ * so nothing survives a reboot.
+ */
+public final class HiBreakNrOffOnWifi extends ConnectivityManager.NetworkCallback {
+    private static final String TAG = "HBPC_NR_WIFI";
+    private static final String ENABLE_PROPERTY = "persist.radio.hibreak_nr_off_on_wifi";
+    private static final long DEBOUNCE_MS = 10_000;
+    private static final long CALL_RETRY_MS = 2_000;
+
+    private final GsmCdmaPhone mPhone;
+    private final Runnable mApply = this::apply;
+    private Network mDefault;
+    private boolean mWifiDefault;
+
+    private HiBreakNrOffOnWifi(GsmCdmaPhone phone) {
+        mPhone = phone;
+    }
+
+    /** Start watching the system default network for one phone; nothing on other devices. */
+    public static void start(@NonNull GsmCdmaPhone phone) {
+        if (!isTargetDevice()) return;
+        ConnectivityManager cm = phone.getContext().getSystemService(ConnectivityManager.class);
+        if (cm == null) {
+            Rlog.e(TAG, "phoneId=" + phone.getPhoneId() + " no ConnectivityManager");
+            return;
+        }
+        try {
+            // Callbacks and the delayed apply run on the phone's own handler thread.
+            cm.registerSystemDefaultNetworkCallback(new HiBreakNrOffOnWifi(phone), phone);
+        } catch (RuntimeException e) {
+            Rlog.e(TAG, "phoneId=" + phone.getPhoneId() + " cannot track default network", e);
+        }
+    }
+
+    private static boolean isTargetDevice() {
+        // Public/exported build properties, as the other HiBreak telephony patches use.
+        return "Bigme".equals(SystemProperties.get("ro.product.vendor.manufacturer"))
+                && "HiBreak".equals(SystemProperties.get("ro.product.vendor.model"))
+                && "mt6877".equals(SystemProperties.get("ro.board.platform"));
+    }
+
+    private static boolean isEnabled() {
+        return SystemProperties.getBoolean(ENABLE_PROPERTY, true);
+    }
+
+    @Override
+    public void onAvailable(@NonNull Network network) {
+        mDefault = network;
+    }
+
+    @Override
+    public void onCapabilitiesChanged(@NonNull Network network,
+            @NonNull NetworkCapabilities caps) {
+        mDefault = network;
+        update(caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI));
+    }
+
+    @Override
+    public void onLost(@NonNull Network network) {
+        if (network.equals(mDefault)) {
+            mDefault = null;
+            update(false);
+        }
+    }
+
+    private boolean wanted() {
+        return mWifiDefault && isEnabled();
+    }
+
+    private void update(boolean wifiDefault) {
+        mWifiDefault = wifiDefault;
+        if (wanted() == mPhone.isHiBreakNrBlockedOnWifi()) {
+            mPhone.removeCallbacks(mApply);
+        } else if (!wanted()) {
+            // Allow NR again at once (or as soon as no call is active).
+            mPhone.removeCallbacks(mApply);
+            apply();
+        } else if (!mPhone.hasCallbacks(mApply)) {
+            // Drop NR only after Wi-Fi stayed the default network for DEBOUNCE_MS.
+            mPhone.postDelayed(mApply, DEBOUNCE_MS);
+        }
+    }
+
+    private void apply() {
+        boolean blocked = wanted();
+        if (mPhone.isHiBreakNrBlockedOnWifi() == blocked) return;
+        if (isCallActive() || (blocked && (mPhone.isInEmergencyCall() || mPhone.isInEcm()))) {
+            // Never change the radio access during a call or emergency callback mode.
+            mPhone.postDelayed(mApply, CALL_RETRY_MS);
+            return;
+        }
+        Rlog.i(TAG, "phoneId=" + mPhone.getPhoneId() + (blocked
+                ? " Wi-Fi is the default network: NR off" : " NR allowed again"));
+        mPhone.setHiBreakNrBlockedOnWifi(blocked);
+    }
+
+    private static boolean isCallActive() {
+        try {
+            for (Phone phone : PhoneFactory.getPhones()) {
+                if (phone.getState() != PhoneConstants.State.IDLE) return true;
+            }
+        } catch (RuntimeException e) {
+            return true;  // Phones not ready yet: try again later.
+        }
+        return false;
+    }
+}
diff --git a/src/java/com/android/internal/telephony/Phone.java b/src/java/com/android/internal/telephony/Phone.java
index 80dee28..9905b7d 100644
--- a/src/java/com/android/internal/telephony/Phone.java
+++ b/src/java/com/android/internal/telephony/Phone.java
@@ -489,6 +489,7 @@ public abstract class Phone extends Handler implements PhoneInternalInterface {
     private static final int INVALID_ALLOWED_NETWORK_TYPES = -1;
     protected boolean mIsCarrierNrSupported = false;
     protected boolean mIsAllowedNetworkTypesLoadedFromDb = false;
+    private volatile boolean mHiBreakNrBlockedOnWifi = false;
     private boolean mUnitTestMode;
 
     protected VoiceCallSessionStats mVoiceCallSessionStats;
@@ -2316,6 +2317,11 @@ public abstract class Phone extends Handler implements PhoneInternalInterface {
         if (!mIsCarrierNrSupported) {
             allowedNetworkTypes &= ~TelephonyManager.NETWORK_TYPE_BITMASK_NR;
         }
+        // HiBreak: no NR while Wi-Fi is the default network, unless that would leave no LTE.
+        if (mHiBreakNrBlockedOnWifi
+                && (allowedNetworkTypes & TelephonyManager.NETWORK_TYPE_BITMASK_LTE) != 0) {
+            allowedNetworkTypes &= ~TelephonyManager.NETWORK_TYPE_BITMASK_NR;
+        }
         if (m2gAdminUpdater.isCellular2gDisabled()) {
             logd("SubId " + getSubId()
                     + " disabling 2g in getEffectiveAllowedNetworkTypes according to admin user "
@@ -2327,6 +2333,21 @@ public abstract class Phone extends Handler implements PhoneInternalInterface {
         return allowedNetworkTypes;
     }
 
+    /** HiBreak: whether NR is masked out because Wi-Fi is the default network. */
+    public boolean isHiBreakNrBlockedOnWifi() {
+        return mHiBreakNrBlockedOnWifi;
+    }
+
+    /**
+     * HiBreak: mask NR out of the effective allowed network types (runtime only, never
+     * stored) and send the result to the modem.
+     */
+    public void setHiBreakNrBlockedOnWifi(boolean blocked) {
+        if (mHiBreakNrBlockedOnWifi == blocked) return;
+        mHiBreakNrBlockedOnWifi = blocked;
+        sendSubscriptionSettings(false);
+    }
+
     /**
      * Notify the latest allowed network types changed.
      */
