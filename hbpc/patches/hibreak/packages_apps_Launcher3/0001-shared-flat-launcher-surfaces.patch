+                if (isShortcutContainer(view) || view.getParent() == this) {
+                    gd.setColor(mColors[0]);
+                    gd.setStroke(mFlatOutlineWidth, mFlatOutlineColor);
+                } else {
+                    gd.setColor(Color.TRANSPARENT);
+                    gd.setStroke(0, Color.TRANSPARENT);
+                }
+                return;
+            }
             int oldColor = ((GradientDrawable) bg).getColor().getDefaultColor();
