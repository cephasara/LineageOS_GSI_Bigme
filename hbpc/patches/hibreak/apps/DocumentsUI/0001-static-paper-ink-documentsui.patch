+package com.android.documentsui.ui;
+
+import android.content.ContentResolver;
+import android.graphics.Color;
+import android.view.View;
+import android.widget.ProgressBar;
+
+import com.android.documentsui.R;
+import com.google.android.material.progressindicator.AnimatorDurationScaleProvider;
+import com.google.android.material.progressindicator.BaseProgressIndicator;
+
+/** Presentation-only configuration for the app's explicitly owned progress views. */
+public final class EinkPresentation {
+    private EinkPresentation() {}
+
+    public static void staticProgress(View view) {
+        if (view instanceof BaseProgressIndicator<?>) {
+            BaseProgressIndicator<?> indicator = (BaseProgressIndicator<?>) view;
+            // Use Material's native animator-off path, including its completion callback
+            // when indeterminate work acquires a measured progress value. Do not change
+            // global settings or fake task completion to stop a spinner.
+            indicator.setAnimatorDurationScaleProvider(new AnimatorDurationScaleProvider() {
+                @Override
+                public float getSystemAnimatorDurationScale(ContentResolver resolver) {
+                    return 0f;
+                }
+            });
+            indicator.setIndicatorColor(Color.BLACK);
+            indicator.setTrackColor(Color.WHITE);
+            indicator.setShowAnimationBehavior(BaseProgressIndicator.SHOW_NONE);
+            indicator.setHideAnimationBehavior(BaseProgressIndicator.HIDE_NONE);
+            if (indicator.getIndeterminateDrawable() != null) {
+                indicator.getIndeterminateDrawable().setStaticDummyDrawable(
+                        view.getContext().getDrawable(R.drawable.eink_busy));
+            }
+        } else if (view instanceof ProgressBar) {
+            ((ProgressBar) view).setIndeterminateDrawable(
+                    view.getContext().getDrawable(R.drawable.eink_busy));
+        }
+    }
+}
