+package com.android.documentsui.dirlist;
+
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.view.View;
+
+import androidx.recyclerview.widget.RecyclerView;
+
+import java.util.function.BooleanSupplier;
+
+/** Paint separators inside list rows; never allocate space or decorate grid tiles. */
+public final class EinkListDividers extends RecyclerView.ItemDecoration {
+    private final Paint mPaint = new Paint();
+    private final BooleanSupplier mListMode;
+
+    public EinkListDividers(BooleanSupplier listMode) {
+        mListMode = listMode;
+        mPaint.setColor(Color.BLACK);
+        mPaint.setAntiAlias(false);
+    }
+
+    @Override
+    public void onDrawOver(Canvas canvas, RecyclerView parent, RecyclerView.State state) {
+        RecyclerView.Adapter<?> adapter = parent.getAdapter();
+        if (!mListMode.getAsBoolean() || adapter == null) return;
+        int save = canvas.save();
+        canvas.clipRect(parent.getPaddingLeft(), parent.getPaddingTop(),
+                parent.getWidth() - parent.getPaddingRight(),
+                parent.getHeight() - parent.getPaddingBottom());
+        for (int i = 0; i < parent.getChildCount(); i++) {
+            View row = parent.getChildAt(i);
+            int position = parent.getChildAdapterPosition(row);
+            if (position == RecyclerView.NO_POSITION || position >= adapter.getItemCount() - 1) {
+                continue;
+            }
+            int type = adapter.getItemViewType(position);
+            if (type != DocumentsAdapter.ITEM_TYPE_DOCUMENT
+                    && type != DocumentsAdapter.ITEM_TYPE_DIRECTORY) continue;
+            // A selected or focused row draws its own pill; no rule across it or next to it.
+            View next = parent.getLayoutManager() == null ? null
+                    : parent.getLayoutManager().findViewByPosition(position + 1);
+            if (marked(row) || (next != null && marked(next))) continue;
+            int bottom = row.getBottom() + Math.round(row.getTranslationY());
+            int dx = Math.round(row.getTranslationX());
+            // Filled integer rectangle, exactly one physical pixel, above the
+            // white row background. No dp scaling, half-pixel antialias or offsets.
+            canvas.drawRect(row.getLeft() + dx, bottom - 1, row.getRight() + dx, bottom, mPaint);
+        }
+        canvas.restoreToCount(save);
+    }
+
+    private static boolean marked(View row) {
+        return row.isActivated() || row.isSelected() || row.hasFocus();
+    }
+}
