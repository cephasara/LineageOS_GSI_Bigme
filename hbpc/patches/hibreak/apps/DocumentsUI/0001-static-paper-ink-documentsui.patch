+package com.android.documentsui.ui;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.util.Log;
+import android.view.View;
+import android.widget.OverScroller;
+
+import androidx.customview.widget.ViewDragHelper;
+import androidx.drawerlayout.widget.DrawerLayout;
+
+import java.lang.reflect.Field;
+
+/** App-local static completion of DrawerLayout's own destinations and callbacks. */
+public class DocumentsDrawerLayout extends DrawerLayout {
+    private Settler[] mSettlers;
+
+    public DocumentsDrawerLayout(Context context) {
+        this(context, null);
+    }
+
+    public DocumentsDrawerLayout(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        try {
+            // These are APK-bundled AndroidX fields, NOT hidden platform APIs.
+            // Keep their names in proguard.flags and verify the packaged fields.
+            Field left = field(DrawerLayout.class, "mLeftDragger");
+            Field right = field(DrawerLayout.class, "mRightDragger");
+            Field scroller = field(ViewDragHelper.class, "mScroller");
+            mSettlers = new Settler[] {
+                new Settler((ViewDragHelper) left.get(this), scroller),
+                new Settler((ViewDragHelper) right.get(this), scroller)
+            };
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            // A changed library must not break file access or leave a half-open
+            // drawer. Offline compatibility checks reject this for our release.
+            Log.w("DocumentsDrawerLayout", "Static drawer unavailable; using native completion", e);
+        }
+    }
+
+    private static Field field(Class<?> owner, String name) throws NoSuchFieldException {
+        Field field = owner.getDeclaredField(name);
+        field.setAccessible(true);
+        return field;
+    }
+
+    @Override
+    public void openDrawer(View drawer, boolean animate) {
+        super.openDrawer(drawer, false);
+        finishPreviousSettle(drawer);
+    }
+
+    @Override
+    public void closeDrawer(View drawer, boolean animate) {
+        super.closeDrawer(drawer, false);
+        finishPreviousSettle(drawer);
+    }
+
+    private void finishPreviousSettle(View drawer) {
+        if (mSettlers != null) {
+            for (Settler settler : mSettlers) {
+                settler.stopAtCurrentPosition(drawer);
+            }
+        }
+    }
+
+    @Override
+    public void computeScroll() {
+        if (mSettlers != null) {
+            for (Settler settler : mSettlers) {
+                settler.finish();
+            }
+        }
+        // Native continueSettling(true) moves children and defers IDLE callbacks
+        // out of drawing. Do not dispatch opened/closed callbacks from draw code.
+        super.computeScroll();
+    }
+
+    private static final class Settler {
+        private final ViewDragHelper mHelper;
+        private final OverScroller mScroller;
+
+        Settler(ViewDragHelper helper, Field scroller) throws IllegalAccessException {
+            mHelper = helper;
+            mScroller = java.util.Objects.requireNonNull((OverScroller) scroller.get(helper));
+        }
+
+        void stopAtCurrentPosition(View drawer) {
+            if (mHelper.getViewDragState() == ViewDragHelper.STATE_SETTLING
+                    && mHelper.getCapturedView() == drawer) {
+                // A no-animation API request must supersede an earlier peek or
+                // release target. Native zero-distance settling aborts that old
+                // scroller and delivers IDLE without adding OPENING/CLOSING flags.
+                // Never cancel a finger-following STATE_DRAGGING operation.
+                mHelper.smoothSlideViewTo(drawer, drawer.getLeft(), drawer.getTop());
+            }
+        }
+
+        void finish() {
+            if (mHelper.getViewDragState() == ViewDragHelper.STATE_SETTLING) {
+                // Keep the native velocity/threshold/RTL-selected destination.
+                // Do NOT abort the helper: that would cancel pointer tracking and
+                // report a final offset without actually moving the child view.
+                // super.computeScroll() below still owns movement and completion.
+                mScroller.abortAnimation();
+            }
+        }
+    }
+}
