+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.contacts.widget;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.util.AttributeSet;
+import android.view.View;
+import androidx.drawerlayout.widget.DrawerLayout;
+
+/** Static programmatic drawer transitions; drag acceptance and release physics stay native. */
+public final class EinkDrawerLayout extends DrawerLayout {
+    public EinkDrawerLayout(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setScrimColor(Color.TRANSPARENT);
+        setDrawerElevation(0f);
+    }
+
+    @Override
+    public void openDrawer(View drawerView, boolean animate) {
+        super.openDrawer(drawerView, false);
+    }
+
+    @Override
