diff --git a/quickstep/src/com/android/quickstep/util/RectFSpringAnim.java b/quickstep/src/com/android/quickstep/util/RectFSpringAnim.java
index 993968d..f4a8ed4 100644
--- a/quickstep/src/com/android/quickstep/util/RectFSpringAnim.java
+++ b/quickstep/src/com/android/quickstep/util/RectFSpringAnim.java
@@ -105,6 +105,7 @@ public class RectFSpringAnim extends ReleaseCheck {
     private SpringAnimation mRectYSpring;
     private SpringAnimation mRectScaleAnim;
     private boolean mAnimsStarted;
+    private boolean mFinishingImmediately;
     private boolean mRectXAnimEnded;
     private boolean mRectYAnimEnded;
     private boolean mRectScaleAnimEnded;
@@ -289,8 +290,30 @@ public class RectFSpringAnim extends ReleaseCheck {
         }
     }
 
-    public void end() {
+    /** Apply one final frame with the normal lifecycle, without scheduling any spring frames. */
+    public void finishImmediately() {
+        if (isEnded()) return;
         if (mAnimsStarted) {
+            throw new IllegalStateException("finishImmediately must precede start");
+        }
+        setCanRelease(false);
+        mFinishingImmediately = true;
+        mAnimsStarted = true;
+        mRectXAnimEnded = mRectYAnimEnded = mRectScaleAnimEnded = false;
+        for (Animator.AnimatorListener listener : mAnimatorListeners) {
+            listener.onAnimationStart(null);
+            if (!mAnimsStarted) return; // A start callback may cancel and release the target.
+        }
+        mCurrentCenterX = mTargetRect.centerX();
+        mCurrentY = getTrackedYFromRect(mTargetRect);
+        mCurrentScaleProgress = 1f;
+        onUpdate();
+        mRectXAnimEnded = mRectYAnimEnded = mRectScaleAnimEnded = true;
+        maybeOnEnd();
+    }
+
+    public void end() {
+        if (mAnimsStarted && !mFinishingImmediately) {
             if (mRectXSpring.canSkipToEnd()) {
                 mRectXSpring.skipToEnd();
             }
