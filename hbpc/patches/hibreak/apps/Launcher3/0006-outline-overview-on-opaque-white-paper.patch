diff --git a/quickstep/src/com/android/quickstep/views/EinkOverviewUi.java b/quickstep/src/com/android/quickstep/views/EinkOverviewUi.java
new file mode 100644
index 0000000..a3a1d15
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/views/EinkOverviewUi.java
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.quickstep.views;
+
+import android.animation.Animator;
+import android.animation.AnimatorSet;
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Color;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.GradientDrawable;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import com.android.launcher3.R;
+
+/** Product presentation for Overview; task operations and gesture recognition stay native. */
+public final class EinkOverviewUi {
+    private EinkOverviewUi() {}
+
+    public static boolean isEnabled(Context context) {
+        return context.getResources().getBoolean(R.bool.config_flatLauncherSurfaces);
+    }
+
+    /** White paper with the overview edge (whole pixels, overview ink) in the chip radius. */
+    public static GradientDrawable paper(Context context) {
+        GradientDrawable drawable = new GradientDrawable();
+        drawable.setColor(context.getColor(R.color.overview_paper));
+        drawable.setCornerRadius(context.getResources().getDimension(
+                R.dimen.app_chip_round_corner_radius));
+        drawable.setStroke(context.getResources().getDimensionPixelSize(
+                R.dimen.overview_outline_width), context.getColor(R.color.overview_ink));
+        return drawable;
+    }
+
+    /**
+     * Style a task menu: a white root whose edge is drawn as foreground, above the options
+     * that fill it; option rows keep their own state selectors, plain child fills are dropped.
+     */
+    public static void styleMenuRoot(ViewGroup menu) {
+        styleMenu(menu, true);
+        Context context = menu.getContext();
+        GradientDrawable fill = paper(context);
+        fill.setStroke(0, Color.TRANSPARENT);
+        menu.setBackground(fill);
+        GradientDrawable edge = paper(context);
+        edge.setColor(Color.TRANSPARENT);
+        menu.setForeground(edge);
+    }
+
+    public static void styleMenu(View view) {
+        styleMenu(view, true);
+    }
+
+    private static void styleMenu(View view, boolean root) {
+        view.setElevation(0f);
+        view.setStateListAnimator(null);
+        view.setForeground(null);
+        if (view instanceof TextView text) {
+            text.setTextColor(Color.BLACK);
+            text.setShadowLayer(0, 0, 0, Color.TRANSPARENT);
+        } else if (view instanceof ImageView icon) {
+            icon.setImageTintList(ColorStateList.valueOf(Color.BLACK));
+        }
+        if (view instanceof ViewGroup group) {
+            if (root) {
+                view.setBackgroundColor(Color.WHITE);
+            } else if (view.getBackground() instanceof ColorDrawable) {
+                view.setBackground(null);
+            }
+            for (int i = 0; i < group.getChildCount(); i++) styleMenu(group.getChildAt(i), false);
+        }
+    }
+
+    public static void makeStatic(Animator animator) {
+        animator.setStartDelay(0);
+        animator.setDuration(0);
+        if (animator instanceof AnimatorSet set) {
+            for (Animator child : set.getChildAnimations()) makeStatic(child);
+        }
+    }
+}
