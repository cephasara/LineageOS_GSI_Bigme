@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Static threshold-triggered drawer with a flat white surface. Product opt-in. -->
+    <bool name="config_staticAllApps">false</bool>
+    <color name="all_apps_static_surface">#FFFFFFFF</color>
+    <color name="all_apps_static_outline">#FF000000</color>
