+package com.android.launcher3.allapps;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.view.ContextThemeWrapper;
+
+import com.android.launcher3.R;
+
+/** A local light context for content drawn on the static white drawer. */
+final class StaticAllAppsContext {
+    static Context wrap(Context context) {
+        if (!context.getResources().getBoolean(R.bool.config_staticAllApps)) return context;
+        ContextThemeWrapper wrapper = new ContextThemeWrapper(context, R.style.LauncherTheme);
+        Configuration override = new Configuration();
+        override.uiMode = Configuration.UI_MODE_NIGHT_NO;
+        wrapper.applyOverrideConfiguration(override);
+        return wrapper;
+    }
+
+    private StaticAllAppsContext() { }
+}
