+package com.android.launcher3.touch;
+
+/** One commit per touch stream; release velocity cannot bypass the distance threshold. */
+public final class AllAppsThreshold {
+    private boolean mCommitted;
+
+    public void reset() {
+        mCommitted = false;
+    }
+
+    /** Vertical displacement in pixels, after the native detector subtracts touch slop. */
+    public boolean update(float displacement, boolean opening, float threshold) {
+        float distance = opening ? -displacement : displacement;
+        if (mCommitted || !Float.isFinite(distance) || distance < threshold) {
+            return false;
+        }
+        mCommitted = true;
+        return true;
+    }
+
+    public boolean isCommitted() {
+        return mCommitted;
+    }
+}
