+/* Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.launcher3.anim;
+
+import static org.junit.Assert.assertEquals;
+
+import android.animation.ValueAnimator;
+
+import androidx.test.runner.AndroidJUnit4;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+@RunWith(AndroidJUnit4.class)
+public class DeferredPlaybackTest {
+    @Test
+    public void dragRecordsProgressWithoutApplyingIntermediateValues() {
+        int[] updates = {0};
+        float[] value = {0};
+        ValueAnimator child = ValueAnimator.ofFloat(0, 1);
+        child.addUpdateListener(animation -> {
+            updates[0]++;
+            value[0] = (float) animation.getAnimatedValue();
+        });
+        PendingAnimation pending = new PendingAnimation(100);
+        pending.add(child);
+        AnimatorPlaybackController controller = pending.createPlaybackController();
+        for (float progress : new float[]{0.2f, 0.6f, 1.2f, 0.3f}) {
+            controller.setPlayFraction(progress, false);
+            assertEquals(progress, controller.getProgressFraction(), 0.0001f);
+        }
+        assertEquals(0, updates[0]);
+        controller.setPlayFraction(1);
+        assertEquals(1f, value[0], 0.0001f);
+    }
+
+    @Test
+    public void cancellationStillBlocksChildUpdatesUntilRestart() {
+        int[] updates = {0};
+        ValueAnimator child = ValueAnimator.ofFloat(0, 1);
+        child.addUpdateListener(animation -> updates[0]++);
+        PendingAnimation pending = new PendingAnimation(100);
+        pending.add(child);
+        AnimatorPlaybackController controller = pending.createPlaybackController();
+        controller.dispatchOnCancel();
+        controller.setPlayFraction(0.8f, false);
+        controller.setPlayFraction(1);
+        assertEquals(0, updates[0]);
+        controller.dispatchOnStart();
+        controller.setPlayFraction(0);
+        assertEquals(1, updates[0]);
+    }
+}
