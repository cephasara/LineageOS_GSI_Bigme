+ */
+package com.android.launcher3;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+
+import androidx.test.InstrumentationRegistry;
+import androidx.test.runner.AndroidJUnit4;
+
+import com.android.launcher3.pageindicators.PageIndicatorDots;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+@RunWith(AndroidJUnit4.class)
+public class ReleaseOnlyPagedViewTest {
+    private TestPager mPager;
+    private long mTime;
+
+    private static class TestPager extends PagedView<PageIndicatorDots> {
+        boolean fling;
+        TestPager(Context context) { super(context); }
+        @Override protected boolean isPageSwipeOnReleaseEnabled() { return true; }
+        @Override protected boolean shouldFlingForVelocity(int velocity) { return fling; }
+    }
+
+    @Before
+    public void setup() {
+        mPager = new TestPager(InstrumentationRegistry.getTargetContext());
+        for (int i = 0; i < 3; i++) {
+            mPager.addView(new View(mPager.getContext()), new ViewGroup.LayoutParams(1000, 600));
+        }
+        mPager.measure(View.MeasureSpec.makeMeasureSpec(1000, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(600, View.MeasureSpec.EXACTLY));
+        mPager.layout(0, 0, 1000, 600);
+        mPager.setCurrentPage(0);
+        mTime = 0;
+    }
+
+    private void event(int action, float x) {
+        mTime += 100;
+        MotionEvent event = MotionEvent.obtain(100, mTime, action, x, 300, 0);
+        mPager.onTouchEvent(event);
+        event.recycle();
+    }
+
+    private void drag(float end) {
+        event(MotionEvent.ACTION_DOWN, 800);
+        event(MotionEvent.ACTION_MOVE, 700);
+        event(MotionEvent.ACTION_MOVE, end);
+        assertTrue(mPager.isHandlingTouch());
+        assertEquals(0, mPager.getScrollX());
+    }
+
+    @Test
+    public void pastThresholdOnlyChangesPageOnRelease() {
+        drag(200);
+        assertEquals(0, mPager.getNextPage());
+        event(MotionEvent.ACTION_UP, 200);
+        assertEquals(1, mPager.getNextPage());
+        assertEquals(mPager.getScrollForPage(1), mPager.getScrollX());
+    }
+
+    @Test
+    public void insufficientDistanceStaysOnOriginalPage() {
+        drag(600);
+        event(MotionEvent.ACTION_UP, 600);
+        assertEquals(0, mPager.getNextPage());
+        assertEquals(0, mPager.getScrollX());
+    }
+
+    @Test
+    public void retreatBelowThresholdStaysOnOriginalPage() {
+        drag(200);
+        event(MotionEvent.ACTION_MOVE, 600);
+        event(MotionEvent.ACTION_UP, 600);
+        assertEquals(0, mPager.getNextPage());
+    }
+
+    @Test
+    public void cancelPastThresholdDoesNotCommit() {
+        drag(200);
+        event(MotionEvent.ACTION_CANCEL, 200);
+        assertEquals(0, mPager.getNextPage());
+        assertEquals(0, mPager.getScrollX());
+    }
+
+    @Test
+    public void flingUsesOriginalDirectionEvenBelowDistanceThreshold() {
+        mPager.fling = true;
+        drag(600);
+        event(MotionEvent.ACTION_UP, 550);
+        assertEquals(1, mPager.getNextPage());
+    }
+
+    @Test
+    public void firstPageBoundaryDoesNotOverscroll() {
+        event(MotionEvent.ACTION_DOWN, 200);
+        event(MotionEvent.ACTION_MOVE, 300);
+        event(MotionEvent.ACTION_MOVE, 800);
+        assertEquals(0, mPager.getScrollX());
+        event(MotionEvent.ACTION_UP, 800);
+        assertEquals(0, mPager.getNextPage());
+        assertEquals(0, mPager.getScrollX());
+    }
+}
