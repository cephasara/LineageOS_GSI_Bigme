+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-FileCopyrightText: The LineageOS Project
+     SPDX-License-Identifier: Apache-2.0 -->
+<resources>
+    <!-- The library's dialog layout explicitly references this string. -->
+    <string name="bottom_sheet_behavior" translatable="false">org.lineageos.aperture.ui.views.EinkBottomSheetBehavior</string>
+    <style name="Widget.Aperture.Eink.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
+        <item name="thumbTint">@color/eink_switch_thumb</item>
+        <item name="thumbIconTint">@color/eink_switch_track</item>
+        <item name="trackTint">@color/eink_switch_track</item>
+        <item name="trackDecorationTint">@android:color/black</item>
+    </style>
+    <!-- Retain the native Material geometry; only paint and motion change. -->
+    <style name="Widget.Aperture.Eink.Button" parent="Widget.Material3.Button">
+        <item name="backgroundTint">@color/eink_control_fill</item>
+        <item name="android:textColor">@color/eink_control_ink</item>
+        <item name="iconTint">@color/eink_control_ink</item>
+        <item name="strokeColor">@android:color/black</item>
+        <item name="strokeWidth">1px</item>
+        <item name="rippleColor">@android:color/transparent</item>
+        <item name="android:stateListAnimator">@null</item>
+        <item name="android:elevation">0dp</item>
+    </style>
+    <style name="Widget.Aperture.Eink.TextButton" parent="Widget.Material3.Button.TextButton">
+        <item name="backgroundTint">@color/eink_control_fill</item>
+        <item name="android:textColor">@color/eink_control_ink</item>
+        <item name="iconTint">@color/eink_control_ink</item>
+        <item name="strokeColor">@android:color/black</item>
+        <item name="strokeWidth">1px</item>
+        <item name="rippleColor">@android:color/transparent</item>
+        <item name="android:stateListAnimator">@null</item>
+        <item name="android:elevation">0dp</item>
+    </style>
+    <style name="ThemeOverlay.Aperture.Eink.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
+        <item name="android:windowAnimationStyle">@null</item>
+        <item name="android:backgroundDimEnabled">false</item>
+        <item name="android:windowElevation">0dp</item>
+        <item name="android:windowLightStatusBar">true</item>
+        <item name="android:windowLightNavigationBar">true</item>
+        <item name="buttonBarPositiveButtonStyle">@style/Widget.Aperture.Eink.TextButton</item>
+        <item name="buttonBarNegativeButtonStyle">@style/Widget.Aperture.Eink.TextButton</item>
+        <item name="buttonBarNeutralButtonStyle">@style/Widget.Aperture.Eink.TextButton</item>
+    </style>
+    <style name="ThemeOverlay.Aperture.Eink.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
+        <item name="android:windowAnimationStyle">@null</item>
+        <item name="android:backgroundDimEnabled">false</item>
+        <item name="android:windowLightStatusBar">true</item>
+        <item name="android:windowLightNavigationBar">true</item>
+        <item name="android:navigationBarColor">@android:color/white</item>
+        <item name="bottomSheetStyle">@style/Widget.Aperture.Eink.BottomSheet</item>
+    </style>
+    <style name="Widget.Aperture.Eink.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
+        <item name="android:elevation">0dp</item>
+        <item name="backgroundTint">@android:color/white</item>
+        <item name="android:background">@drawable/eink_surface</item>
+    </style>
+    <style name="Widget.Aperture.Eink.Snackbar" parent="Widget.Material3.Snackbar">
+        <item name="android:elevation">0dp</item>
+        <item name="backgroundTint">@android:color/white</item>
+        <!-- multiply: a white tint keeps the black edge (SRC_IN would erase it). -->
+        <item name="backgroundTintMode">multiply</item>
+        <item name="android:background">@drawable/eink_surface</item>
+    </style>
+</resources>
