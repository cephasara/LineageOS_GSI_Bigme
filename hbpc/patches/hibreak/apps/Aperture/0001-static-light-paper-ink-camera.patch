diff --git a/app/src/main/java/com/google/android/material/appbar/EinkAppBarLayout.kt b/app/src/main/java/com/google/android/material/appbar/EinkAppBarLayout.kt
new file mode 100644
index 0000000..9269507
--- /dev/null
+++ b/app/src/main/java/com/google/android/material/appbar/EinkAppBarLayout.kt
@@ -0,0 +1,56 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.google.android.material.appbar
+
+import android.animation.ValueAnimator
+import android.content.Context
+import android.util.AttributeSet
+import android.util.Log
+import android.view.ViewTreeObserver
+import androidx.coordinatorlayout.widget.CoordinatorLayout
+
+/** Finish native automatic expand/collapse/snap at its own target, before drawing. */
+class EinkAppBarLayout @JvmOverloads constructor(
+    context: Context, attrs: AttributeSet? = null,
+) : AppBarLayout(context, attrs) {
+    // Material 1.14.0-alpha02 has no public duration control for this animator.
+    private val offsetAnimatorField = runCatching {
+        BaseBehavior::class.java.getDeclaredField("offsetAnimator").apply { isAccessible = true }
+    }.getOrNull()
+    private var compatible = true
+    private val preDraw = ViewTreeObserver.OnPreDrawListener {
+        if (compatible) {
+            try {
+                checkNotNull(offsetAnimatorField)
+                val behavior = (layoutParams as? CoordinatorLayout.LayoutParams)?.behavior
+                if (behavior is BaseBehavior<*>) {
+                    (offsetAnimatorField.get(behavior) as? ValueAnimator)?.let {
+                        if (it.isStarted) it.end()
+                    }
+                }
+            } catch (error: ReflectiveOperationException) {
+                incompatible(error)
+            } catch (error: RuntimeException) {
+                incompatible(error)
+            }
+        }
+        true
+    }
+
+    private fun incompatible(error: Exception) {
+        compatible = false
+        Log.w("EinkAppBar", "Library changed; retaining native snap completion", error)
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        viewTreeObserver.addOnPreDrawListener(preDraw)
+    }
+
+    override fun onDetachedFromWindow() {
+        viewTreeObserver.removeOnPreDrawListener(preDraw)
+        super.onDetachedFromWindow()
+    }
+}
diff --git a/app/src/main/java/com/google/android/material/appbar/EinkCollapsingToolbarLayout.kt b/app/src/main/java/com/google/android/material/appbar/EinkCollapsingToolbarLayout.kt
new file mode 100644
index 0000000..79dd90b
--- /dev/null
+++ b/app/src/main/java/com/google/android/material/appbar/EinkCollapsingToolbarLayout.kt
@@ -0,0 +1,27 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.google.android.material.appbar
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.graphics.Canvas
+import android.util.AttributeSet
+
+/** App-owned subclass, in Material's package to use its package-private text helpers. */
+@SuppressLint("RestrictedApi")
+class EinkCollapsingToolbarLayout @JvmOverloads constructor(
+    context: Context, attrs: AttributeSet? = null,
+) : CollapsingToolbarLayout(context, attrs) {
+    override fun draw(canvas: Canvas) {
+        // Retain the two native title positions and the native fade-mode threshold,
+        // but never present partially transparent/interpolated text between them.
+        for (helper in arrayOf(collapsingTitleHelper, collapsingSubtitleHelper)) {
+            helper.expansionFraction = if (
+                helper.expansionFraction < helper.fadeModeThresholdFraction
+            ) 0f else 1f
+        }
+        super.draw(canvas)
+    }
+}
