diff --git a/app/src/main/res/drawable/eink_feedback.xml b/app/src/main/res/drawable/eink_feedback.xml
new file mode 100644
index 0000000..7701166
--- /dev/null
+++ b/app/src/main/res/drawable/eink_feedback.xml
@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- E-Ink feedback for rows, icons and bar buttons: no frame at rest (no boxed rows or
+     doubled seams); selected is inverted, pressed outlined, focused a dashed ring. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_selected="true"><shape android:shape="rectangle">
+            <solid android:color="@android:color/black" />
+            <corners android:radius="4dp" />
+        </shape></item>
+    <item android:state_pressed="true"><shape android:shape="rectangle">
+            <solid android:color="@android:color/white" />
+            <corners android:radius="4dp" />
+            <stroke android:width="1px" android:color="@android:color/black" />
+        </shape></item>
+    <item android:state_focused="true"><shape android:shape="rectangle">
+            <corners android:radius="4dp" />
+            <stroke android:width="1px" android:color="@android:color/black" android:dashWidth="3dp" android:dashGap="2dp" />
+        </shape></item>
+    <item android:drawable="@android:color/transparent" />
+</selector>
