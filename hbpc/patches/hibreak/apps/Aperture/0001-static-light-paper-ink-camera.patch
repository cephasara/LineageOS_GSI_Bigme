@@ -0,0 +1,24 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.aperture.ui.views
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+
+/** Black overlay lines with an opaque white keyline over unmodified camera content. */
+internal class InkLines {
+    private val paper = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        style = Paint.Style.STROKE
+    }
+
+    fun draw(canvas: Canvas, x1: Float, y1: Float, x2: Float, y2: Float, ink: Paint) {
+        paper.strokeWidth = ink.strokeWidth + 2f
+        paper.pathEffect = ink.pathEffect
+        canvas.drawLine(x1, y1, x2, y2, paper)
+        canvas.drawLine(x1, y1, x2, y2, ink)
+    }
+}
