index 0000000..2946f37
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/ui/views/EinkBottomSheetBehavior.kt
@@ -0,0 +1,97 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.aperture.ui.views
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.graphics.Color
+import android.util.AttributeSet
+import android.util.Log
+import android.view.View
+import android.view.ViewTreeObserver
+import android.widget.OverScroller
+import androidx.coordinatorlayout.widget.CoordinatorLayout
+import androidx.customview.widget.ViewDragHelper
+import com.google.android.material.bottomsheet.BottomSheetBehavior
+import com.google.android.material.shape.MaterialShapeDrawable
+
+/**
+ * Keep Material's release target, nested scrolling, dismissal and state callbacks.
+ * Complete only its already-started settling scroller before presenting a frame.
+ * Do not abort the drag helper: that would cancel pointers and skip child offsets.
+ *
+ * Private-field adapter is pinned to Material 1.14.0-alpha02 / CustomView 1.2.0-alpha03
+ * in this GSI. Keep the fields through R8 and re-review when upgrading either library.
+ */
+class EinkBottomSheetBehavior<V : View> @JvmOverloads constructor(
+    context: Context, attrs: AttributeSet? = null,
+) : BottomSheetBehavior<V>(context, attrs) {
+    private var boundView: V? = null
+    private var compatible = true
+    private val helperField = runCatching {
+        BottomSheetBehavior::class.java.getDeclaredField("viewDragHelper").apply {
+            isAccessible = true
+        }
+    }.getOrNull()
+    private val scrollerField = runCatching {
+        ViewDragHelper::class.java.getDeclaredField("mScroller").apply { isAccessible = true }
+    }.getOrNull()
+
+    private val preDraw = ViewTreeObserver.OnPreDrawListener {
+        if (compatible && state == STATE_SETTLING) {
+            try {
+                checkNotNull(helperField)
+                checkNotNull(scrollerField)
+                val helper = helperField.get(this) as? ViewDragHelper
+                if (helper != null && helper.viewDragState == ViewDragHelper.STATE_SETTLING) {
+                    val scroller = scrollerField.get(helper) as OverScroller
+                    scroller.abortAnimation()
+                    // Native movement/slide callback now; native IDLE and sheet-state
+                    // completion stay deferred in their existing posted runnables.
+                    helper.continueSettling(true)
+                }
+            } catch (error: ReflectiveOperationException) {
+                incompatible(error)
+            } catch (error: RuntimeException) {
+                incompatible(error)
+            }
+        }
+        true
+    }
+
+    private fun incompatible(error: Exception) {
+        compatible = false
+        Log.w("EinkBottomSheet", "Library changed; retaining native sheet completion", error)
+    }
+
+    private val attachment = object : View.OnAttachStateChangeListener {
+        override fun onViewAttachedToWindow(view: View) {
+            view.viewTreeObserver.addOnPreDrawListener(preDraw)
+        }
+        override fun onViewDetachedFromWindow(view: View) {
+            view.viewTreeObserver.removeOnPreDrawListener(preDraw)
+        }
+    }
+
+    @SuppressLint("RestrictedApi")
+    override fun onLayoutChild(parent: CoordinatorLayout, child: V, layoutDirection: Int): Boolean {
+        disableShapeAnimations()
+        val result = super.onLayoutChild(parent, child, layoutDirection)
+        (child.background as? MaterialShapeDrawable)?.apply {
+            setStroke(1f, Color.BLACK)
+            elevation = 0f
+        }
+        if (boundView !== child) {
+            boundView?.let {
+                it.removeOnAttachStateChangeListener(attachment)
+                it.viewTreeObserver.removeOnPreDrawListener(preDraw)
+            }
+            boundView = child
+            child.addOnAttachStateChangeListener(attachment)
+            if (child.isAttachedToWindow) child.viewTreeObserver.addOnPreDrawListener(preDraw)
+        }
+        return result
+    }
+}
