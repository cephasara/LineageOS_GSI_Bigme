diff --git a/java/com/android/incallui/theme/res/drawable/incall_eink_button.xml b/java/com/android/incallui/theme/res/drawable/incall_eink_button.xml
new file mode 100644
index 0000000..40dfaeb
--- /dev/null
+++ b/java/com/android/incallui/theme/res/drawable/incall_eink_button.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Keep all fills white. Checked/focused/pressed = double outline;
+     disabled = dashed outline, without washing out the icon or label. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+  <item android:state_enabled="false" android:state_checked="true"
+      android:drawable="@drawable/incall_eink_button_disabled_checked"/>
+  <item android:state_enabled="false" android:drawable="@drawable/incall_eink_button_disabled"/>
+  <item android:state_checked="true" android:drawable="@drawable/incall_eink_button_checked"/>
+  <item android:state_pressed="true" android:drawable="@drawable/incall_eink_button_checked"/>
+  <item android:state_focused="true" android:drawable="@drawable/incall_eink_button_checked"/>
+  <item android:drawable="@drawable/incall_eink_button_normal"/>
+</selector>
