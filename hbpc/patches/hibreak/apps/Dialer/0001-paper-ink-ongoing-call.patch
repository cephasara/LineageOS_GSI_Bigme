@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- E-Ink: each DTMF key is its own outlined tile; a 2dp inset keeps neighbours from
+     sharing (doubling) an edge. The caller keeps the key's native padding. -->
