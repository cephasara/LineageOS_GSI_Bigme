+++ b/java/com/android/dialer/main/impl/MainEinkStyle.java
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.dialer.main.impl;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.util.TypedValue;
+import android.view.View;
+import com.android.dialer.R;
+
+/** Presentation opt-in for shared views; incoming/voice/video/RTT themes remain separate. */
+public final class MainEinkStyle {
+  private MainEinkStyle() {}
+
+  public static boolean isEnabled(Context context) {
+    TypedValue value = new TypedValue();
+    return context.getTheme().resolveAttribute(R.attr.mainEinkUi, value, true) && value.data != 0;
+  }
+
+  public static int ink(Context context, int original) {
+    return isEnabled(context) ? Color.BLACK : original;
+  }
+
+  /** The key's existing padding/hit geometry belongs to its native layout. */
+  public static void outline(View view) {
+    int left = view.getPaddingLeft(), top = view.getPaddingTop();
+    int right = view.getPaddingRight(), bottom = view.getPaddingBottom();
+    view.setBackgroundResource(R.drawable.main_eink_key);
+    view.setPadding(left, top, right, bottom);
+    view.setElevation(0f);
+    view.setStateListAnimator(null);
+  }
+}
