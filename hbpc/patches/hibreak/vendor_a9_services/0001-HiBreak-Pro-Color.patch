+import android.widget.RadioGroup
+import com.google.android.material.radiobutton.MaterialRadioButton
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.google.android.material.button.MaterialButton
+import com.google.android.material.button.MaterialButtonToggleGroup
+import com.google.android.material.materialswitch.MaterialSwitch
+import com.google.android.material.slider.LabelFormatter
+import com.google.android.material.slider.Slider
+import com.google.android.material.textview.MaterialTextView
+
+/** Material components with static, opaque E-ink states. No hardware policy lives here. */
+internal class EinkSettingsUi(val context: Context, val content: LinearLayout) {
+    val bindings = mutableListOf<() -> Unit>()
+    fun dp(value: Int) = (value * context.resources.displayMetrics.density).toInt()
+    /** Edge width of outlined controls: whole pixels, round(density) (2px at 300dpi). */
+    fun edge() = kotlin.math.max(1, kotlin.math.round(context.resources.displayMetrics.density).toInt())
+    private fun color(id: Int) = context.getColor(id)
+    fun text(value: CharSequence, appearance: Int, secondary: Boolean = false) =
+        MaterialTextView(context).apply {
+            text = value
+            setTextAppearance(appearance)
+            setTextColor(color(if (secondary) R.color.eink_secondary else R.color.eink_ink))
+        }
+
+    fun heading(title: Int) {
+        content.addView(text(context.getString(title),
+            com.google.android.material.R.style.TextAppearance_Material3_TitleLarge).apply {
+            isAccessibilityHeading = true
+            setPadding(0, dp(24), 0, dp(12))
+        })
+    }
+
+    fun note(value: CharSequence): TextView = text(value,
+        com.google.android.material.R.style.TextAppearance_Material3_BodyMedium, true).also {
+        it.setPadding(0, dp(8), 0, dp(12))
+        content.addView(it)
+    }
+
+    fun button(label: CharSequence) = MaterialButton(context).apply {
+        text = label
+        minimumHeight = dp(56)
+        stateListAnimator = null
+        elevation = 0f
+    }
+
+    fun divider() {
+        content.addView(View(context).apply { setBackgroundColor(color(R.color.eink_ink)) },
+            LinearLayout.LayoutParams(-1, dp(1)).apply { topMargin = dp(8); bottomMargin = dp(8) })
+    }
+
+    fun row(title: Int, summary: () -> String, enabled: () -> Boolean = { true }, action: () -> Unit) {
+        val label = text(context.getString(title),
+            com.google.android.material.R.style.TextAppearance_Material3_BodyLarge)
+        val detail = text("", com.google.android.material.R.style.TextAppearance_Material3_BodyMedium, true)
+        val labels = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            addView(label); addView(detail)
+            importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS
+        }
+        val row = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            minimumHeight = dp(72)
+            setPadding(dp(8), dp(12), dp(8), dp(12))
+            setBackgroundResource(R.drawable.eink_row)
+            addView(labels, LinearLayout.LayoutParams(0, -2, 1f))
+            addView(text("›", com.google.android.material.R.style.TextAppearance_Material3_TitleLarge).apply {
+                setPadding(dp(16), 0, 0, 0)
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+            })
+            isFocusable = true
+            setOnClickListener { action() }
+            accessibilityDelegate = object : View.AccessibilityDelegate() {
+                override fun onInitializeAccessibilityNodeInfo(host: View, info: AccessibilityNodeInfo) {
+                    super.onInitializeAccessibilityNodeInfo(host, info)
+                    info.className = "android.widget.Button"
+                }
+            }
+        }
+        content.addView(row)
+        bindings += {
+            detail.text = summary()
+            row.isEnabled = enabled()
+            label.setTextColor(color(if (row.isEnabled) R.color.eink_ink else R.color.eink_disabled))
+            row.contentDescription = "${label.text}. ${detail.text}"
+        }
+    }
+
+    /** Inline choices keep non-focusable accessibility overlays in the same window. */
+    fun inlineChoice(title: Int, labels: List<Int>, read: () -> Int, write: (Int) -> Unit, enabled: () -> Boolean = { true }) {
+        var binding = false
+        var expanded = false
+        val choices = RadioGroup(context).apply {
+            orientation = RadioGroup.VERTICAL
+            visibility = View.GONE
+        }
+        row(title, { if (!enabled()) context.getString(R.string.eink_managed)
+            else labels.getOrNull(read())?.let(context::getString) ?: context.getString(R.string.eink_custom) }, enabled) {
+            expanded = !expanded
+            choices.visibility = if (expanded) View.VISIBLE else View.GONE
+        }
+        for (index in labels.indices) {
+            choices.addView(MaterialRadioButton(context).apply {
+                id = View.generateViewId()
+                text = context.getString(labels[index])
+                setTextAppearance(com.google.android.material.R.style.TextAppearance_Material3_BodyLarge)
+                setTextColor(color(R.color.eink_ink))
+                buttonTintList = ColorStateList.valueOf(color(R.color.eink_ink))
+                minHeight = dp(48)
+                setPadding(dp(8), dp(8), dp(8), dp(8))
+                setBackgroundResource(R.drawable.eink_row)
+                stateListAnimator = null
+                tag = index
+            }, RadioGroup.LayoutParams(-1, -2))
+        }
+        choices.setOnCheckedChangeListener { _, id ->
+            if (!binding && enabled() && id != View.NO_ID) {
+                write(choices.findViewById<MaterialRadioButton>(id).tag as Int)
+                refresh()
+            }
+        }
+        content.addView(choices, LinearLayout.LayoutParams(-1, -2))
+        bindings += {
+            binding = true
+            choices.visibility = if (expanded && enabled()) View.VISIBLE else View.GONE
+            val button = choices.getChildAt(read()) as? MaterialRadioButton
+            if (button == null) choices.clearCheck()
+            else if (choices.checkedRadioButtonId != button.id) choices.check(button.id)
+            for (i in 0 until choices.childCount) choices.getChildAt(i).jumpDrawablesToCurrentState()
+            binding = false
+        }
+    }
+
+    fun dithering(read: () -> DitherMode, write: (DitherMode) -> Unit, enabled: () -> Boolean = { true }) {
+        inlineChoice(R.string.eink_dither, listOf(R.string.eink_dither_default, R.string.eink_dither_text,
+            R.string.eink_dither_picture1, R.string.eink_dither_picture2, R.string.eink_dither_gray),
+            { read().ordinal }, { write(DitherMode.values()[it]) }, enabled)
+    }
+
+    fun scene(prefs: SharedPreferences, app: () -> String) {
+        inlineChoice(R.string.eink_scene, listOf(R.string.eink_daily, R.string.eink_reading,
+            R.string.eink_picture, R.string.eink_video),
+            { DisplayScene.selected(prefs, app())?.ordinal ?: -1 },
+            { DisplayScene.values()[it].apply(prefs, app()) })
+    }
+
+    fun waveform(prefs: SharedPreferences, app: () -> String) {
+        inlineChoice(R.string.refresh_mode, listOf(R.string.balanced, R.string.clear,
+            R.string.smooth, R.string.speed, R.string.eink_hd256, R.string.eink_hyper),
+            { ImageProfile.waveform(prefs, app()).ordinal },
+            { prefs.edit().putInt(ImageProfile.waveformKey(app()), WaveformMode.values()[it].value).apply() })
+    }
+
+    fun imageControls(prefs: SharedPreferences, app: () -> String) {
+        var expanded = false
+        val body = LinearLayout(context).apply { orientation = LinearLayout.VERTICAL; visibility = View.GONE }
+        row(R.string.eink_image, { context.getString(R.string.eink_image_summary) }) {
+            expanded = !expanded; body.visibility = if (expanded) View.VISIBLE else View.GONE
+        }
+        content.addView(body)
+        val ui = EinkSettingsUi(context, body)
+        ui.dithering({ DitherMode.read(prefs, app()) },
+            { prefs.edit().putInt(DitherMode.key(app()), it.value).apply() },
+            { ImageProfile.controlsDither(prefs, app()) })
+        ui.note(context.getString(R.string.eink_dither_help))
+        val contrastBody = LinearLayout(context).apply { orientation = LinearLayout.VERTICAL }
+        body.addView(contrastBody)
+        val contrastUi = EinkSettingsUi(context, contrastBody)
+        contrastUi.slider(R.string.eink_contrast, 100, { ImageProfile.contrast(prefs, app()) },
+            { prefs.edit().putInt(ImageProfile.contrastKey(app()), it).apply() }, defer = true)
+        contrastUi.note(context.getString(R.string.eink_contrast_help))
+        ui.heading(R.string.eink_reading_tools)
+        ui.readingControls(prefs, app)
+        ui.toggle(R.string.eink_grayscale, R.string.eink_grayscale_help,
+            { ImageProfile.gray(prefs, app()) }, { prefs.edit().putBoolean(ImageProfile.grayKey(app()), it).apply() })
+        val colorBody = LinearLayout(context).apply { orientation = LinearLayout.VERTICAL }
+        body.addView(colorBody)
+        val colorUi = EinkSettingsUi(context, colorBody)
+        colorUi.toggle(R.string.eink_color_restore, R.string.eink_color_restore_help,
+            { ImageProfile.color(prefs, app()) }, { prefs.edit().putBoolean(ImageProfile.colorKey(app()), it).apply() })
+        bindings += {
+            contrastBody.visibility = if (ImageProfile.waveform(prefs, app()) == WaveformMode.HYPER) View.GONE else View.VISIBLE
+            colorBody.visibility = if (ImageProfile.usesColor(ImageProfile.waveform(prefs, app()))) View.VISIBLE else View.GONE
+            ui.refresh(); contrastUi.refresh(); colorUi.refresh()
+        }
+    }
+
+    /** Shared experimental controls: zero is off; release applies one profile frame. */
+    fun readingControls(prefs: SharedPreferences, app: () -> String, compact: Boolean = false) {
+        val labelWidth = if (compact) listOf(R.string.eink_text_ink, R.string.eink_paper_white, R.string.eink_dark_ink).maxOf {
+            val label = text(context.getString(it), com.google.android.material.R.style.TextAppearance_Material3_BodySmall)
+            label.paint.measureText(label.text.toString()).toInt() + dp(4)
+        } else 0
+        slider(R.string.eink_text_ink, 100, { ImageProfile.text(prefs, app()) },
+            { prefs.edit().putInt(ImageProfile.textKey(app()), it).apply() }, defer = true, compact = compact, compactLabelWidthPx = labelWidth)
+        slider(R.string.eink_paper_white, 100, { ImageProfile.white(prefs, app()) },
+            { prefs.edit().putInt(ImageProfile.whiteKey(app()), it).apply() }, defer = true, compact = compact, compactLabelWidthPx = labelWidth)
+        slider(R.string.eink_dark_ink, 100, { ImageProfile.dark(prefs, app()) },
+            { prefs.edit().putInt(ImageProfile.darkKey(app()), it).apply() }, defer = true, compact = compact, compactLabelWidthPx = labelWidth)
+        note(context.getString(R.string.eink_reading_tools_help))
+    }
+
+    fun toggle(title: Int, summary: Int, read: () -> Boolean, write: (Boolean) -> Unit) {
+        val control = MaterialSwitch(context).apply {
+            text = context.getString(title)
+            setTextAppearance(com.google.android.material.R.style.TextAppearance_Material3_BodyLarge)
+            setTextColor(color(R.color.eink_ink))
+            switchPadding = dp(16)
+            minHeight = dp(56)
+            setPadding(dp(8), dp(8), dp(8), dp(8))
+            setBackgroundResource(R.drawable.eink_row)
+            thumbTintList = ColorStateList.valueOf(color(R.color.eink_paper))
+            trackTintList = ColorStateList.valueOf(color(R.color.eink_ink))
+            trackDecorationTintList = ColorStateList.valueOf(color(R.color.eink_ink))
+            thumbIconTintList = ColorStateList.valueOf(color(R.color.eink_ink))
+            isChecked = read()
+            setOnCheckedChangeListener { _, value ->
+                jumpDrawablesToCurrentState()
+                write(value)
+            }
+        }
+        content.addView(control, LinearLayout.LayoutParams(-1, -2))
+        note(context.getString(summary))
+        bindings += {
+            val value = read()
+            if (control.isChecked != value) control.isChecked = value
+            control.stateDescription = context.getString(if (value) R.string.eink_on else R.string.eink_off)
+            control.jumpDrawablesToCurrentState()
+        }
+    }
+
+    fun slider(title: Int, max: Int, read: () -> Int, write: (Int) -> Unit, defer: Boolean = false, compact: Boolean = false, compactLabelWidthPx: Int = 0) {
+        val label = text(context.getString(title),
+            com.google.android.material.R.style.TextAppearance_Material3_BodyLarge)
+        label.id = View.generateViewId()
+        val valueText = text("", com.google.android.material.R.style.TextAppearance_Material3_TitleMedium)
+        valueText.setPadding(dp(16), 0, 0, 0)
+        valueText.fontFeatureSettings = "tnum"
+        val header = LinearLayout(context).apply {
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(dp(8), if (compact) 0 else dp(16), dp(8), 0)
+            addView(label, LinearLayout.LayoutParams(0, -2, 1f))
+            addView(valueText)
+        }
+        if (!compact) content.addView(header)
+        var tracking = false
+        val slider = Slider(context).apply {
+            valueFrom = 0f; valueTo = max.toFloat(); stepSize = 1f
+            value = read().toFloat()
+            contentDescription = label.text
+            labelBehavior = LabelFormatter.LABEL_GONE
+            isTickVisible = false
+            trackHeight = dp(4)
+            haloRadius = 0
+            thumbElevation = 0f
+            thumbTintList = ColorStateList.valueOf(color(R.color.eink_ink))
+            trackActiveTintList = ColorStateList.valueOf(color(R.color.eink_ink))
+            trackInactiveTintList = ColorStateList.valueOf(color(R.color.eink_disabled))
+            addOnChangeListener { _, value, fromUser ->
+                valueText.text = context.getString(R.string.eink_level, value.toInt(), max)
+                if (fromUser && (!defer || !tracking)) write(value.toInt())
+            }
+            addOnSliderTouchListener(object : Slider.OnSliderTouchListener {
+                override fun onStartTrackingTouch(slider: Slider) { tracking = true }
+                override fun onStopTrackingTouch(slider: Slider) {
+                    tracking = false
+                    if (defer) write(slider.value.toInt())
+                }
+            })
+        }
+        if (compact) {
+            label.setTextAppearance(com.google.android.material.R.style.TextAppearance_Material3_BodySmall)
+            valueText.setTextAppearance(com.google.android.material.R.style.TextAppearance_Material3_LabelMedium)
+            valueText.setPadding(dp(4), 0, 0, 0)
+            valueText.gravity = Gravity.END
+            slider.thumbRadius = dp(8)
+            header.removeAllViews()
+            val labelWidth = maxOf(compactLabelWidthPx, dp(60), label.paint.measureText(label.text.toString()).toInt() + dp(4))
+            val valueWidth = maxOf(dp(64), valueText.paint.measureText(context.getString(R.string.eink_level, max, max)).toInt() + dp(8))
+            header.addView(label, LinearLayout.LayoutParams(labelWidth, -2))
+            header.addView(slider, LinearLayout.LayoutParams(0, dp(48), 1f))
+            header.addView(valueText, LinearLayout.LayoutParams(valueWidth, -2))
+            content.addView(header, LinearLayout.LayoutParams(-1, dp(48)))
+        } else content.addView(slider, LinearLayout.LayoutParams(-1, dp(48)))
+        label.labelFor = slider.apply { id = View.generateViewId() }.id
+        bindings += {
+            if (!tracking) slider.value = read().coerceIn(0, max).toFloat()
+            valueText.text = context.getString(R.string.eink_level, slider.value.toInt(), max)
+        }
+    }
+
+    /** The activity and shortcut panel share exactly the same geometry and bindings. */
+    fun frontlight(prefs: SharedPreferences) {
+        var applyingScene = false
+        val group = MaterialButtonToggleGroup(context).apply {
+            isSingleSelection = true; isSelectionRequired = true
+            // A LinearLayout aligns text baselines by default. The selected label's check
+            // mark falls back to Noto Sans Symbols (taller ascent than Roboto), which moved
+            // the other button 2px down and clipped its bottom edge. Top-align instead.
+            isBaselineAligned = false
+        }
+        val scenes = listOf("day" to R.string.frontlight_day, "night" to R.string.frontlight_night)
+        // Selection is an inversion (black fill, white text); both buttons keep the same
+        // whole-pixel edge, so the shared edge and every outer edge stay one solid line.
+        val checked = intArrayOf(android.R.attr.state_checked)
+        val ink = color(R.color.eink_ink)
+        val paper = color(R.color.eink_paper)
+        val buttons = scenes.map { (_, label) -> button(context.getString(label)).apply {
+            id = View.generateViewId()
+            isCheckable = true
+            insetTop = 0; insetBottom = 0
+            backgroundTintList = ColorStateList(arrayOf(checked, intArrayOf()), intArrayOf(ink, paper))
+            setTextColor(ColorStateList(arrayOf(checked, intArrayOf()), intArrayOf(paper, ink)))
+            strokeColor = ColorStateList.valueOf(ink)
+            strokeWidth = edge()
+        } }
+        // Both buttons take the group height, so their rectangles and edges always match.
+        buttons.forEach { group.addView(it, LinearLayout.LayoutParams(0, -1, 1f)) }
+        group.addOnButtonCheckedListener { _, id, checked ->
+            if (checked && !applyingScene) FrontlightPreferences.select(prefs, scenes[buttons.indexOfFirst { it.id == id }].first)
+        }
+        content.addView(group, LinearLayout.LayoutParams(-1, -2))
+        bindings += {
+            applyingScene = true
+            val selected = if (FrontlightPreferences.scene(prefs) == "day") 0 else 1
+            group.check(buttons[selected].id)
+            applyingScene = false
+            buttons.forEachIndexed { i, button ->
+                val label = context.getString(scenes[i].second)
+                button.text = if (i == selected) context.getString(R.string.eink_selected_label, label) else label
+                button.stateDescription = context.getString(if (i == selected) R.string.eink_selected_state else R.string.eink_unselected_state)
+            }
+        }
+        fun scene() = FrontlightPreferences.scene(prefs)
+        slider(R.string.frontlight_cold, FrontlightSchedule.MAX,
+            { FrontlightPreferences.cold(prefs, scene()) },
+            { prefs.edit().putInt(FrontlightPreferences.coldKey(scene()), it).apply() })
+        slider(R.string.frontlight_warm, FrontlightSchedule.MAX,
+            { FrontlightPreferences.warm(prefs, scene()) },
+            { prefs.edit().putInt(FrontlightPreferences.warmKey(scene()), it).apply() })
+    }
+
+    fun refresh() = bindings.forEach { it() }
