+        root.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(view: View) { preferences.registerOnSharedPreferenceChangeListener(listener); ui.refresh() }
+            override fun onViewDetachedFromWindow(view: View) { preferences.unregisterOnSharedPreferenceChangeListener(listener) }
+        })
+    }
+
+    private fun showPage(value: Int) { page = value; pageViews.forEachIndexed { i, view -> view.visibility = if (i == page) View.VISIBLE else View.GONE }; ui.refresh() }
+    fun close() { root.visibility = View.GONE }
+    fun updateAppId(value: String) {
+        if (targetAppId != value && page >= 2) showPage(1)
+        targetAppId = value
+        val label = value.ifEmpty { root.context.getString(R.string.app_id_unknown) }
+        appId.text = label; appId.contentDescription = root.context.getString(R.string.target_app_id_description, label)
+    }
+    fun refreshControls() { ui.refresh() }
+    fun updateWaveform(value: WaveformMode) { waveform = value; ui.refresh() }
+}
+
+fun EinkPanel?.close() { this?.close() }
+fun EinkPanel?.updateTarget(manager: RefreshModeManager) = this?.run {
+    updateAppId(manager.currentAppId); updateWaveform(manager.currentWaveform); refreshControls()
+}
