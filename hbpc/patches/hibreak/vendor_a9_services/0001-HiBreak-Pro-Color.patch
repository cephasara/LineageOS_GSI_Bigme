+package net.dianqk.hibreak.eink
+
+import java.time.Instant
+import java.time.LocalTime
+import java.time.ZoneId
+
+/** Local wall-clock schedule, including midnight, DST gaps and repeated hours. */
+object FrontlightSchedule {
+    const val DAY = "day"
+    const val NIGHT = "night"
+    const val MAX = 220
+    const val NIGHT_START = 22 * 60
+    const val DAY_START = 6 * 60
+
+    fun sceneAt(now: Instant, zone: ZoneId, night: Int, day: Int): String {
+        require(night in 0..1439 && day in 0..1439 && night != day)
+        val local = now.atZone(zone)
+        val minute = local.hour * 60 + local.minute
+        val isNight = if (night > day) minute >= night || minute < day
+            else minute >= night && minute < day
+        return if (isNight) NIGHT else DAY
+    }
+
+    fun nextSwitch(now: Instant, zone: ZoneId, night: Int, day: Int): Instant {
+        sceneAt(now, zone, night, day) // Validate even when there is no candidate yet.
+        val candidates = mutableListOf<Instant>()
+        val date = now.atZone(zone).toLocalDate()
+        for (offset in -1L..3L) for (minute in listOf(night, day)) {
+            val local = date.plusDays(offset).atTime(LocalTime.of(minute / 60, minute % 60))
+            val offsets = zone.rules.getValidOffsets(local)
+            if (offsets.isEmpty()) candidates += zone.rules.getTransition(local).instant
+            else offsets.forEach { candidates += local.toInstant(it) }
+        }
+        // A backward clock jump can cross a boundary for a second time.
+        zone.rules.nextTransition(now)?.let { candidates += it.instant }
+        return candidates.filter { it > now &&
+            sceneAt(it.minusMillis(1), zone, night, day) != sceneAt(it, zone, night, day)
+        }.minOrNull() ?: error("No frontlight boundary found")
+    }
+}
