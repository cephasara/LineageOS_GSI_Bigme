@@ -0,0 +1,19 @@
+package net.dianqk.hibreak.eink
+
+import kotlin.math.abs
+
+/** Accessibility deltas approximate velocity; unknown deltas use a short grace period. */
+object ScrollSettling {
+    fun delay(delta: Int, elapsed: Long): Long {
+        if (delta == 0 || elapsed !in 1..1000) return 500
+        val velocity = abs(delta.toLong()) * 1000 / elapsed
+        return when {
+            velocity < 500 -> 400
+            velocity < 1000 -> 600
+            velocity < 2000 -> 800
+            velocity < 3500 -> 1200
+            velocity < 5000 -> 1500
+            else -> 2000
+        }
+    }
+}
