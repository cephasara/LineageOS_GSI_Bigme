+    <string name="eink_target_help">Open the E-Ink menu over an application, then tap Settings to configure its display profile.</string>
+    <string name="eink_waveform_help">Changes apply only to the app shown above. New apps use Normal.</string>
+    <string name="eink_scroll">Scroll optimization</string>
+    <string name="eink_scroll_help">Optimize refresh while this app scrolls. Off by default.</string>
