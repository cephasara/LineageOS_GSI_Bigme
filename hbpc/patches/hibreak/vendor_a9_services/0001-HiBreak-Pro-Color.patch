@@ -0,0 +1,83 @@
+package net.dianqk.hibreak.eink
+
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import net.dianqk.hibreak.eink.command_runners.CommandRunner
+
+enum class WaveformMode(val value: Int) {
+    NORMAL(178),
+    REGAL(180),
+    HD(177),
+    FAST(179),
+    HD256(Int.MIN_VALUE + 177),
+    HYPER(183);
+
+    companion object {
+        fun fromValue(value: Int) = values().firstOrNull { it.value == value } ?: NORMAL
+    }
+}
+
+enum class DitherMode(val value: Int) {
+    DEFAULT(0), TEXT(1), PICTURE_1(2), PICTURE_2(3), GRAYSCALE(4);
+
+    companion object {
+        fun fromValue(value: Int) = values().firstOrNull { it.value == value } ?: DEFAULT
+        fun key(appId: String) = "dither:package:$appId"
+        fun read(prefs: SharedPreferences, appId: String) = fromValue(prefs.getInt(key(appId), 0))
+    }
+}
+
+class RefreshModeManager(
+    private val sharedPreferences: SharedPreferences,
+    private val commandRunner: CommandRunner,
+    private val handler: Handler = Handler(Looper.getMainLooper()),
+) {
+    // A scene writes about twelve preferences in one apply(); send one profile for them.
+    private val applyPending = Runnable { applyMode() }
+
+    var currentWaveform: WaveformMode = WaveformMode.NORMAL
+        private set
+
+    var currentAppId: String = ""
+        private set
+
+    fun onAppChange(packageName: String) {
+        if (packageName == currentAppId) return
+        currentAppId = packageName
+        currentWaveform = ImageProfile.waveform(sharedPreferences, packageName)
+        // Even apps with the same waveform may have different dither profiles.
+        applyMode()
+    }
+
+    fun changeWaveform(waveform: WaveformMode) {
+        if (currentAppId.isNotEmpty()) {
+            sharedPreferences.edit()
+                .putInt(ImageProfile.waveformKey(currentAppId), waveform.value)
+                .apply()
+        }
+        currentWaveform = waveform
+        applyMode()
+    }
+
+    fun onPreferenceChanged(key: String) {
+        if (currentAppId.isNotEmpty() && ImageProfile.belongsTo(currentAppId, key)) {
+            currentWaveform = ImageProfile.waveform(sharedPreferences, currentAppId)
+            handler.removeCallbacks(applyPending)
+            handler.post(applyPending)
+        }
+    }
+
+    fun applyMode() {
+        handler.removeCallbacks(applyPending)
+        // Submit the complete app profile as one composition-thread request.
+        val contrast = ImageProfile.contrast(sharedPreferences, currentAppId)
+        val gray = ImageProfile.gray(sharedPreferences, currentAppId)
+        val color = ImageProfile.color(sharedPreferences, currentAppId)
+        val text = ImageProfile.text(sharedPreferences, currentAppId)
+        val white = ImageProfile.white(sharedPreferences, currentAppId)
+        val dark = ImageProfile.dark(sharedPreferences, currentAppId)
+        val dither = DitherMode.read(sharedPreferences, currentAppId)
+        commandRunner.runCommands(arrayOf("profile ${currentWaveform.value} ${dither.value} $contrast ${if (gray) 1 else 0} ${if (color) 1 else 0} $text $white $dark"))
+    }
+}
