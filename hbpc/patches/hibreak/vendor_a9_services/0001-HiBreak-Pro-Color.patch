+    <string name="eink_sleep_lock_screen">Lock screen</string>
+    <string name="eink_sleep_wallpaper">Wallpaper</string>
+    <string name="eink_sleep_white">White</string>
+    <string name="eink_sleep_screen_help">Keep the lock screen, its static wallpaper, or a white page while asleep. Unavailable or live wallpapers use white. Sleep uses a Regal refresh; waking restores the app profile. Lock timing stays unchanged.</string>
+    <string name="eink_service">E-Ink accessibility service</string>
+    <string name="eink_service_on">Enabled · Open accessibility settings</string>
+    <string name="eink_service_off">Not enabled · Open accessibility settings</string>
