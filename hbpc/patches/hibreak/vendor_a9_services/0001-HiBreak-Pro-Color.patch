+    <string name="eink_app_display">App display</string>
+    <string name="eink_buttons">Action buttons</string>
+    <string name="eink_buttons_summary">Top and bottom button actions</string>
+    <string name="eink_buttons_help">Choose the button to configure. Each button has separate actions while the screen is awake or asleep.</string>
+    <string name="eink_button_summary">Single press, double press and hold</string>
+    <string name="eink_top_button">Top button</string>
+    <string name="eink_bottom_button">Bottom button</string>
