+package net.dianqk.hibreak.eink
+
+import android.content.res.ColorStateList
+import android.view.View
+import android.widget.HorizontalScrollView
+import android.widget.LinearLayout
+import com.google.android.material.button.MaterialButton
+import com.google.android.material.button.MaterialButtonToggleGroup
+
+/** One row of Material segmented choices; large text can scroll horizontally. */
+internal class EinkPanelChoices(
+    private val ui: EinkSettingsUi,
+    width: Int,
+    labels: List<Int>,
+    private val read: () -> Int,
+    write: (Int) -> Unit,
+    private val visible: (Int) -> Boolean = { true },
+) {
+    private var binding = false
+    private val group = MaterialButtonToggleGroup(ui.context).apply {
+        isSingleSelection = true
+        isSelectionRequired = true
+        // Top-align: baseline alignment would shift a button whose label uses a fallback font.
+        isBaselineAligned = false
+    }
+    private val buttons = labels.map { label ->
+        ui.button(ui.context.getString(label)).apply {
+            id = View.generateViewId()
+            setTextAppearance(com.google.android.material.R.style.TextAppearance_Material3_LabelMedium)
+            minimumHeight = ui.dp(48); minimumWidth = ui.dp(48)
+            insetTop = ui.dp(4); insetBottom = ui.dp(4)
+            setPadding(ui.dp(6), 0, ui.dp(6), 0)
+            maxLines = 1
+            isCheckable = true
+            val checked = intArrayOf(android.R.attr.state_checked)
+            val ink = context.getColor(R.color.eink_ink)
+            val paper = context.getColor(R.color.eink_paper)
+            backgroundTintList = ColorStateList(arrayOf(checked, intArrayOf()), intArrayOf(ink, paper))
+            setTextColor(ColorStateList(arrayOf(checked, intArrayOf()), intArrayOf(paper, ink)))
+            strokeColor = ColorStateList.valueOf(ink)
+            strokeWidth = ui.edge()
+            cornerRadius = ui.dp(8)
+        }
+    }
+    val view = HorizontalScrollView(ui.context).apply {
+        isHorizontalScrollBarEnabled = false
+        isSmoothScrollingEnabled = false
+        overScrollMode = View.OVER_SCROLL_NEVER
+        addView(group)
+    }
+
+    init {
+        buttons.forEach { group.addView(it) }
+        group.addOnButtonCheckedListener { _, id, checked ->
+            if (checked && !binding) write(buttons.indexOfFirst { it.id == id })
+        }
+        ui.bindings += {
+            binding = true
+            val selected = read()
+            val widths = buttons.mapIndexed { index, button ->
+                if (visible(index)) maxOf(ui.dp(48), button.paint.measureText(button.text.toString()).toInt() + ui.dp(16)) else 0
+            }
+            val total = widths.sum()
+            val count = widths.count { it > 0 }.coerceAtLeast(1)
+            group.layoutParams = group.layoutParams.apply { this.width = maxOf(width, total); height = ui.dp(48) }
+            buttons.forEachIndexed { index, button ->
+                button.visibility = if (visible(index)) View.VISIBLE else View.GONE
+                button.layoutParams = LinearLayout.LayoutParams(widths[index] + (width - total).coerceAtLeast(0) / count, ui.dp(48))
+                button.stateDescription = ui.context.getString(if (index == selected) R.string.eink_selected_state else R.string.eink_unselected_state)
+            }
+            val id = buttons.getOrNull(selected)?.id ?: View.NO_ID
+            if (group.checkedButtonId != id) {
+                group.check(id)
+                buttons.getOrNull(selected)?.let { button -> view.post {
+                    if (view.isShown) view.scrollTo(when {
+                        button.right > view.scrollX + view.width -> button.right - view.width
+                        button.left < view.scrollX -> button.left
+                        else -> view.scrollX
+                    }, 0)
+                } }
+            }
+            buttons.forEach { it.jumpDrawablesToCurrentState() }
+            binding = false
+        }
+    }
+}
