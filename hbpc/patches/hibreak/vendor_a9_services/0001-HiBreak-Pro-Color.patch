+    private fun back() {
+        when (page) {
+            Page.HOME -> finish()
+            Page.TOP, Page.BOTTOM -> navigate(Page.BUTTONS)
+            else -> { navigate(Page.HOME); scroll.post { scroll.scrollTo(0, homeScroll) } }
+        }
+    }
