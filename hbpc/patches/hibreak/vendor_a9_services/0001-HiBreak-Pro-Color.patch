+package net.dianqk.hibreak.eink
+
+import android.app.AlarmManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import android.os.PowerManager
+import java.time.Instant
+import java.time.ZoneId
+
+/** Persistent scene selection, local-time scheduling and screen-aware hardware restoration. */
+class BrightnessManager(
+    private val context: Context,
+    private val preferences: SharedPreferences,
+) : SharedPreferences.OnSharedPreferenceChangeListener {
+    private val writer = FrontlightWriter()
+    private val alarm = context.getSystemService(AlarmManager::class.java)
+    private val handler = Handler(Looper.getMainLooper())
+    private val boundary = AlarmManager.OnAlarmListener { refresh(reschedule = true) }
+    private var started = false
+    private var refreshing = false
+    private val receiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent) {
+            if (intent.action == Intent.ACTION_TIME_CHANGED || intent.action == Intent.ACTION_TIMEZONE_CHANGED) {
+                preferences.edit().remove(FrontlightPreferences.OVERRIDE_UNTIL).apply()
+            }
+            refresh(reschedule = true)
+        }
+    }
+    val coldBrightness get() = FrontlightPreferences.cold(preferences, FrontlightPreferences.scene(preferences))
+    val warmBrightness get() = FrontlightPreferences.warm(preferences, FrontlightPreferences.scene(preferences))
+
+    fun start() {
+        if (started) return
+        FrontlightPreferences.initialize(context, preferences)
+        started = true
+        preferences.registerOnSharedPreferenceChangeListener(this)
+        context.registerReceiver(receiver, IntentFilter().apply {
+            addAction(Intent.ACTION_TIME_CHANGED)
+            addAction(Intent.ACTION_TIMEZONE_CHANGED)
+            addAction(Intent.ACTION_BOOT_COMPLETED)
+        })
+        refresh(reschedule = true)
+    }
+
+    /** Lamp levels on every call; the boundary alarm only when the scene or schedule can have changed. */
+    private fun refresh(reschedule: Boolean = false) {
+        if (!started || refreshing) return
+        refreshing = true
+        try {
+            val scene = FrontlightPreferences.resolve(preferences)
+            val sceneChanged = scene != FrontlightPreferences.scene(preferences)
+            if (sceneChanged) {
+                preferences.edit().putString(FrontlightPreferences.SCENE, scene).apply()
+            }
+            val awake = context.getSystemService(PowerManager::class.java).isInteractive
+            writer.request(if (awake) coldBrightness else 0, if (awake) warmBrightness else 0)
+            if (!reschedule && !sceneChanged) return
+            alarm.cancel(boundary)
+            if (preferences.getBoolean(FrontlightPreferences.AUTO, true)) {
+                val next = FrontlightSchedule.nextSwitch(Instant.now(), ZoneId.systemDefault(),
+                    FrontlightPreferences.nightStart(preferences), FrontlightPreferences.dayStart(preferences))
+                // No wakeup just to change a lamp on a sleeping phone. SCREEN_ON
+                // resolves the current local scene before illuminating it.
+                alarm.setExact(AlarmManager.RTC, next.toEpochMilli(), "HiBreak frontlight scene", boundary, handler)
+            }
+        } finally { refreshing = false }
+    }
+
+    override fun onSharedPreferenceChanged(p: SharedPreferences, key: String?) {
+        if (key?.startsWith("frontlight_") != true || refreshing) return
+        val schedule = key in listOf(FrontlightPreferences.AUTO, FrontlightPreferences.NIGHT_START, FrontlightPreferences.DAY_START)
+        if (schedule) {
+            preferences.edit().remove(FrontlightPreferences.OVERRIDE_UNTIL).apply()
+        }
+        // Level sliders only change the lamps; scene and schedule keys move the boundary.
+        refresh(reschedule = schedule || key == FrontlightPreferences.SCENE || key == FrontlightPreferences.OVERRIDE_UNTIL)
+    }
+    fun applyBrightness() = refresh()
+    fun turnOffBrightness() = writer.request(0, 0)
+
+    fun destroy() {
+        if (started) {
+            alarm.cancel(boundary)
+            preferences.unregisterOnSharedPreferenceChangeListener(this)
+            context.unregisterReceiver(receiver)
+        }
+        started = false
+        writer.close()
+    }
+}
