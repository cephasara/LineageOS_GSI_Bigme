+package net.dianqk.hibreak.eink
+
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import net.dianqk.hibreak.eink.command_runners.CommandRunner
+
+object DisplayProfilePreferences {
+    const val LAST_TARGET_APP = "display_profile:last_target_app"
+
+    private const val AUTO_CLEAN_PREFIX = "auto_clean:package:"
+    private const val ANTI_FLICKER_PREFIX = "anti_flicker:package:"
+    private const val CLEAN_FREQUENCY_PREFIX = "clean_frequency:package:"
+    private const val SCROLL_OPTIMIZATION_PREFIX = "scroll_optimization:package:"
+
+    fun autoCleanKey(appId: String) = "$AUTO_CLEAN_PREFIX$appId"
+    fun antiFlickerKey(appId: String) = "$ANTI_FLICKER_PREFIX$appId"
+    fun cleanFrequencyKey(appId: String) = "$CLEAN_FREQUENCY_PREFIX$appId"
+    fun scrollOptimizationKey(appId: String) = "$SCROLL_OPTIMIZATION_PREFIX$appId"
+
+    fun autoClean(preferences: SharedPreferences, appId: String) =
+        preferences.getBoolean(autoCleanKey(appId), true)
+
+    fun antiFlicker(preferences: SharedPreferences, appId: String) =
+        preferences.getBoolean(antiFlickerKey(appId), true)
+
+    fun cleanFrequency(preferences: SharedPreferences, appId: String) =
+        preferences.getInt(cleanFrequencyKey(appId), 0).coerceIn(0, 50)
+
+    fun scrollOptimization(preferences: SharedPreferences, appId: String) =
+        preferences.getBoolean(scrollOptimizationKey(appId), false)
+
+    fun belongsTo(appId: String, key: String) = key == autoCleanKey(appId) ||
+        key == antiFlickerKey(appId) || key == cleanFrequencyKey(appId) ||
+        key == scrollOptimizationKey(appId)
+}
+
+/** Applies the complete XRZ display profile for the foreground application. */
+class DisplaySettingsManager(
+    private val sharedPreferences: SharedPreferences,
+    private val commandRunner: CommandRunner,
+    private val handler: Handler = Handler(Looper.getMainLooper()),
+) {
+    private var lastScrollTime = 0L
+
+    var currentAppId: String = ""
+        private set
+
+    private var isScrolling = false
+    private val finishScrolling = Runnable { setScrolling(false) }
+    // A scene writes several display preferences in one apply(); send one batch for them.
+    private val applyPending = Runnable { applySettings() }
+
+    fun onAppChange(packageName: String) {
+        if (packageName == currentAppId) return
+        stopScrolling()
+        currentAppId = packageName
+        sharedPreferences.edit()
+            .putString(DisplayProfilePreferences.LAST_TARGET_APP, packageName)
+            .apply()
+        applySettings()
+    }
+
+    fun onViewScrolled(packageName: String, delta: Int = 0, time: Long = 0) {
+        if (packageName != currentAppId ||
+            !DisplayProfilePreferences.scrollOptimization(sharedPreferences, currentAppId)
+        ) return
+
+        setScrolling(true)
+        handler.removeCallbacks(finishScrolling)
+        handler.postDelayed(finishScrolling, ScrollSettling.delay(delta, time - lastScrollTime))
+        lastScrollTime = time
+    }
+
+    fun onPreferenceChanged(key: String) {
+        if (currentAppId.isEmpty() || !DisplayProfilePreferences.belongsTo(currentAppId, key)) return
+        if (key == DisplayProfilePreferences.scrollOptimizationKey(currentAppId) &&
+            !DisplayProfilePreferences.scrollOptimization(sharedPreferences, currentAppId)
+        ) {
+            stopScrolling()
+        }
+        handler.removeCallbacks(applyPending)
+        handler.post(applyPending)
+    }
+
+    /** Replays every property so values from the previous foreground app cannot leak. */
+    fun applySettings() {
+        handler.removeCallbacks(applyPending)
+        if (currentAppId.isEmpty()) return
+        commandRunner.runCommands(
+            arrayOf(
+                if (DisplayProfilePreferences.autoClean(sharedPreferences, currentAppId)) "au_br1" else "au_br0",
+                if (DisplayProfilePreferences.antiFlicker(sharedPreferences, currentAppId)) "an_fl1" else "an_fl0",
+                "clean${DisplayProfilePreferences.cleanFrequency(sharedPreferences, currentAppId)}",
+            )
+        )
+    }
+
+    fun destroy() {
+        handler.removeCallbacks(applyPending)
+        stopScrolling()
+    }
+
+    private fun stopScrolling() {
+        handler.removeCallbacks(finishScrolling)
+        lastScrollTime = 0
+        setScrolling(false)
+    }
+
+    private fun setScrolling(value: Boolean) {
+        if (value == isScrolling) return
+        isScrolling = value
+        commandRunner.runCommands(arrayOf(if (value) "scroll1" else "scroll0"))
+    }
+}
