+package net.dianqk.hibreak.eink.button_mapper
+
+import android.content.Context
+import androidx.preference.PreferenceManager
+import net.dianqk.hibreak.eink.command_runners.CommandRunner
+import net.dianqk.hibreak.eink.RefreshModeManager
+
+class ButtonActionManager(commandRunner: CommandRunner, refreshModeManager: RefreshModeManager) {
+    private val buttonCommands = mapOf(
+        "clear" to ClearScreenButtonAction(commandRunner, refreshModeManager),
+        "next_track" to NextTrackButtonAction(),
+        "toggle_music" to TogglePauseButtonAction(),
+        "back" to BackButtonAction(),
+        "home" to HomeButtonAction(),
+        "recents" to RecentsButtonAction(),
+        "open_menu" to ToggleMenuButtonAction(),
+        "toggle_night_light" to ToggleNightLightAction(),
+        "toggle_backlight" to ToggleBacklightAction(),
+        "previous_track" to PreviousTrackButtonAction(),
+    ).withDefault { DummyButtonAction() }
+
+    private fun run(context: Context, top: Boolean, press: String, screenOff: Boolean) {
+        val preferences = PreferenceManager.getDefaultSharedPreferences(context)
+        val action = preferences.getString(key(top, press, screenOff), default(press, screenOff))
+        buttonCommands[action]?.execute(context)
+    }
+
+    fun executeSinglePress(context: Context) = run(context, false, SINGLE, false)
+    fun executeDoublePress(context: Context) = run(context, false, DOUBLE, false)
+    fun executeLongPress(context: Context) = run(context, false, LONG, false)
+    fun executeSinglePressScreenOff(context: Context) = run(context, false, SINGLE, true)
+    fun executeDoublePressScreenOff(context: Context) = run(context, false, DOUBLE, true)
+    fun executeLongPressScreenOff(context: Context) = run(context, false, LONG, true)
+    fun executeSinglePressTop(context: Context) = run(context, true, SINGLE, false)
+    fun executeDoublePressTop(context: Context) = run(context, true, DOUBLE, false)
+    fun executeLongPressTop(context: Context) = run(context, true, LONG, false)
+    fun executeSinglePressScreenOffTop(context: Context) = run(context, true, SINGLE, true)
+    fun executeDoublePressScreenOffTop(context: Context) = run(context, true, DOUBLE, true)
+    fun executeLongPressScreenOffTop(context: Context) = run(context, true, LONG, true)
+
+    /** Preference keys and defaults of the twelve button mappings; the settings UI uses the same table. */
+    companion object {
+        const val SINGLE = "single"
+        const val DOUBLE = "double"
+        const val LONG = "long"
+        const val NOTHING = "dummy"
+
+        fun key(top: Boolean, press: String, screenOff: Boolean) =
+            "${if (top) "top_" else ""}${press}_press_eink_action${if (screenOff) "_screen_off" else ""}"
+
+        /** Screen on: single press clears, double press opens the menu. Everything else does nothing. */
+        fun default(press: String, screenOff: Boolean) = when {
+            screenOff -> NOTHING
+            press == SINGLE -> "clear"
+            press == DOUBLE -> "open_menu"
+            else -> NOTHING
+        }
+    }
+}
