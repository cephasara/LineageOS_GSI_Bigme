+            Page.HOME -> R.string.eink_settings
+            Page.SCHEDULE -> R.string.eink_schedule
+            Page.DISPLAY -> R.string.eink_app_display
+            Page.BUTTONS -> R.string.eink_buttons
+            Page.TOP -> R.string.eink_top_button
+            Page.BOTTOM -> R.string.eink_bottom_button
+            Page.ADVANCED -> R.string.eink_advanced
+        }
+        toolbar.title = getString(title)
+        when (page) {
+            Page.HOME -> home()
+            Page.SCHEDULE -> schedule()
+            Page.DISPLAY -> display()
+            Page.BUTTONS -> {
+                ui.note(getString(R.string.eink_buttons_help))
+                ui.row(R.string.eink_top_button, { getString(R.string.eink_button_summary) }) { navigate(Page.TOP) }
+                ui.divider()
+                ui.row(R.string.eink_bottom_button, { getString(R.string.eink_button_summary) }) { navigate(Page.BOTTOM) }
+            }
+            Page.TOP, Page.BOTTOM -> buttonMappings(page == Page.TOP)
+            Page.ADVANCED -> advanced()
+        }
+        refresh()
+    }
+
+    private fun home() {
+        ui.heading(R.string.frontlight_title)
+        ui.note(getString(R.string.eink_light_help))
+        ui.frontlight(prefs)
+        ui.divider()
+        ui.row(R.string.eink_schedule, {
+            if (prefs.getBoolean(FrontlightPreferences.AUTO, true)) getString(R.string.eink_schedule_summary,
+                time(FrontlightPreferences.nightStart(prefs)), time(FrontlightPreferences.dayStart(prefs)))
+            else getString(R.string.eink_schedule_manual)
+        }) { navigate(Page.SCHEDULE) }
+        ui.heading(R.string.eink_device)
+        ui.row(R.string.eink_app_display, { appLabel() }) { navigate(Page.DISPLAY) }
+        ui.row(R.string.eink_buttons, { getString(R.string.eink_buttons_summary) }) { navigate(Page.BUTTONS) }
+        ui.row(R.string.eink_advanced, { getString(R.string.eink_advanced_summary) }) { navigate(Page.ADVANCED) }
+    }
+
+    private fun schedule() {
+        ui.toggle(R.string.frontlight_auto, R.string.frontlight_auto_summary,
+            { prefs.getBoolean(FrontlightPreferences.AUTO, true) },
+            { if (!updating) prefs.edit().putBoolean(FrontlightPreferences.AUTO, it).apply() })
+        ui.divider()
+        for ((title, key) in listOf(R.string.frontlight_night_start to FrontlightPreferences.NIGHT_START,
+                R.string.frontlight_day_start to FrontlightPreferences.DAY_START)) {
+            ui.row(title, { time(minutes(key)) }, { prefs.getBoolean(FrontlightPreferences.AUTO, true) }) { pickTime(key, title) }
+        }
+    }
+    private fun minutes(key: String) = if (key == FrontlightPreferences.NIGHT_START)
+        FrontlightPreferences.nightStart(prefs) else FrontlightPreferences.dayStart(prefs)
+    private fun time(minutes: Int): String = DateFormat.getTimeFormat(this).format(Calendar.getInstance().apply {
+        set(Calendar.HOUR_OF_DAY, minutes / 60); set(Calendar.MINUTE, minutes % 60)
+    }.time)
+    private fun pickTime(key: String, title: Int) {
+        if (supportFragmentManager.findFragmentByTag(key) != null) return
+        MaterialTimePicker.Builder().setTitleText(title)
+            .setInputMode(MaterialTimePicker.INPUT_MODE_KEYBOARD)
+            .setTimeFormat(if (DateFormat.is24HourFormat(this)) TimeFormat.CLOCK_24H else TimeFormat.CLOCK_12H)
+            .setHour(minutes(key) / 60).setMinute(minutes(key) % 60).build().also {
+                bindTime(it, key); it.show(supportFragmentManager, key)
+            }
+    }
+    private fun bindTime(picker: MaterialTimePicker, key: String) {
+        picker.clearOnPositiveButtonClickListeners()
+        picker.addOnPositiveButtonClickListener {
+            val value = picker.hour * 60 + picker.minute
+            val other = if (key == FrontlightPreferences.NIGHT_START) FrontlightPreferences.DAY_START else FrontlightPreferences.NIGHT_START
+            if (value == minutes(other)) MaterialAlertDialogBuilder(this)
+                .setMessage(R.string.frontlight_distinct_times).setPositiveButton(android.R.string.ok, null).show()
+            else prefs.edit().putInt(key, value).apply()
+        }
+    }
+
+    private fun appLabel(): String = if (targetApp.isEmpty()) getString(R.string.app_id_unknown) else try {
+        packageManager.getApplicationLabel(packageManager.getApplicationInfo(targetApp, 0)).toString()
+    } catch (_: android.content.pm.PackageManager.NameNotFoundException) { targetApp }
+
+    private fun display() {
+        ui.heading(R.string.eink_target_app)
+        ui.note(if (targetApp.isEmpty()) getString(R.string.eink_target_help) else "${appLabel()}\n$targetApp")
+        if (targetApp.isEmpty()) return
+        ui.note(getString(R.string.eink_waveform_help))
+        ui.scene(prefs, { targetApp })
+        ui.waveform(prefs, { targetApp })
+        ui.imageControls(prefs, { targetApp })
+        ui.divider()
+        fun toggle(title: Int, description: Int, key: String, default: Boolean) = ui.toggle(title, description,
+            { prefs.getBoolean(key, default) }, { if (!updating) prefs.edit().putBoolean(key, it).apply() })
+        toggle(R.string.eink_scroll, R.string.eink_scroll_help, DisplayProfilePreferences.scrollOptimizationKey(targetApp), false)
+        toggle(R.string.eink_auto_clean, R.string.eink_auto_clean_help, DisplayProfilePreferences.autoCleanKey(targetApp), true)
+        toggle(R.string.eink_anti_flicker, R.string.eink_anti_flicker_help, DisplayProfilePreferences.antiFlickerKey(targetApp), true)
+        ui.slider(R.string.eink_clean_frequency, 50,
+            { DisplayProfilePreferences.cleanFrequency(prefs, targetApp) },
+            { prefs.edit().putInt(DisplayProfilePreferences.cleanFrequencyKey(targetApp), it).apply() }, defer = true)
+        ui.note(getString(R.string.eink_clean_frequency_help))
+    }
+
+    private fun buttonMappings(top: Boolean) {
+        for (off in listOf(false, true)) {
+            ui.heading(if (off) R.string.eink_screen_off else R.string.eink_screen_on)
+            val labels = resources.getStringArray(if (off) R.array.button_action_entries_screen_off else R.array.button_action_entries)
+            val values = resources.getStringArray(if (off) R.array.button_action_values_screen_off else R.array.button_action_values)
+            for ((press, title) in listOf(ButtonActionManager.SINGLE to R.string.eink_single_press,
+                    ButtonActionManager.DOUBLE to R.string.eink_double_press, ButtonActionManager.LONG to R.string.eink_long_press)) {
+                val key = ButtonActionManager.key(top, press, off)
+                val default = ButtonActionManager.default(press, off)
+                fun selected() = values.indexOf(prefs.getString(key, default)).takeIf { it >= 0 }
+                    ?: values.indexOf(ButtonActionManager.NOTHING)
+                ui.row(title, { labels[selected()] }) {
+                    MaterialAlertDialogBuilder(this).setTitle(title)
+                        .setSingleChoiceItems(labels, selected()) { dialog, which ->
+                            prefs.edit().putString(key, values[which]).apply(); dialog.dismiss()
+                        }.setNegativeButton(android.R.string.cancel, null).show()
+                }
+            }
+        }
+    }
+
+    private fun advanced() {
+        ui.row(R.string.eink_service, {
+            val manager = getSystemService(AccessibilityManager::class.java)
+            val enabled = manager.getEnabledAccessibilityServiceList(AccessibilityServiceInfo.FEEDBACK_ALL_MASK)
+                .any { it.resolveInfo.serviceInfo.packageName == packageName }
+            getString(if (enabled) R.string.eink_service_on else R.string.eink_service_off)
+        }) { startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)) }
+    }
+
+    companion object { const val EXTRA_TARGET_APP_ID = "target_app_id" }
+}
