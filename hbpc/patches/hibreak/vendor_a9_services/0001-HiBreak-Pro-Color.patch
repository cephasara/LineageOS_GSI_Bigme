+package net.dianqk.hibreak.eink.command_runners
+
+import android.net.LocalSocket
+import android.net.LocalSocketAddress
+import android.util.Log
+import android.content.Context
+import android.os.Handler
+import android.os.HandlerThread
+import android.os.Parcel
+import android.os.ServiceManager
+import android.os.SystemProperties
+import android.provider.Settings
+
+/**
+ * Release the daemon connection after each batch so frontlight ACKs cannot starve.
+ * Batches run in order on a worker thread: socket waits (1 s timeout), SurfaceFlinger
+ * transactions and settings writes must never block the main thread, where a stall would
+ * miss the accessibility key-filter deadline and leak F1/F2 to the foreground app.
+ */
+class UnixSocketCommandRunner(private val context: Context) : CommandRunner {
+    private val thread = HandlerThread("HiBreakEinkCommands").apply { start() }
+    private val worker = Handler(thread.looper)
+    private val ratePrefs = context.getSharedPreferences("eink_rate_guard", Context.MODE_PRIVATE)
+
+    private fun applyRate(hyper: Boolean) {
+        val resolver = context.contentResolver
+        val key = "min_refresh_rate"
+        if (hyper) {
+            // Hyper runs at the composer's full vsync rate, like the stock display policy.
+            val rate = SystemProperties.getInt("persist.vendor.xrz.fps", 120).toFloat()
+            val active = ratePrefs.getBoolean("active", false)
+            if (!active || ratePrefs.getFloat("rate", 90f) != rate) {
+                val edit = ratePrefs.edit().putFloat("rate", rate)
+                if (!active) edit.putString("previous", Settings.System.getString(resolver, key))
+                    .putBoolean("active", true)
+                edit.commit()
+            }
+            Settings.System.putFloat(resolver, key, rate)
+        } else if (ratePrefs.getBoolean("active", false)) {
+            // Respect a user change made while the profile was active. Guards saved
+            // before the applied rate was recorded used 90.
+            val applied = ratePrefs.getFloat("rate", 90f)
+            if (Settings.System.getString(resolver, key)?.toFloatOrNull() == applied)
+                Settings.System.putString(resolver, key, ratePrefs.getString("previous", null))
+            ratePrefs.edit().clear().commit()
+        }
+    }
+
+    private fun displayCommand(command: String) {
+        val sf = ServiceManager.getService("SurfaceFlinger") ?: error("SurfaceFlinger unavailable")
+        val data = Parcel.obtain()
+        val reply = Parcel.obtain()
+        try {
+            data.writeInterfaceToken("android.ui.ISurfaceComposer")
+            if (command == "repaint") {
+                check(sf.transact(1112, data, reply, 0))
+            } else {
+                val fields = command.split(' ').drop(1).map(String::toInt)
+                check(fields.size == 8)
+                fields.forEach(data::writeInt)
+                check(sf.transact(1111, data, reply, 0))
+                val status = reply.readInt()
+                check(status == 0) { "E-Ink profile rejected: $status" }
+                applyRate(fields[0] == 183)
+            }
+        } finally {
+            data.recycle(); reply.recycle()
+        }
+    }
+
+    override fun runCommands(cmds: Array<String>) {
+        val batch = cmds.copyOf()
+        worker.post { deliver(batch) }
+    }
+
+    private fun deliver(cmds: Array<String>) {
+        try {
+            val socketCommands = cmds.filter {
+                if (it.startsWith("profile ") || it == "repaint") { displayCommand(it); false }
+                else true
+            }
+            if (socketCommands.isEmpty()) return
+            LocalSocket().use { socket ->
+                socket.connect(LocalSocketAddress("a9_eink_socket", LocalSocketAddress.Namespace.ABSTRACT))
+                socket.soTimeout = 1000
+                socket.outputStream.write((socketCommands.joinToString("\n") + "\n").toByteArray())
+                socket.outputStream.flush()
+                for (command in socketCommands) if (command == "scroll0" || command == "scroll1") {
+                    check(socket.inputStream.read() == 'O'.code && socket.inputStream.read() == 'K'.code &&
+                        socket.inputStream.read() == '\n'.code) { "Scroll update not acknowledged" }
+                    displayCommand("repaint")
+                }
+            }
+        } catch (e: Exception) {
+            Log.w("HiBreakEinkSocket", "Command batch could not be delivered", e)
+        }
+    }
+    override fun onDestroy() {
+        thread.quitSafely()
+    }
+}
