+package net.dianqk.hibreak.eink
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.provider.Settings
+import java.time.Instant
+import java.time.ZoneId
+
+object FrontlightPreferences {
+    const val AUTO = "frontlight_auto"
+    const val SCENE = "frontlight_scene"
+    const val NIGHT_START = "frontlight_night_start"
+    const val DAY_START = "frontlight_day_start"
+    const val OVERRIDE_UNTIL = "frontlight_override_until"
+    private const val VERSION = "frontlight_version"
+    fun coldKey(scene: String) = "frontlight_${scene}_cold"
+    fun warmKey(scene: String) = "frontlight_${scene}_warm"
+    fun cold(p: SharedPreferences, scene: String) = p.getInt(coldKey(scene), if (scene == "day") 37 else 22).coerceIn(0, FrontlightSchedule.MAX)
+    fun warm(p: SharedPreferences, scene: String) = p.getInt(warmKey(scene), if (scene == "day") 0 else 37).coerceIn(0, FrontlightSchedule.MAX)
+    fun scene(p: SharedPreferences) = p.getString(SCENE, "day").takeIf { it == "day" || it == "night" } ?: "day"
+    fun nightStart(p: SharedPreferences) = p.getInt(NIGHT_START, FrontlightSchedule.NIGHT_START).coerceIn(0, 1439)
+    fun dayStart(p: SharedPreferences): Int {
+        val day = p.getInt(DAY_START, FrontlightSchedule.DAY_START).coerceIn(0, 1439)
+        return if (day == nightStart(p)) (day + 8 * 60) % 1440 else day
+    }
+
+    fun initialize(context: Context, p: SharedPreferences) {
+        if (p.contains(VERSION)) return
+        val scene = FrontlightSchedule.sceneAt(Instant.now(), ZoneId.systemDefault(), FrontlightSchedule.NIGHT_START, FrontlightSchedule.DAY_START)
+        fun legacy(pref: String, setting: String): Int? =
+            if (p.contains(pref)) p.getInt(pref, 0)
+            else Settings.System.getString(context.contentResolver, setting)?.toIntOrNull()
+        val cold = legacy("cold_brightness_value", "screen_brightness_cold")
+        val warm = legacy("warm_brightness_value", "screen_brightness_warm")
+        // One transaction, in device-protected storage. Existing user values,
+        // including explicit zero, seed the currently scheduled scene only.
+        val edit = p.edit().putInt(coldKey("day"), 37).putInt(warmKey("day"), 0)
+            .putInt(coldKey("night"), 22).putInt(warmKey("night"), 37)
+            .putBoolean(AUTO, true).putString(SCENE, scene)
+            .putInt(NIGHT_START, FrontlightSchedule.NIGHT_START)
+            .putInt(DAY_START, FrontlightSchedule.DAY_START).putInt(VERSION, 1)
+        cold?.let { edit.putInt(coldKey(scene), it.coerceIn(0, FrontlightSchedule.MAX)) }
+        warm?.let { edit.putInt(warmKey(scene), it.coerceIn(0, FrontlightSchedule.MAX)) }
+        edit.apply()
+    }
+
+    fun select(p: SharedPreferences, scene: String) {
+        require(scene == "day" || scene == "night")
+        val until = if (p.getBoolean(AUTO, true)) FrontlightSchedule.nextSwitch(
+            Instant.now(), ZoneId.systemDefault(), nightStart(p), dayStart(p)).toEpochMilli() else 0L
+        p.edit().putString(SCENE, scene).putLong(OVERRIDE_UNTIL, until).apply()
+    }
+
+    fun resolve(p: SharedPreferences, now: Instant = Instant.now()): String {
+        if (!p.getBoolean(AUTO, true) || p.getLong(OVERRIDE_UNTIL, 0) > now.toEpochMilli()) return scene(p)
+        return FrontlightSchedule.sceneAt(now, ZoneId.systemDefault(), nightStart(p), dayStart(p))
+    }
+}
