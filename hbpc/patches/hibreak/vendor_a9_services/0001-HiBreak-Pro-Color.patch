+package net.dianqk.hibreak.eink
+
+import android.net.LocalSocket
+import android.net.LocalSocketAddress
+import android.os.Handler
+import android.os.HandlerThread
+import android.util.Log
+import java.util.concurrent.atomic.AtomicReference
+
+/** Latest desired state wins; hardware acknowledgements are never awaited on the UI thread. */
+class FrontlightWriter {
+    private data class Target(val cold: Int, val warm: Int)
+    private val thread = HandlerThread("HiBreakFrontlight").apply { start() }
+    private val worker = Handler(thread.looper)
+    private val desired = AtomicReference(Target(0, 0))
+    @Volatile private var stopped = false
+    private var retryDelay = 250L
+    private val applyTask: Runnable = object : Runnable {
+        override fun run() {
+            if (stopped) return
+            val target = desired.get()
+            val success = try {
+                LocalSocket().use { socket ->
+                    socket.connect(LocalSocketAddress("a9_eink_socket", LocalSocketAddress.Namespace.ABSTRACT))
+                    socket.soTimeout = 1000
+                    socket.outputStream.write("lights ${target.cold} ${target.warm}\n".toByteArray())
+                    socket.outputStream.flush()
+                    socket.inputStream.bufferedReader().readLine() == "OK"
+                }
+            } catch (e: Exception) {
+                Log.w("HiBreakFrontlight", "Frontlight transport: ${e.message}")
+                false
+            }
+            worker.removeCallbacks(this)
+            when {
+                stopped -> Unit
+                target !== desired.get() -> { retryDelay = 250; worker.post(this) }
+                success -> retryDelay = 250
+                else -> {
+                    Log.w("HiBreakFrontlight", "Hardware unavailable; retry in ${retryDelay}ms")
+                    worker.postDelayed(this, retryDelay)
+                    retryDelay = (retryDelay * 2).coerceAtMost(30_000)
+                }
+            }
+        }
+    }
+    fun request(cold: Int, warm: Int) {
+        if (stopped) return
+        desired.set(Target(cold.coerceIn(0, 220), warm.coerceIn(0, 220)))
+        worker.removeCallbacks(applyTask)
+        worker.postDelayed(applyTask, 40) // Coalesce slider motion, not stored values.
+    }
+    fun close() { stopped = true; worker.removeCallbacksAndMessages(null); thread.quitSafely() }
+}
