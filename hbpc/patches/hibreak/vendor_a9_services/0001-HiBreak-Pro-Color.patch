+package net.dianqk.hibreak.eink
+
+import android.content.SharedPreferences
+
+/** Pixel processing is separate from frontlight levels and waveform flags. */
+object ImageProfile {
+    fun whiteKey(app: String) = "paper_white:package:$app"
+    fun darkKey(app: String) = "dark_ink:package:$app"
+    fun white(p: SharedPreferences, app: String) = p.getInt(whiteKey(app), 0).coerceIn(0, 100)
+    fun dark(p: SharedPreferences, app: String) = p.getInt(darkKey(app), 0).coerceIn(0, 100)
+    fun textKey(app: String) = "text_ink:package:$app"
+    fun text(p: SharedPreferences, app: String) = p.getInt(textKey(app), 0).coerceIn(0, 100)
+    fun contrastKey(app: String) = "contrast:package:$app"
+    fun grayKey(app: String) = "grayscale:package:$app"
+    fun colorKey(app: String) = "color_restore:package:$app"
+    fun waveformKey(app: String) = "waveform:package:$app"
+    fun contrast(p: SharedPreferences, app: String) = p.getInt(contrastKey(app), 0).coerceIn(0, 100)
+    fun gray(p: SharedPreferences, app: String) = p.getBoolean(grayKey(app), false)
+    fun color(p: SharedPreferences, app: String) = p.getBoolean(colorKey(app), false)
+    fun waveform(p: SharedPreferences, app: String) =
+        WaveformMode.fromValue(p.getInt(waveformKey(app), WaveformMode.NORMAL.value))
+    fun belongsTo(app: String, key: String) = key == contrastKey(app) || key == grayKey(app) ||
+        key == whiteKey(app) || key == darkKey(app) || key == textKey(app) || key == colorKey(app) || key == waveformKey(app) || key == DitherMode.key(app)
+    fun usesColor(mode: WaveformMode) = mode == WaveformMode.NORMAL || mode == WaveformMode.FAST
+    fun controlsDither(p: SharedPreferences, app: String): Boolean {
+        val mode = waveform(p, app)
+        return mode != WaveformMode.HYPER && mode != WaveformMode.HD256 &&
+            !(usesColor(mode) && color(p, app))
+    }
+}
+
+enum class DisplayScene(val mode: WaveformMode, val contrast: Int, val scrolling: Boolean) {
+    DAILY(WaveformMode.NORMAL, 0, false),
+    READING(WaveformMode.REGAL, 10, true),
+    PICTURE(WaveformMode.HD256, 0, true),
+    // Factory video preset: Fast with auto-clean and anti-flicker. Its contrast and
+    // brightness 20 are the factory baseline for every app (our 0), and colour
+    // enhancement is ignored in Fast. Hyper stays a manual waveform choice.
+    VIDEO(WaveformMode.FAST, 0, false);
+
+    fun apply(p: SharedPreferences, app: String) {
+        if (app.isEmpty()) return
+        // One preferences transaction: observers always see a complete preset.
+        p.edit().putInt(ImageProfile.waveformKey(app), mode.value)
+            .putInt(DitherMode.key(app), 0)
+            .putInt(ImageProfile.contrastKey(app), contrast)
+            .putInt(ImageProfile.textKey(app), 0)
+            .putInt(ImageProfile.whiteKey(app), 0).putInt(ImageProfile.darkKey(app), 0)
+            .putBoolean(ImageProfile.grayKey(app), false)
+            .putBoolean(ImageProfile.colorKey(app), false)
+            .putBoolean(DisplayProfilePreferences.scrollOptimizationKey(app), scrolling)
+            .putBoolean(DisplayProfilePreferences.autoCleanKey(app), this == DAILY || this == VIDEO)
+            .putBoolean(DisplayProfilePreferences.antiFlickerKey(app), this == DAILY || this == VIDEO)
+            .putInt(DisplayProfilePreferences.cleanFrequencyKey(app), 0).apply()
+    }
+
+    companion object {
+        // Derived from settings so later edits show Custom rather than a stale label.
+        fun selected(p: SharedPreferences, app: String): DisplayScene? = values().firstOrNull {
+            ImageProfile.waveform(p, app) == it.mode && ImageProfile.contrast(p, app) == it.contrast &&
+                ImageProfile.white(p, app) == 0 && ImageProfile.dark(p, app) == 0 &&
+                ImageProfile.text(p, app) == 0 && !ImageProfile.gray(p, app) && !ImageProfile.color(p, app) &&
+                DitherMode.read(p, app) == DitherMode.DEFAULT &&
+                DisplayProfilePreferences.scrollOptimization(p, app) == it.scrolling &&
+                DisplayProfilePreferences.autoClean(p, app) == (it == DAILY || it == VIDEO) &&
+                DisplayProfilePreferences.antiFlicker(p, app) == (it == DAILY || it == VIDEO) &&
+                DisplayProfilePreferences.cleanFrequency(p, app) == 0
+        }
+    }
+}
