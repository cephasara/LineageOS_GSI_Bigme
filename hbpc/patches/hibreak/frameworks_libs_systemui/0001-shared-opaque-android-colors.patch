+++ b/monet/src/com/android/systemui/monet/EinkCustomColors.java
@@ -0,0 +1,32 @@
+/* Copyright 2026 HiBreak Pro Color contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.systemui.monet;
+
+import com.google.ux.material.libmonet.dynamiccolor.DynamicColor;
+import com.google.ux.material.libmonet.dynamiccolor.DynamicScheme;
+import com.google.ux.material.libmonet.dynamiccolor.Variant;
+
+/** Opaque Android-specific roles for the light monochromatic preset. */
+final class EinkCustomColors {
+    private static boolean enabled(DynamicScheme scheme) {
+        return scheme.variant == Variant.MONOCHROME && !scheme.isDark;
+    }
+
+    static DynamicColor adapt(DynamicColor original) {
+        double tone = switch (original.name) {
+            case "shade_active", "on_shade_inactive", "on_shade_inactive_variant" -> 0.0;
+            case "shade_disabled" -> 90.0;
+            default -> 100.0;
+        };
+        // The original tone-delta constraints assume a dark under-surface. Keep
+        // them for other schemes; black/white pairs need no contrast adjustment.
+        return original.toBuilder()
+                .setTone(s -> enabled(s) ? tone : original.tone.apply(s))
+                .setBackground(original.background == null ? null
+                        : s -> enabled(s) ? null : original.background.apply(s))
+                .setToneDeltaPair(original.toneDeltaPair == null ? null
+                        : s -> enabled(s) ? null : original.toneDeltaPair.apply(s))
+                .build();
+    }
+}
