+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.google.ux.material.libmonet.dynamiccolor;
+
+import java.util.function.Function;
+
+/** Achromatic UI hierarchy; retain error red and all non-E-Ink schemes. */
+final class EinkColorRoles {
+  private EinkColorRoles() {}
+
+  static Function<DynamicScheme, Double> einkTone(
+      String role, Function<DynamicScheme, Double> original) {
+    return (scheme) -> {
+      if (scheme.variant != Variant.MONOCHROME || scheme.isDark) {
+        return original.apply(scheme);
+      }
+      return switch (role) {
+        case "background" -> 100.0;
+        case "on_background" -> 0.0;
+        case "surface" -> 100.0;
+        case "surface_dim" -> 100.0;
+        case "surface_bright" -> 100.0;
+        case "surface_container_lowest" -> 100.0;
+        case "surface_container_low" -> 100.0;
+        case "surface_container" -> 100.0;
+        case "surface_container_high" -> 100.0;
+        case "surface_container_highest" -> 100.0;
+        case "on_surface" -> 0.0;
+        case "surface_variant" -> 100.0;
+        case "on_surface_variant" -> 20.0;
+        case "inverse_surface" -> 10.0;
+        case "inverse_on_surface" -> 100.0;
+        case "outline" -> 0.0;
+        case "outline_variant" -> 0.0;
+        case "primary" -> 0.0;
+        case "on_primary" -> 100.0;
+        case "primary_container" -> 100.0;
+        case "on_primary_container" -> 0.0;
+        case "inverse_primary" -> 100.0;
+        case "secondary" -> 0.0;
+        case "secondary_container" -> 100.0;
+        case "on_secondary_container" -> 0.0;
+        case "tertiary" -> 0.0;
+        case "on_tertiary" -> 100.0;
+        case "on_tertiary_container" -> 0.0;
+        case "tertiary_container" -> 100.0;
+        default -> original.apply(scheme);
+      };
+    };
+  }
+}
