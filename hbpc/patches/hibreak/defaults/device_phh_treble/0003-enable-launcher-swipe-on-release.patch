From 9d0b20dc9febf4e362b4a2775d395c180b39949c Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Mon, 7 Sep 2026 13:33:30 +0800
Subject: [PATCH] defaults: enable Launcher swipe completion on release

Launcher overlay: config_swipeOnRelease true, so workspace page swipes complete on release without intermediate frames (apps/Launcher3/0001).

---
 .../packages/apps/Launcher3/res/values/hibreak_flat_surfaces.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/bigme-eink/overlay/packages/apps/Launcher3/res/values/hibreak_flat_surfaces.xml b/bigme-eink/overlay/packages/apps/Launcher3/res/values/hibreak_flat_surfaces.xml
index ea2dba9..d614474 100644
--- a/bigme-eink/overlay/packages/apps/Launcher3/res/values/hibreak_flat_surfaces.xml
+++ b/bigme-eink/overlay/packages/apps/Launcher3/res/values/hibreak_flat_surfaces.xml
@@ -7,4 +7,5 @@
     <dimen name="deep_shortcuts_elevation">0dp</dimen>
     <dimen name="folder_outline_width">1dp</dimen>
     <dimen name="widget_picker_outline_width">1dp</dimen>
+    <bool name="config_swipeOnRelease">true</bool>
 </resources>
-- 
2.56.0

