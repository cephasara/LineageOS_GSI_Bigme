From 21dfd93c15997cb0e5112ce029d3a3a5a663dc1f Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Thu, 22 Oct 2026 08:34:23 +0800
Subject: [PATCH] defaults: do not install other-vendor helper packages

qcom-atel-ready only runs while vendor.qcrild is running, which never
happens on the MediaTek HiBreak Pro Color. Stop adding it to
PRODUCT_PACKAGES; the module source stays in place so the TrebleDroid
tree is otherwise unchanged.

Extended to every other-vendor helper TrebleDroid installs for hardware this phone lacks: QcRilAm (Qualcomm in-call audio) with its two qti am HIDL Java libraries and their interfaces.xml entries, slsi-booted (Samsung LSI), the Xiaomi/OnePlus/ASUS motor helpers, the Oppo/OnePlus fingerprint compat services, oplus-alert-slider and xiaomi-touch. MTK helpers (mtk-sms-fwk-ready, MtkInCallService), Iwlan and QualifiedNetworksService stay. Module sources stay in place.
---
 base.mk        | 29 -----------------------------
 interfaces.xml |  4 ----
 2 files changed, 33 deletions(-)

diff --git a/base.mk b/base.mk
index 40c3e3b..dfbdcb2 100644
--- a/base.mk
+++ b/base.mk
@@ -95,8 +95,6 @@ PRODUCT_PACKAGES += \
     android.hidl.manager-V1.0-java \
     vendor.huawei.hardware.biometrics.fingerprint-V2.1-java \
     vendor.huawei.hardware.tp-V1.0-java \
-    vendor.qti.hardware.radio.am-V1.0-java \
-    vendor.qti.qcril.am-V1.0-java \
     vendor.xiaomi.hardware.displayfeature-V1.0-java
 
 PRODUCT_COPY_FILES += \
@@ -151,15 +149,6 @@ PRODUCT_COPY_FILES += \
 PRODUCT_PACKAGES += \
     mtk-sms-fwk-ready
 
-# QCOM incoming SMS fix
-PRODUCT_PACKAGES += \
-    qcom-atel-ready
-
-# Helper to debug Xiaomi motorized camera
-PRODUCT_PACKAGES += \
-    xiaomi-motor \
-    oneplus-motor
-
 PRODUCT_PACKAGES += \
     Stk
 
@@ -179,9 +168,6 @@ PRODUCT_COPY_FILES += \
 PRODUCT_COPY_FILES += \
     device/phh/treble/ld.config.26.txt:system/etc/ld.config.26.txt \
 
-PRODUCT_PACKAGES += \
-    asus-motor
-
 # Privapp-permissions whitelist for PhhTrebleApp
 PRODUCT_COPY_FILES += \
     device/phh/treble/privapp-permissions-me.phh.treble.app.xml:system/etc/permissions/privapp-permissions-me.phh.treble.app.xml \
@@ -193,10 +179,6 @@ PRODUCT_COPY_FILES += \
     device/phh/treble/remote/phh-remotectl.rc:system/etc/init/phh-remotectl.rc \
     device/phh/treble/remote/phh-remotectl.sh:system/bin/phh-remotectl.sh \
 
-PRODUCT_PACKAGES += \
-    android.hardware.biometrics.fingerprint@2.1-service.oppo.compat \
-    android.hardware.biometrics.fingerprint@2.1-service.oplus.compat \
-
 PRODUCT_PACKAGES += \
     curl
 
@@ -212,9 +194,6 @@ PRODUCT_PRODUCT_PROPERTIES += \
 PRODUCT_PACKAGES += \
     NavigationBarMode2ButtonOverlay
 
-PRODUCT_PACKAGES += \
-    oplus-alert-slider
-
 PRODUCT_COPY_FILES += \
     device/phh/treble/overrides/nothing.txt:system/etc/smartpa_params/empty \
     device/phh/treble/proprietary-files/gome/fs16xx_01s_left.preset.raw:system/phh/gome/fs16xx_01s_left.preset \
@@ -224,9 +203,6 @@ PRODUCT_COPY_FILES += \
 
 PRODUCT_PACKAGES += phh-ota
 
-PRODUCT_PACKAGES += \
-    xiaomi-touch
-
 PRODUCT_COPY_FILES += \
     frameworks/av/services/audiopolicy/config/a2dp_audio_policy_configuration_7_0.xml:system/etc/a2dp_audio_policy_configuration_7_0.xml \
     frameworks/av/services/audiopolicy/config/a2dp_audio_policy_configuration.xml:system/etc/a2dp_audio_policy_configuration.xml \
@@ -240,12 +216,7 @@ PRODUCT_COPY_FILES += \
 PRODUCT_PACKAGES += \
     evgrab \
 
-# QCOM in-call audio fix as a standalone app
-PRODUCT_PACKAGES += \
-    QcRilAm
-
 PRODUCT_PACKAGES += \
-    slsi-booted \
     Iwlan \
     QualifiedNetworksService \
     MtkInCallService \
diff --git a/interfaces.xml b/interfaces.xml
index e5d205b..bae50a2 100644
--- a/interfaces.xml
+++ b/interfaces.xml
@@ -2,10 +2,6 @@
 <permissions>
 	<library name="android.hidl.manager.V1_0"
 		file="/system/framework/android.hidl.manager-V1.0-java.jar" />
-	<library name="vendor.qti.qcril.am.V1_0"
-		file="/system/framework/vendor.qti.qcril.am-V1.0-java.jar" />
-	<library name="vendor.qti.hardware.radio.am.V1_0"
-		file="/system/framework/vendor.qti.hardware.radio.am-V1.0-java.jar" />
 	<library name="vendor.huawei.hardware.biometrics.fingerprint.V2_1"
 		file="/system/framework/vendor.huawei.hardware.biometrics.fingerprint-V2.1-java.jar" />
 	<library name="vendor.huawei.hardware.tp.V1_0"
-- 
2.56.0

