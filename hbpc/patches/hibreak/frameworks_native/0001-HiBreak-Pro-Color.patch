new file mode 100644
index 0000000..0c6650f
--- /dev/null
+++ b/libs/renderengine/skia/EinkShader.h
@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <SkRuntimeEffect.h>
+#include <SkSurface.h>
+#include <SkImage.h>
+#include <string>
+#include <SkCanvas.h>
+#include <SkPaint.h>
+#include <SkSamplingOptions.h>
+#include <SkShader.h>
+#include <SkString.h>
+#include <log/log.h>
+#include <atomic>
+#include <cstdio>
+
+namespace android::renderengine::skia {
+
+struct EinkRenderProfile {
+    bool active = false;
+    int gpu = 0, contrast = 0, gray = 0, text = 0, white = 0, dark = 0;
+};
+
+// Accepts the three, four and six field forms written by SurfaceFlinger. Anything
+// malformed or out of range, and the all-zero profile, is inactive.
+inline EinkRenderProfile parseEinkRenderProfile(const std::string& profile) {
+    EinkRenderProfile p;
+    char extra;
+    const bool legacy = std::sscanf(profile.c_str(), "%d %d %d %c", &p.gpu, &p.contrast, &p.gray, &extra) == 3;
+    const bool inkOnly = !legacy && std::sscanf(profile.c_str(), "%d %d %d %d %c", &p.gpu, &p.contrast, &p.gray, &p.text, &extra) == 4;
+    if ((!legacy && !inkOnly && std::sscanf(profile.c_str(), "%d %d %d %d %d %d %c",
+            &p.gpu, &p.contrast, &p.gray, &p.text, &p.white, &p.dark, &extra) != 6) ||
+        (p.gpu != 0 && p.gpu != 1 && p.gpu != 5) || p.contrast < 0 || p.contrast > 100 ||
+        p.gray < 0 || p.gray > 1 || p.text < 0 || p.text > 100 ||
+        p.white < 0 || p.white > 100 || p.dark < 0 || p.dark > 100 ||
+        (p.gpu == 0 && p.contrast == 0 && p.gray == 0 && p.text == 0 && p.white == 0 && p.dark == 0)) {
+        return {};
+    }
+    p.active = true;
+    return p;
+}
+
+// Parses only when the profile string changes. Called from drawLayersInternal under
+// SkiaRenderEngine::mRenderingMutex. Empty strings (captures, virtual outputs,
+// other devices) return before touching the cache.
+inline EinkRenderProfile einkRenderProfile(const std::string& profile) {
+    if (profile.empty()) return {};
+    static std::string cachedText;
+    static EinkRenderProfile cached;
+    if (profile != cachedText) {
+        cachedText = profile;
+        cached = parseEinkRenderProfile(profile);
+    }
+    return cached;
+}
+
+// Logs the first occurrence of each failure only; the frame is left unprocessed.
+#define EINK_LOG_ONCE(...)                                         \
+    do {                                                           \
+        static std::atomic_bool logged{false};                     \
+        if (!logged.exchange(true)) ALOGE(__VA_ARGS__);            \
+    } while (0)
+
+// Runs once per frame on the completed physical client target, never on virtual
+// displays or screenshots. `source` holds the composed frame: normally a temporary
+// image of a scratch surface that the layers were drawn into, so no copy is made.
+// Writes every pixel of `target` with kSrc and returns true; returns false without
+// drawing if the shader cannot be built.
+inline bool applyEinkShader(SkSurface* target, sk_sp<SkImage> source, const EinkRenderProfile& p) {
+    if (!p.active || !source) return false;
+    // Reconstructed from the factory's embedded shader: HD256 quantizes RGB to
+    // eight levels with ordered dithering; Hyper stretches then thresholds each
+    // channel. Use a generated 8x8 Bayer pattern, not a proprietary LUT/asset.
+    static const auto effect = SkRuntimeEffect::MakeForShader(SkString(R"(
+        uniform shader inputImage;
+        uniform int gpu;
+        uniform float contrast;
+        uniform int grayscale;
+        uniform float textInk;
+        uniform float paperWhite;
+        uniform float darkInk;
+        float neutralWeight(float3 rgb) {
+            float chroma = max(rgb.r, max(rgb.g, rgb.b)) - min(rgb.r, min(rgb.g, rgb.b));
+            return 1.0 - smoothstep(0.03, 0.12, chroma);
+        }
+        // A bounded 3x3 edge treatment, independently implemented. Darken only
+        // existing neutral edge pixels; do not spread ink into a pure white gap.
+        float3 deepenText(float2 p, float3 rgb) {
+            float luminance = dot(rgb, float3(0.2126, 0.7152, 0.0722));
+            float low = luminance, high = luminance;
+            for (int y = -1; y <= 1; ++y) {
+                for (int x = -1; x <= 1; ++x) {
+                    if (x == 0 && y == 0) continue;
+                    float4 sample = float4(inputImage.eval(p + float2(x, y)));
+                    if (sample.a < 0.999) continue;
+                    float3 neighbor = clamp(sample.rgb / sample.a, 0.0, 1.0);
+                    if (neutralWeight(neighbor) < 0.99) continue;
+                    float value = dot(neighbor, float3(0.2126, 0.7152, 0.0722));
+                    low = min(low, value); high = max(high, value);
+                }
+            }
+            float edge = smoothstep(0.08, 0.4, high - low);
+            float weight = neutralWeight(rgb) * (1.0 - smoothstep(0.75, 1.0, luminance));
+            float amount = 0.45 * textInk * edge * weight;
+            return max(float3(0.0), rgb - amount * (0.25 * luminance + 0.75 * (luminance - low)));
+        }
+        // Independent point curves with disjoint luminance bands. A neutral
+        // color gate protects red and other distinct colors; no hard clipping
+        // threshold or content classification is inferred from an app name.
+        float3 adjustPaper(float3 rgb) {
+            float luminance = dot(rgb, float3(0.2126, 0.7152, 0.0722));
+            float neutral = neutralWeight(rgb);
+            float lift = paperWhite * neutral * smoothstep(0.65, 0.95, luminance);
+            float deepen = 0.6 * darkInk * neutral * (1.0 - smoothstep(0.25, 0.6, luminance));
+            return mix(rgb * (1.0 - deepen), float3(1.0), lift);
+        }
+        float bayer(float2 p) {
+            float x = mod(floor(p.x), 8.0);
+            float y = mod(floor(p.y), 8.0);
+            float rank = 0.0;
+            for (int i = 0; i < 3; ++i) {
+                rank = rank * 4.0 + 2.0 * mod(x + y, 2.0) + mod(y, 2.0);
+                x = floor(x * 0.5);
+                y = floor(y * 0.5);
+            }
+            return (float(rank) + 0.5) / 64.0;
+        }
+        half4 main(float2 p) {
+            float4 c = float4(inputImage.eval(p));
+            if (c.a <= 0.0) return half4(0.0);
+            float3 rgb = clamp(c.rgb / c.a, 0.0, 1.0);
+            if (textInk > 0.0 && c.a >= 0.999) rgb = deepenText(p, rgb);
+            if (grayscale == 1) rgb = float3(dot(rgb, float3(0.2126, 0.7152, 0.0722)));
+            rgb = clamp((rgb - 0.5) * (1.0 + contrast * 0.02) + 0.5, 0.0, 1.0);
+            if (paperWhite > 0.0 || darkInk > 0.0) rgb = adjustPaper(rgb);
+            float threshold = bayer(p);
+            if (gpu == 1) rgb = floor(rgb * 7.0 + threshold) / 7.0;
+            if (gpu == 5) {
+                rgb = clamp((rgb - 0.125) / 0.75, 0.0, 1.0);
+                rgb = step(float3(mix(0.005, 0.995, threshold)), rgb);
+            }
+            return half4(rgb * c.a, c.a);
+        }
+    )"));
+    if (!effect.effect) {
+        EINK_LOG_ONCE("EinkRender: shader unavailable: %s", effect.errorText.c_str());
+        return false;
+    }
+    SkRuntimeShaderBuilder builder(effect.effect);
+    builder.child("inputImage") = source->makeShader(SkSamplingOptions());
+    builder.uniform("gpu") = p.gpu;
+    builder.uniform("contrast") = static_cast<float>(p.contrast);
+    builder.uniform("grayscale") = p.gray;
+    builder.uniform("textInk") = static_cast<float>(p.text) / 100.0f;
+    builder.uniform("paperWhite") = static_cast<float>(p.white) / 100.0f;
+    builder.uniform("darkInk") = static_cast<float>(p.dark) / 100.0f;
+    auto shader = builder.makeShader();
+    if (!shader) { EINK_LOG_ONCE("EinkRender: shader binding failed"); return false; }
+    SkPaint paint;
+    paint.setShader(shader);
+    paint.setBlendMode(SkBlendMode::kSrc);
+    target->getCanvas()->drawPaint(paint);
+    return true;
+}
+
+#undef EINK_LOG_ONCE
+} // namespace android::renderengine::skia
