+status_t SurfaceFlinger::applyEinkDisplayProfile(const EinkDisplayProfile& p) {
+    const auto [mode, dither, contrast, gray, restoration, text, white, dark] = p;
+    const bool hyper = mode == 183;
+    const bool hd256 = mode == static_cast<int32_t>(0x800000b1u) ||
+            (mode == 177 && dither == 4);
+    const int gpu = hyper ? 5 : hd256 ? 1 : 0;
+    const bool color = restoration && (mode == 178 || mode == 179);
+    const uint32_t packed = hyper ? 183u : hd256 ? 0x800000b1u :
+            static_cast<uint32_t>(mode) | (static_cast<uint32_t>(dither) << 29);
+    // Hyper is a fast waveform: CompositionEngine also drops its dither pass for
+    // low-rate content, and no ink/paper adjustment applies.
+    const auto profile = hyper ? base::StringPrintf("%d 0 %d 0 0 0", gpu, gray)
+                               : base::StringPrintf("%d %d %d %d %d %d", gpu, contrast, gray,
+                                                    text, white, dark);
+    // Runs on the binder thread, serialized against concurrent profile calls. The XRZ
+    // composer polls these values on each commit, so writing only the values that
+    // differ keeps the result (and the write order below) while avoiding init round
+    // trips and, for the persist property, a flash write per call. Other writers
+    // (a9_eink_server) are respected by comparing with the live value.
+    std::lock_guard lock(mEinkProfileMutex);
+    int written = 0;
+    const auto set = [&written](const char* name, const std::string& value) {
+        if (base::GetProperty(name, "") == value) return true;
+        ++written;
+        return base::SetProperty(name, value);
+    };
+    // Disable the factory override when explicit app dithering is in use.
+    bool ok = set("vendor.xrz.hwc.color_restoration_suppoort", color ? "1" : "0");
+    ok &= set("vendor.xrz.color_restoration_enabled", color ? "1" : "0");
+    ok &= set("vendor.xrz.hwc.image_smoothing_suppoort", "0");
+    ok &= set("persist.vendor.xrz.gpu_dither", std::to_string(gpu));
+    ok &= set("vendor.xrz.gsi_render_profile", profile);
+    ok &= set("vendor.xrz.global_refresh_mode", std::to_string(static_cast<int32_t>(packed)));
+    ALOGI("EinkProfile: mode=%d dither=%d render=%s color=%d applied=%d written=%d",
+          mode, dither, profile.c_str(), color, ok, written);
+    return ok ? OK : INVALID_OPERATION;
+}
