+namespace {
+
+// HiBreak E-Ink render profile for the physical client target. The read-only gate is
+// read once; the properties are re-parsed only when their property serial changes.
+struct EinkRenderProfileText {
+    std::string text;
+    // Hyper (gpu 5) only: the same profile without the 1-bit dither pass.
+    std::string continuousTone;
+};
+
+EinkRenderProfileText parseEinkRenderProfileText(const char* value) {
+    EinkRenderProfileText p{value ? value : "", {}};
+    int gpu, contrast, gray;
+    if (std::sscanf(p.text.c_str(), "%d %d %d", &gpu, &contrast, &gray) == 3 && gpu == 5 &&
+        (gray == 0 || gray == 1)) {
+        // Hyper is a fast waveform: no contrast, text ink, paper white or dark ink.
+        p.text = base::StringPrintf("5 0 %d 0 0 0", gray);
+        p.continuousTone = base::StringPrintf("0 0 %d 0 0 0", gray);
+    }
+    return p;
+}
+
+double parseEinkFps(const char* value, double fallback) {
+    char* end = nullptr;
+    const double fps = value && *value ? std::strtod(value, &end) : fallback;
+    return end && *end ? fallback : fps;
+}
+
+// Like the stock framework, Hyper dithers only while the XRZ composer reports high-rate
+// content (vendor.xrz.cur_fps, a ~10 s average, at or above persist.vendor.xrz.fps_high).
+// Slower content such as 24-30 fps video keeps continuous tone for the composer's own
+// low-rate waveform.
+std::string currentEinkRenderProfile() {
+    static const bool enabled = base::GetBoolProperty("ro.bigme.force_client_composition", false);
+    if (!enabled) return {};
+    static base::CachedParsedProperty profile("vendor.xrz.gsi_render_profile",
+                                              parseEinkRenderProfileText);
+    static std::atomic_int lastDither{-1};
+    auto p = profile.Get();
+    if (p.continuousTone.empty()) {
+        lastDither.store(-1, std::memory_order_relaxed);
+        return std::move(p.text);
+    }
+    static base::CachedParsedProperty curFps("vendor.xrz.cur_fps", [](const char* value) {
+        return parseEinkFps(value, 0);
+    });
+    static base::CachedParsedProperty fpsHigh("persist.vendor.xrz.fps_high", [](const char* value) {
+        return parseEinkFps(value, 50);
+    });
+    const double fps = curFps.Get();
+    const double high = fpsHigh.Get();
+    const int dither = fps >= high ? 1 : 0;
+    if (lastDither.exchange(dither, std::memory_order_relaxed) != dither) {
+        __android_log_print(ANDROID_LOG_INFO, "EinkRender", "hyper dither %s (cur_fps=%g fps_high=%g)",
+                            dither ? "on" : "off", fps, high);
+    }
+    return std::move(dither ? p.text : p.continuousTone);
+}
+
