+
+package com.android.compose.theme
+
+import androidx.compose.foundation.BorderStroke
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.ReadOnlyComposable
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Dp
+import com.android.internal.R
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/**
+ * Flat E-Ink surfaces (`config_flatWindowAppearance`): every tonal surface is white and there
+ * are no shadows, so in-window surfaces carry their own edge. Nothing changes elsewhere.
+ */
+object EinkSurfaces {
+    /** Inactive slider and progress track: one light grey, distinct from the black active part. */
+    val InactiveTrack = Color(0xFFBDBDBD)
+
+    @Composable
+    @ReadOnlyComposable
+    fun isFlat(): Boolean =
+        LocalContext.current.resources.getBoolean(R.bool.config_flatWindowAppearance)
+
+    /** Whole-pixel edge width, about 1dp (2px at 300dpi). */
+    @Composable
+    @ReadOnlyComposable
+    fun edgeWidth(): Dp = with(LocalDensity.current) { max(1, density.roundToInt()).toDp() }
+
+    /** The edge of an in-window surface on flat devices, null elsewhere. */
+    @Composable
+    fun border(color: Color = MaterialTheme.colorScheme.onSurface): BorderStroke? =
+        if (isFlat()) BorderStroke(edgeWidth(), color) else null
+}
