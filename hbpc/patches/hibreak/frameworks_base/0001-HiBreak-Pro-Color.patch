+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+ * Unless required by applicable law or agreed to in writing, software distributed under
+ * the License is distributed on an "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS
+ * OF ANY KIND, either express or implied. See the License for the specific language
+ * governing permissions and limitations under the License.
+ */
+package com.android.internal.graphics.drawable;
+
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.content.res.TypedArray;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Outline;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+
+/**
+ * Draw an existing floating background's outline without altering layout or touch bounds.
+ *
+ * <p>The edge is a whole number of pixels (about 1dp, 2px at 300dpi) in the ink of the
+ * window's own theme ({@code android:colorForeground}), not the system night mode.
+ * Round-rect outlines are stroked directly; path outlines (separate corner radii, top-only
+ * sheets) are stroked inside their own clip.
+ */
+public final class FlatWindowBorder {
+    private static final int[] INK_ATTRS = { android.R.attr.colorForeground };
+
+    private final Outline mOutline = new Outline();
+    private final Rect mRect = new Rect();
+    private final RectF mBounds = new RectF();
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private Resources.Theme mInkTheme;
+    private int mInk;
+
+    /** The edge width of flat windows and surfaces: whole pixels, at least one. */
+    public static int strokeWidth(Resources res) {
+        return Math.max(1, Math.round(res.getDisplayMetrics().density));
+    }
+
+    private int ink(View view) {
+        final Resources.Theme theme = view.getContext().getTheme();
+        if (theme != mInkTheme) {
+            final boolean dark = (view.getResources().getConfiguration().uiMode
+                    & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
+            final TypedArray a = theme.obtainStyledAttributes(INK_ATTRS);
+            try {
+                mInk = a.getColor(0, dark ? Color.WHITE : Color.BLACK);
+            } finally {
+                a.recycle();
+            }
+            mInkTheme = theme;
+        }
+        return mInk;
+    }
+
+    public void draw(View view, Canvas canvas) {
+        if (!view.getResources().getBoolean(com.android.internal.R.bool.config_flatWindowAppearance)) {
+            return;
+        }
+        final Drawable background = view.getBackground();
+        if (background == null) return;
+        mOutline.setEmpty();
+        // Match View.rebuildOutline: providers may leave the default alpha unchanged.
+        mOutline.setAlpha(1.0f);
+        background.getOutline(mOutline);
+        // Transparent full-screen containers are not framed.
+        if (mOutline.getAlpha() <= 0) return;
+        final int width = strokeWidth(view.getResources());
+        mPaint.setColor(ink(view));
+        mPaint.setStyle(Paint.Style.STROKE);
+        if (mOutline.getRect(mRect)) {
+            if (mRect.isEmpty()) return;
+            final float half = width / 2f;
+            mBounds.set(mRect);
+            mBounds.inset(half, half);
+            mPaint.setStrokeWidth(width);
+            final float radius = Math.max(0, mOutline.getRadius() - half);
+            canvas.drawRoundRect(mBounds, radius, radius, mPaint);
+        } else if (mOutline.mMode == Outline.MODE_PATH && mOutline.mPath != null
+                && !mOutline.mPath.isEmpty()) {
+            // Only the inner half of a doubled stroke stays inside the shape.
+            mPaint.setStrokeWidth(2 * width);
+            final int save = canvas.save();
+            canvas.clipPath(mOutline.mPath);
+            canvas.drawPath(mOutline.mPath, mPaint);
+            canvas.restoreToCount(save);
+        }
+    }
+}
