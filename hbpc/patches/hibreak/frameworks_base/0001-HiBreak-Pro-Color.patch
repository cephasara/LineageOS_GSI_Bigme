diff --git a/core/java/com/android/internal/graphics/drawable/FlatWindowBorder.java b/core/java/com/android/internal/graphics/drawable/FlatWindowBorder.java
new file mode 100644
index 000000000..eabe006f5
--- /dev/null
+++ b/core/java/com/android/internal/graphics/drawable/FlatWindowBorder.java
@@ -0,0 +1,97 @@
+/*
