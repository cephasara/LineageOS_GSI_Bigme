From: HiBreak Pro Color <hibreak@localhost>
Date: Sat, 5 Sep 2026 18:16:25 +0800
Subject: [PATCH] HiBreak: Android 16 packages/apps/Settings E-Ink UI

action_button_bg (Wi-Fi QR share buttons) strokes in the outline ink instead of the white accent variant.
---

diff --git a/res/drawable/action_button_bg.xml b/res/drawable/action_button_bg.xml
index b50cc41..979700f 100644
--- a/res/drawable/action_button_bg.xml
+++ b/res/drawable/action_button_bg.xml
@@ -25,8 +25,9 @@
             android:insetBottom="8dp">
             <shape android:shape="rectangle">
                 <corners android:radius="8dp" />
+                <!-- E-Ink: the accent variant is the white container colour; use the ink. -->
                 <stroke android:width="1dp"
-                    android:color="?androidprv:attr/colorAccentPrimaryVariant"/>
+                    android:color="@androidprv:color/materialColorOutline"/>
             </shape>
         </inset>
     </item>
diff --git a/res/values/themes.xml b/res/values/themes.xml
index edba635..c747b70 100644
--- a/res/values/themes.xml
+++ b/res/values/themes.xml
@@ -204,7 +204,7 @@
         <!-- Homepage should follow device default design, the values is same as device default theme.-->
         <item name="android:navigationBarColor">@android:color/white</item>
         <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
-        <item name="android:colorBackground">@color/settingslib_materialColorSurfaceContainerLow</item>
+        <item name="android:colorBackground">@color/settingslib_materialColorSurface</item>
     </style>
 
     <style name="Theme.Settings.Home.NoAnimation">
