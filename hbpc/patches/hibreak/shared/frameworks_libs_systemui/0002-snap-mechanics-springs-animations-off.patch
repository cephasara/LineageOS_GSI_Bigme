From 9809acf9b4f3a4eda7b560c2e22ec046a9a449e3 Mon Sep 17 00:00:00 2001
From: dianqk <dianqk@dianqk.net>
Date: Wed, 21 Oct 2026 22:11:17 +0800
Subject: [PATCH] shared: settle mechanics springs immediately with animations
 off

The mechanics spring library drives Compose QS/shade motion on real time
and ignores the animator duration scale. When animators are disabled
(scale 0), calculateUpdatedState returns the at-rest state, so springs
snap to their target and stop requesting frames.

Change-Id: I7b772b944c5e3cae9e597a28678cd709803c11ba
---
 mechanics/src/com/android/mechanics/spring/SpringState.kt | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/mechanics/src/com/android/mechanics/spring/SpringState.kt b/mechanics/src/com/android/mechanics/spring/SpringState.kt
index bdf7c33..c50d235 100644
--- a/mechanics/src/com/android/mechanics/spring/SpringState.kt
+++ b/mechanics/src/com/android/mechanics/spring/SpringState.kt
@@ -16,6 +16,7 @@
 
 package com.android.mechanics.spring
 
+import android.animation.ValueAnimator
 import androidx.compose.ui.util.packFloats
 import androidx.compose.ui.util.unpackFloat1
 import androidx.compose.ui.util.unpackFloat2
@@ -80,7 +81,12 @@ fun SpringState.calculateUpdatedState(
     elapsedNanos: Long,
     parameters: SpringParameters,
 ): SpringState {
-    if (parameters.isSnapSpring || this == SpringState.AtRest) {
+    // With animations off (animator duration scale 0), springs settle immediately.
+    if (
+        parameters.isSnapSpring ||
+            this == SpringState.AtRest ||
+            !ValueAnimator.areAnimatorsEnabled()
+    ) {
         return SpringState.AtRest
     }
 
