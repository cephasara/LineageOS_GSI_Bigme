-private fun Modifier.sliderBackground(color: Color) = drawWithCache {
+/** [edge]: on flat E-Ink the white background (also the drag mirror over apps) needs an edge. */
+private fun Modifier.sliderBackground(color: Color, edge: BorderStroke? = null) = drawWithCache {
     val offsetAround = SliderBackgroundFrameSize.toSize()
     val newSize = Size(size.width + 2 * offsetAround.width, size.height + 2 * offsetAround.height)
     val offset = Offset(-offsetAround.width, -offsetAround.height)
     val cornerRadius = CornerRadius(SliderBackgroundRoundedCorner.toPx())
+    val edgeWidth = edge?.width?.toPx() ?: 0f
     onDrawBehind {
         drawRoundRect(color = color, topLeft = offset, size = newSize, cornerRadius = cornerRadius)
+        if (edge != null) {
+            val half = edgeWidth / 2
+            drawRoundRect(
+                brush = edge.brush,
+                topLeft = offset + Offset(half, half),
+                size = Size(newSize.width - edgeWidth, newSize.height - edgeWidth),
+                cornerRadius = CornerRadius((cornerRadius.x - half).coerceAtLeast(0f)),
+                style = Stroke(edgeWidth),
+            )
+        }
     }
 }
 
