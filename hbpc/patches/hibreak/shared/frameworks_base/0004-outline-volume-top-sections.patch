     private fun View.applyCorners(fullRadius: Int, diff: Int, progress: Float) {
         val radius = fullRadius - progress * diff
-        (background as GradientDrawable).cornerRadius = radius
+        // Only the upper corners belong to the ringer cap. The lower edge joins
+        // the slider background and must not turn into a separate circle.
+        val shape = ((background as ClipDrawable).drawable as InsetDrawable).drawable
+            as GradientDrawable
+        shape.cornerRadii = floatArrayOf(radius, radius, radius, radius, 0F, 0F, 0F, 0F)
         background.invalidateSelf()
     }
 }
