+<!-- Clip the top stroke where the slider joins the ringer cap. -->
+<clip xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
+    android:clipOrientation="vertical" android:gravity="bottom">
+    <!-- Pixel offsets truncate; cover the full 1dp stroke at fractional densities. -->
+    <inset android:insetTop="-2dp">
+        <shape android:shape="rectangle">
+            <corners
+                android:bottomLeftRadius="@dimen/volume_dialog_background_corner_radius"
+                android:bottomRightRadius="@dimen/volume_dialog_background_corner_radius" />
+            <solid android:color="@androidprv:color/materialColorSurface" />
+            <stroke android:width="1dp"
+                android:color="@androidprv:color/materialColorOnSurface" />
+        </shape>
+    </inset>
+</clip>
