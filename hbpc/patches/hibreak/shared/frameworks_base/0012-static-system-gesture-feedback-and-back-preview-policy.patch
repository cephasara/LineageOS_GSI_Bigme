+ */
+package com.android.systemui.navigationbar.gestural;
+
+/** Distance-based static Back feedback. Input eligibility/exclusions stay in EdgeBackGestureHandler. */
+public final class StaticBackGesture {
+    private boolean mArmed;
+    private boolean mTracking;
+
+    public void reset() {
+        mArmed = false;
+        mTracking = true;
+    }
+
+    public boolean isArmed() {
+        return mArmed;
+    }
+
+    public boolean move(float inward, float vertical, float threshold, float slop) {
+        if (!mTracking) return false;
+        // A separate retreat threshold avoids flashing around the activation boundary.
+        float retreatThreshold = Math.max(0, threshold - Math.min(slop, threshold / 2));
+        mArmed = inward * 2 >= vertical
+                && (mArmed ? inward > retreatThreshold : inward >= threshold);
+        return mArmed;
+    }
+
+    public boolean finish(boolean cancelled) {
+        boolean commit = mTracking && mArmed && !cancelled;
+        mTracking = false;
+        mArmed = false;
+        return commit;
+    }
+}
