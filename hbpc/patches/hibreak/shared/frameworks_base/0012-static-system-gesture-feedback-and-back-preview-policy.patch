+    /** Discrete feedback with a release-to-commit lifecycle, independent of spring callbacks. */
+    private fun onStaticMotionEvent(event: MotionEvent) {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                cancelAllPendingAnimations()
+                startX = event.x
+                startY = event.y
+                staticGesture.reset()
+                currentState = GestureState.GONE
+                backCallback.setTriggerBack(false)
+                setTriggerLongSwipe(false)
+                mView.isVisible = false
+                mView.resetStretch()
+                mView.verticalTranslation.snapTo(0f)
+                // Window gravity already selects LEFT/RIGHT. Center the indicator vertically.
+                layoutParams.y = max(0, (displaySize.y - layoutParams.height) / 2)
+                windowManager.updateViewLayout(mView, layoutParams)
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val dx = max(0f, if (mView.isLeftPanel) event.x - startX else startX - event.x)
+                val wasArmed = staticGesture.isArmed
+                val armed = staticGesture.move(
+                    dx, abs(event.y - startY),
+                    max(params.staticTriggerThreshold, viewConfiguration.scaledEdgeSlop.toFloat()),
+                    viewConfiguration.scaledTouchSlop.toFloat(),
+                )
+                setTriggerLongSwipe(armed && isLongSwipeEnabled && dx > longSwipeThreshold)
+                currentState = if (armed) GestureState.ACTIVE else GestureState.INACTIVE
+                backCallback.setTriggerBack(armed)
+                if (armed != wasArmed) {
+                    if (armed) performActivatedHapticFeedback() else performDeactivatedHapticFeedback()
+                }
+                // No stretch, fade, translation or timer; the glyph matches the commit state.
+                mView.setRestingDimens(params.activeIndicator, animate = false)
+                mView.verticalTranslation.snapTo(0f)
+                mView.isVisible = armed
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                val cancelled = event.actionMasked == MotionEvent.ACTION_CANCEL
+                if (cancelled) setTriggerLongSwipe(false)
+                val commit = staticGesture.finish(cancelled)
+                if (commit && !triggerLongSwipe) {
+                    backCallback.triggerBack(false)
+                } else {
+                    // Shell's normal cancel path dispatches an enabled Lineage long-swipe action.
+                    backCallback.cancelBack()
+                }
+                mView.isVisible = false
+                currentState = GestureState.GONE
+                // Keep long-swipe state until Shell receives this UP/CANCEL; reset on next DOWN.
+            }
+        }
+    }
+
     private fun cancelAllPendingAnimations() {
         cancelFailsafe()
         mView.cancelAnimations()
