+package androidx.core.animation;
+
+/**
+ * Makes androidx.core.animation follow the system animator duration scale in SystemUI.
+ *
+ * The AndroidX library keeps its own static scale at 1.0 and only exposes a package-private
+ * setter, so status bar chips, keyguard fades, notification expansion and other SystemUI
+ * animations built on it ran full length even with animations off. This class lives in the
+ * library's package (same class loader in the SystemUI APK) to reach that setter; the
+ * library itself is a prebuilt.
+ */
+public final class PlatformDurationScaleBridge {
+    // The platform keeps only a weak reference to listeners.
+    private static android.animation.ValueAnimator.DurationScaleChangeListener sListener;
+
+    private PlatformDurationScaleBridge() {}
+
+    /** Copies the current platform scale and follows later changes. Main thread only. */
+    public static void install() {
+        if (sListener != null) return;
+        sListener = ValueAnimator::setDurationScale;
+        android.animation.ValueAnimator.registerDurationScaleChangeListener(sListener);
+        ValueAnimator.setDurationScale(android.animation.ValueAnimator.getDurationScale());
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java b/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
index 00887f7b4..0c4598772 100644
--- a/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
+++ b/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
@@ -118,6 +118,8 @@ public class SystemUIApplicationImpl extends SystemUIApplication implements
     public void onCreate() {
         super.onCreate();
         Log.v(TAG, "SystemUIApplication created.");
+        // AndroidX core-animation otherwise ignores the system animator duration scale.
+        androidx.core.animation.PlatformDurationScaleBridge.install();
         // This line is used to setup Dagger's dependency injection and should be kept at the
         // top of this method.
         TimingsTraceLog log = new TimingsTraceLog("SystemUIBootTiming",
