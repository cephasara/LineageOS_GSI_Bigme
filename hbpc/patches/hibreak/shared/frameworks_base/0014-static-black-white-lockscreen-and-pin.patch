+package com.android.keyguard;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.InsetDrawable;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+/** Product-selected presentation only. Never decides whether authentication succeeds. */
+public final class EinkKeyguard {
+    private EinkKeyguard() {}
+
+    public static boolean isEnabled(Context context) {
+        return context.getResources().getBoolean(com.android.systemui.customization.R.bool.config_einkKeyguard);
+    }
+
+    /** Stroke is one physical pixel; rounded rectangles use a 12dp corner. */
+    public static GradientDrawable outline(Context context, boolean circle) {
+        return shape(circle ? -1 : 12 * context.getResources().getDisplayMetrics().density);
+    }
+
+    /** White with a one-pixel black stroke; a negative radius gives an oval. */
+    private static GradientDrawable shape(float radius) {
+        GradientDrawable background = new GradientDrawable();
+        if (radius < 0) background.setShape(GradientDrawable.OVAL);
+        else background.setCornerRadius(radius);
+        background.setColor(Color.WHITE);
+        background.setStroke(1, Color.BLACK);
+        return background;
+    }
+
+    public static Drawable pinDot(boolean filled) {
+        GradientDrawable dot = shape(-1);
+        dot.setColor(filled ? Color.BLACK : Color.WHITE);
+        return new InsetDrawable(dot, 0.25f);
+    }
+
+    public static void styleText(View view) {
+        if (view instanceof TextView text) {
+            text.setTextColor(Color.BLACK);
+            text.setShadowLayer(0, 0, 0, Color.TRANSPARENT);
+        }
+        if (view instanceof ViewGroup group) {
+            for (int i = 0; i < group.getChildCount(); i++) styleText(group.getChildAt(i));
+        }
+    }
+}
