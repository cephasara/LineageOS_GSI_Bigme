+    @Test
+    public void einkDrag_keepsPinStationaryAndPreservesReleaseCallback() {
+        mContext.getOrCreateTestableResources().addOverride(
+                com.android.systemui.customization.R.bool.config_einkKeyguard, true);
+        KeyguardSecurityContainer.SwipeListener listener =
+                mock(KeyguardSecurityContainer.SwipeListener.class);
+        mKeyguardSecurityContainer.setSwipeListener(listener);
+        mKeyguardSecurityContainer.setInteractable(true);
+        float travel = 80 * mContext.getResources().getDisplayMetrics().density;
+        einkTouch(MotionEvent.ACTION_DOWN, travel);
+        einkTouch(MotionEvent.ACTION_MOVE, travel);
+        einkTouch(MotionEvent.ACTION_MOVE, 0);
+        assertThat(mKeyguardSecurityContainer.getTranslationY()).isEqualTo(0f);
+        verifyNoInteractions(listener);
+        einkTouch(MotionEvent.ACTION_UP, 0);
+        verify(listener).onSwipeUp();
+        assertThat(mKeyguardSecurityContainer.getTranslationY()).isEqualTo(0f);
+        // A new stream cannot inherit the previous accepted distance.
+        einkTouch(MotionEvent.ACTION_DOWN, travel);
+        einkTouch(MotionEvent.ACTION_UP, travel);
+        verifyNoMoreInteractions(listener);
+    }
+
+    @Test
+    public void einkDrag_cancelDoesNotInvokeSwipeCallback() {
+        mContext.getOrCreateTestableResources().addOverride(
+                com.android.systemui.customization.R.bool.config_einkKeyguard, true);
+        KeyguardSecurityContainer.SwipeListener listener =
+                mock(KeyguardSecurityContainer.SwipeListener.class);
+        mKeyguardSecurityContainer.setSwipeListener(listener);
+        mKeyguardSecurityContainer.setInteractable(true);
+        float travel = 80 * mContext.getResources().getDisplayMetrics().density;
+        einkTouch(MotionEvent.ACTION_DOWN, 0);
+        einkTouch(MotionEvent.ACTION_MOVE, 0);
+        einkTouch(MotionEvent.ACTION_MOVE, travel);
+        einkTouch(MotionEvent.ACTION_CANCEL, travel);
+        assertThat(mKeyguardSecurityContainer.getTranslationY()).isEqualTo(0f);
+        einkTouch(MotionEvent.ACTION_DOWN, 0);
+        einkTouch(MotionEvent.ACTION_UP, 0);
+        verifyNoInteractions(listener);
+    }
+
+    private void einkTouch(int action, float y) {
+        MotionEvent event = MotionEvent.obtain(0, android.os.SystemClock.uptimeMillis(),
+                action, 100, y, 0);
+        if (action == MotionEvent.ACTION_DOWN) {
+            mKeyguardSecurityContainer.onInterceptTouchEvent(event);
+        }
+        mKeyguardSecurityContainer.onTouchEvent(event);
+        event.recycle();
+    }
