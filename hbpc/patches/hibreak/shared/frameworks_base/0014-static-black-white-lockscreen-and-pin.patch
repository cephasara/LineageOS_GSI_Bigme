+package com.android.keyguard
+
+import android.graphics.Color
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.InsetDrawable
+import android.testing.TestableLooper
+import android.widget.ImageView
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.filters.SmallTest
+import com.android.systemui.SysuiTestCase
+import org.junit.Assert.assertEquals
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@SmallTest
+@RunWith(AndroidJUnit4::class)
+@TestableLooper.RunWithLooper
+class EinkPinShapesTest : SysuiTestCase() {
+    @Before fun setup() {
+        context.orCreateTestableResources.addOverride(
+            com.android.systemui.customization.R.bool.config_einkKeyguard, true)
+    }
+
+    private fun color(view: ImageView): Int =
+        ((view.drawable as InsetDrawable).drawable as GradientDrawable).color!!.defaultColor
+
+    @Test fun hintSlotsKeepTheirCountAndClearImmediately() {
+        val view = PinShapeHintingView(context, null)
+        assertEquals(6, view.childCount)
+        assertEquals(Color.WHITE, color(view.getChildAt(0) as ImageView))
+        view.append()
+        assertEquals(Color.BLACK, color(view.getChildAt(0) as ImageView))
+        view.delete()
+        assertEquals(Color.WHITE, color(view.getChildAt(0) as ImageView))
+        repeat(6) { view.append() }
+        view.reset()
+        assertEquals(6, view.childCount)
+        repeat(6) { assertEquals(Color.WHITE, color(view.getChildAt(it) as ImageView)) }
+    }
+
+    @Test fun legacyInputKeepsMaskedAccessibilityTextAndInputLifecycle() {
+        val view = object : PasswordTextView(context, null) {
+            fun maskedText() = getTransformedText().toString()
+        }
+        view.append('1')
+        view.append('2')
+        assertEquals("12", view.text)
+        assertEquals("\u2022\u2022", view.maskedText())
+        view.deleteLastChar()
+        assertEquals("1", view.text)
+        assertEquals("\u2022", view.maskedText())
+        view.reset(true, false)
+        assertEquals("", view.text)
+        assertEquals("", view.maskedText())
+    }
+
+    @Test fun rapidAppendDeleteResetDoesNotLeaveDeferredDots() {
+        val view = PinShapeNonHintingView(context, null)
+        repeat(8) { view.append() }
+        view.delete()
+        assertEquals(7, view.childCount)
+        view.reset()
+        assertEquals(0, view.childCount)
+        view.append()
+        assertEquals(1, view.childCount)
+        assertEquals(Color.BLACK, color(view.getChildAt(0) as ImageView))
+    }
+}
