+++ b/core/java/android/view/View.java
@@ -69,6 +69,7 @@ import static java.lang.Math.max;
 
 import android.animation.AnimatorInflater;
 import android.animation.StateListAnimator;
+import android.animation.ValueAnimator;
 import android.annotation.AttrRes;
 import android.annotation.CallSuper;
 import android.annotation.ColorInt;
@@ -33074,6 +33075,14 @@ public class View implements Drawable.Callback, KeyEvent.Callback,
                 fadeScrollBarsScheduled = false;
                 handler = null;
 
+                // With animations off, hide the scrollbars in one frame instead of a
+                // per-frame fade.
+                if (!ValueAnimator.areAnimatorsEnabled()) {
+                    state = OFF;
+                    host.invalidate(true);
+                    return;
+                }
+
