+
+package com.android.systemui.doze
+
+import android.app.AlarmManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.Handler
+import android.os.HandlerExecutor
+import android.os.SystemClock
+import android.provider.Settings
+import android.util.Log
+import android.view.Display
+import com.android.systemui.broadcast.BroadcastDispatcher
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.doze.dagger.WrappedService
+import com.android.systemui.settings.UserTracker
+import com.android.systemui.statusbar.phone.DozeParameters
+import com.android.systemui.util.wakelock.SettableWakeLock
+import com.android.systemui.util.wakelock.WakeLock
+import java.io.PrintWriter
+import java.util.Calendar
+import javax.inject.Inject
+
+/**
+ * E-Ink sleep screen, clock mode (clock_1 / clock_5 / clock_15): while the device sleeps in the
+ * DOZE state with the display off, update the sleep page at every wall-clock boundary of the
+ * chosen interval. A wakeup RTC alarm fires at the boundary; the page redraws its time, the
+ * display is turned on (doze screen state ON, the same state as the screen-off wait after going
+ * to sleep) until the redrawn page was presented and settled ([EinkSleepScreenGate.awaitRefresh],
+ * bounded by a timeout), then off again. A wake lock is held only for that window; between
+ * updates the CPU can suspend. Time and time zone changes redraw at once and reschedule.
+ * Everything stops when the doze machine leaves DOZE (waking up, finish).
+ */
+class EinkSleepScreenRefresher
+@Inject
+constructor(
+    @WrappedService private val dozeService: DozeMachine.Service,
+    @Main private val handler: Handler,
+    private val alarmManager: AlarmManager,
+    private val gate: EinkSleepScreenGate,
+    private val dozeParameters: DozeParameters,
+    private val broadcastDispatcher: BroadcastDispatcher,
+    private val userTracker: UserTracker,
+    wakeLock: WakeLock,
+) : DozeMachine.Part {
+    private val wakeLock = SettableWakeLock(wakeLock, "EinkSleepScreenRefresh")
+    private var interval = 0
+    private var refreshing = false
+    private var receiverRegistered = false
+    private var nextAt = 0L
+    private var count = 0
+
+    private val alarm = AlarmManager.OnAlarmListener { refresh("tick") }
+
+    private val timeChanged =
+        object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                refresh(
+                    if (intent.action == Intent.ACTION_TIMEZONE_CHANGED) "time zone" else "time"
+                )
+            }
+        }
+
+    override fun transitionTo(oldState: DozeMachine.State, newState: DozeMachine.State) {
+        if (newState == DozeMachine.State.DOZE) {
+            if (interval == 0) start()
+        } else if (newState != DozeMachine.State.INITIALIZED) {
+            stop()
+        }
+    }
+
+    override fun destroy() = stop()
+
+    private fun start() {
+        if (!gate.isWaitEnabled() || dozeParameters.alwaysOn) return
+        val mode =
+            Settings.Secure.getStringForUser(
+                userTracker.userContext.contentResolver,
+                EinkSleepScreenGate.SETTING_MODE,
+                userTracker.userId,
+            )
+        interval = EinkSleepScreenGate.clockInterval(mode)
+        if (interval == 0) return
+        count = 0
+        val filter =
+            IntentFilter().apply {
+                addAction(Intent.ACTION_TIME_CHANGED)
+                addAction(Intent.ACTION_TIMEZONE_CHANGED)
+            }
+        broadcastDispatcher.registerReceiver(timeChanged, filter, HandlerExecutor(handler))
+        receiverRegistered = true
+        Log.i(TAG, "clock: every $interval min")
+        schedule()
+    }
+
+    private fun stop() {
+        if (interval == 0) return
+        interval = 0
+        alarmManager.cancel(alarm)
+        if (receiverRegistered) {
+            broadcastDispatcher.unregisterReceiver(timeChanged)
+            receiverRegistered = false
+        }
+        if (refreshing) gate.cancel()
+        refreshing = false
+        wakeLock.setAcquired(false)
+        Log.i(TAG, "clock: stopped after $count updates")
+    }
+
+    /** Next local wall-clock boundary of [interval] minutes, strictly after now. */
+    private fun schedule() {
+        if (interval == 0) return
+        val calendar = Calendar.getInstance()
+        calendar.set(Calendar.SECOND, 0)
+        calendar.set(Calendar.MILLISECOND, 0)
+        val minute = calendar.get(Calendar.MINUTE)
+        calendar.add(Calendar.MINUTE, interval - minute % interval)
+        nextAt = calendar.timeInMillis
+        alarmManager.setExact(AlarmManager.RTC_WAKEUP, nextAt, ALARM_TAG, alarm, handler)
+    }
+
+    private fun refresh(reason: String) {
+        if (interval == 0 || refreshing) return
+        alarmManager.cancel(alarm)
+        if (gate.isWaiting()) {
+            // The screen-off wait after going to sleep is still running; try again shortly.
+            alarmManager.setExact(
+                AlarmManager.ELAPSED_REALTIME_WAKEUP,
+                SystemClock.elapsedRealtime() + RETRY_MS,
+                ALARM_TAG,
+                alarm,
+                handler,
+            )
+            return
+        }
+        wakeLock.setAcquired(true)
+        refreshing = true
+        val started =
+            gate.awaitRefresh(
+                reason,
+                screenOn = { dozeService.setDozeScreenState(Display.STATE_ON) },
+                onRelease = {
+                    refreshing = false
+                    count++
+                    dozeService.setDozeScreenState(Display.STATE_OFF)
+                    wakeLock.setAcquired(false)
+                    schedule()
+                },
+                cancelled = {
+                    refreshing = false
+                    wakeLock.setAcquired(false)
+                },
+            )
+        if (!started) {
+            refreshing = false
+            wakeLock.setAcquired(false)
+            Log.i(TAG, "refresh ($reason) skipped: page cannot refresh")
+            schedule()
+        }
+    }
+
+    override fun dump(pw: PrintWriter) {
+        pw.println(" EinkSleepScreenRefresher: interval=$interval refreshing=$refreshing" +
+            " next=$nextAt updates=$count")
+    }
+
+    private companion object {
+        const val TAG = EinkSleepScreenGate.TAG
+        const val ALARM_TAG = "EinkSleepScreen:clock"
+        const val RETRY_MS = 1000L
+    }
+}
