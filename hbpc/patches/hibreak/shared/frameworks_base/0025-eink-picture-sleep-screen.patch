+/**
+ * E-Ink sleep screen: from the start of going to sleep (AOD off) and while the keyguard is
+ * DOZING an opaque page covers the keyguard so the panel keeps it after the display turns off.
+ * Only present under the E-Ink keyguard policy; hidden as soon as the device starts waking. The
+ * first presented frame with the page is reported to [EinkSleepScreenGate], which holds the doze
+ * screen-off request until the panel has finished drawing it.
+ *
+ * The page is drawn above every other keyguard view (translationZ [PAGE_Z]); clock, smartspace
+ * and other views added to the root later stay under it. Modes ([EinkSleepScreenGate.SETTING_MODE],
+ * per user; unknown values are picture):
+ * - picture: LineageOS logo and "Locked at hh:mm"; the AOD notification icons stay above.
+ * - clock_1 / clock_5 / clock_15: large black time and date, redrawn while asleep at every
+ *   wall-clock boundary of the interval by [com.android.systemui.doze.EinkSleepScreenRefresher].
+ * - lockscreen: the keyguard as drawn before going to sleep, captured at the start of going to
+ *   sleep when the lock screen was shown. Otherwise (sleep from an app) picture.
+ * - custom: the image chosen in the E-Ink app, fitted on white, optionally with "Locked at".
+ *   Read through the app's provider ([IMAGE_URI]); unavailable images show picture.
+ */
+class EinkSleepScreenSection
+@Inject
+constructor(
+    @ShadeDisplayAware private val context: Context,
+    private val keyguardTransitionInteractor: KeyguardTransitionInteractor,
+    private val powerInteractor: PowerInteractor,
+    private val dozeParameters: DozeParameters,
+    private val sleepScreenGate: EinkSleepScreenGate,
+    private val userTracker: UserTracker,
+    @Background private val bgExecutor: Executor,
+) : KeyguardSection(), EinkSleepScreenGate.Page {
+    private enum class Kind(val label: String) {
+        PICTURE("picture"),
+        CLOCK("clock"),
+        LOCK_SCREEN("lockscreen"),
+        CUSTOM("custom"),
+    }
+
+    /** The bitmap holds its own reference to the capture buffer; dropping it frees the buffer. */
+    private class Snapshot(val bitmap: Bitmap, val uptime: Long)
+
+    private class CustomImage(val key: String, val bitmap: Bitmap)
+
+    /** Tracks the screen state the view root uses: no draws reach the panel while it is off. */
+    private class PageView(context: Context) : FrameLayout(context) {
+        var screenOff = false
+
+        override fun onScreenStateChanged(screenState: Int) {
+            super.onScreenStateChanged(screenState)
+            screenOff = screenState == View.SCREEN_STATE_OFF
+        }
+    }
+
+    private val viewId = R.id.eink_sleep_screen
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private var page: PageView? = null
+    private var root: ConstraintLayout? = null
+    private var handle: DisposableHandle? = null
+    private var shown = false
+    private var kind = Kind.PICTURE
+    private var lockedAt = ""
+    private var showLockTime = true
+    private var generation = 0
+    private var presentListener: Pair<ViewTreeObserver, ViewTreeObserver.OnPreDrawListener>? =
+        null
+    private var clockTime: TextView? = null
+    private var clockDate: TextView? = null
+
+    /** Captured on a binder thread at the start of going to sleep, taken when shown. */
+    private val pendingSnapshot = AtomicReference<Snapshot?>()
+    @Volatile private var snapshotSkipped = "not captured"
+    private var shownSnapshot: Snapshot? = null
+
+    private var customImage: CustomImage? = null
+    private var customImageError: String? = null
+    private var customImageLoading: String? = null
+    private var observing = false
+
+    private val settingsObserver =
+        object : ContentObserver(mainHandler) {
+            override fun onChange(selfChange: Boolean, uri: Uri?) = reloadCustomImage()
+        }
+    private val userCallback =
+        object : UserTracker.Callback {
+            override fun onUserChanged(newUser: Int, userContext: Context) = reloadCustomImage()
+        }
+
+    override fun addViews(constraintLayout: ConstraintLayout) {
+        if (!EinkKeyguard.isEnabled(context)) return
+        root = constraintLayout
+        page =
+            PageView(context).apply {
+                id = viewId
+                isClickable = false
+                isFocusable = false
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS
+                // Above every other keyguard view, also those added to the root later (clock
+                // views, smartspace, rebuilt sections). No outline: no shadow.
+                translationZ = PAGE_Z
+                outlineProvider = null
+                visibility = if (shown) View.VISIBLE else View.GONE
+            }
+        if (shown) buildContent()
+        constraintLayout.addView(page)
+        sleepScreenGate.page = this
+        if (!observing) {
+            observing = true
+            for (key in
+                listOf(EinkSleepScreenGate.SETTING_MODE, EinkSleepScreenGate.SETTING_IMAGE)) {
+                context.contentResolver.registerContentObserverAsUser(
+                    Settings.Secure.getUriFor(key),
+                    false,
+                    settingsObserver,
+                    android.os.UserHandle.ALL,
+                )
+            }
+            userTracker.addCallback(userCallback, context.mainExecutor)
+        }
+        reloadCustomImage()
+    }
+
+    override fun bindData(constraintLayout: ConstraintLayout) {
+        val view = page ?: return
+        handle?.dispose()
+        handle =
+            view.repeatWhenAttached {
+                repeatOnLifecycle(Lifecycle.State.CREATED) {
+                    launch("$TAG#dozing") {
+                        // Show when going to sleep starts (AOD off) or the transition into DOZING
+                        // starts, whichever comes first; hide when waking starts and the keyguard
+                        // leaves DOZING.
+                        combine(
+                                keyguardTransitionInteractor.startedKeyguardTransitionStep.map {
+                                    it.to == KeyguardState.DOZING
+                                },
+                                powerInteractor.isAsleep,
+                            ) { dozing, asleep ->
+                                dozing || (asleep && !dozeParameters.alwaysOn)
+                            }
+                            .distinctUntilChanged()
+                            .collect { setShown(it) }
+                    }
+                }
+            }
+    }
+
+    override fun applyConstraints(constraintSet: ConstraintSet) {
+        if (page == null) return
+        constraintSet.apply {
+            connect(viewId, ConstraintSet.TOP, ConstraintSet.PARENT_ID, ConstraintSet.TOP)
+            connect(viewId, ConstraintSet.BOTTOM, ConstraintSet.PARENT_ID, ConstraintSet.BOTTOM)
+            connect(viewId, ConstraintSet.START, ConstraintSet.PARENT_ID, ConstraintSet.START)
+            connect(viewId, ConstraintSet.END, ConstraintSet.PARENT_ID, ConstraintSet.END)
+            constrainWidth(viewId, ConstraintSet.MATCH_CONSTRAINT)
+            constrainHeight(viewId, ConstraintSet.MATCH_CONSTRAINT)
+            setVisibility(viewId, if (shown) View.VISIBLE else View.GONE)
+            // ConstraintSet.applyTo writes translationZ: keep the page and icon order.
+            setTranslationZ(viewId, PAGE_Z)
+            if (root?.findViewById<View>(ICONS_ID) != null) {
+                setTranslationZ(ICONS_ID, iconsZ())
+            }
+        }
+    }
+
+    override fun removeViews(constraintLayout: ConstraintLayout) {
+        handle?.dispose()
+        handle = null
+        removePresentListener()
+        setIconsAbovePage(false)
+        constraintLayout.removeView(viewId)
+        if (sleepScreenGate.page === this) sleepScreenGate.page = null
+        if (observing) {
+            observing = false
+            context.contentResolver.unregisterContentObserver(settingsObserver)
+            userTracker.removeCallback(userCallback)
+        }
+        page = null
+        clockTime = null
+        clockDate = null
+        root = null
+    }
+
+    private fun setShown(show: Boolean) {
+        val view = page ?: return
+        if (show == shown) return
+        shown = show
+        val current = ++generation
+        if (!show) {
+            removePresentListener()
+            view.visibility = View.GONE
+            view.removeAllViews()
+            clockTime = null
+            clockDate = null
+            shownSnapshot = null
+            pendingSnapshot.set(null)
+            setIconsAbovePage(false)
+            sleepScreenGate.onPageHidden()
+            Log.i(TAG, "hidden")
+            return
+        }
+        val raw = readSetting(EinkSleepScreenGate.SETTING_MODE)
+        val shownAt = SystemClock.uptimeMillis()
+        var fallback: String? = null
+        kind =
+            when {
+                EinkSleepScreenGate.clockInterval(raw) > 0 -> Kind.CLOCK
+                raw == EinkSleepScreenGate.MODE_LOCK_SCREEN -> {
+                    val snapshot = pendingSnapshot.getAndSet(null)
+                    if (snapshot != null && shownAt - snapshot.uptime <= SNAPSHOT_MAX_AGE_MS) {
+                        shownSnapshot = snapshot
+                        Kind.LOCK_SCREEN
+                    } else {
+                        fallback = "lock screen " +
+                            (if (snapshot != null) "snapshot too old" else snapshotSkipped)
+                        Kind.PICTURE
+                    }
+                }
+                raw == EinkSleepScreenGate.MODE_CUSTOM -> {
+                    val image = customImage
+                    if (image != null && image.key == customImageKey()) {
+                        Kind.CUSTOM
+                    } else {
+                        fallback = "custom image " + (customImageError
+                            ?: if (customImageLoading != null) "still loading" else "not loaded")
+                        reloadCustomImage()
+                        Kind.PICTURE
+                    }
+                }
+                else -> Kind.PICTURE
+            }
+        lockedAt = DateFormat.getTimeFormat(context).format(Date())
+        showLockTime = readIntSetting(EinkSleepScreenGate.SETTING_IMAGE_TIME, 1) != 0
+        buildContent()
+        setIconsAbovePage(kind == Kind.PICTURE)
+        view.visibility = View.VISIBLE
+        val known = raw == null || raw == EinkSleepScreenGate.MODE_PICTURE ||
+            raw == EinkSleepScreenGate.MODE_LOCK_SCREEN || raw == EinkSleepScreenGate.MODE_CUSTOM ||
+            EinkSleepScreenGate.clockInterval(raw) > 0
+        Log.i(TAG, "shown locked-at=$lockedAt mode=${kind.label}" +
+            (if (kind == Kind.CLOCK) " every=${EinkSleepScreenGate.clockInterval(raw)}min"
+                else "") +
+            (if (!known) " (setting=$raw)" else "") +
+            (if (fallback != null) " (fallback: $fallback)" else "") +
+            " uptime=$shownAt")
+        sleepScreenGate.onPageShown(shownAt)
+        watchPresented(view, current)
+    }
+
+    /** Clock mode refresh while asleep (EinkSleepScreenGate.awaitRefresh, main thread). */
+    override fun refresh(): Boolean {
+        val view = page ?: return false
+        if (!shown || kind != Kind.CLOCK) return false
+        updateClock()
+        watchPresented(view, ++generation)
+        return true
+    }
+
+    /**
+     * Binder thread, start of going to sleep, before SystemUI reacts to it: in lock screen mode
+     * capture the notification shade window (the keyguard) while it still shows the lock screen.
+     */
+    override fun onStartedGoingToSleep() {
+        pendingSnapshot.set(null)
+        snapshotSkipped = "not captured"
+        if (readSetting(EinkSleepScreenGate.SETTING_MODE) != EinkSleepScreenGate.MODE_LOCK_SCREEN) {
+            return
+        }
+        val finished = keyguardTransitionInteractor.finishedKeyguardState.value
+        val started = keyguardTransitionInteractor.startedKeyguardTransitionStep.value.to
+        if (finished != KeyguardState.LOCKSCREEN || started != KeyguardState.LOCKSCREEN) {
+            snapshotSkipped = "not shown when going to sleep (keyguard $finished, to $started)"
+            return
+        }
+        val window = page?.rootView
+        val surface: SurfaceControl? = window?.viewRootImpl?.surfaceControl
+        val width = window?.width ?: 0
+        val height = window?.height ?: 0
+        if (surface == null || !surface.isValid || width <= 0 || height <= 0) {
+            snapshotSkipped = "window not available"
+            return
+        }
+        val start = SystemClock.uptimeMillis()
+        val capture =
+            ScreenCaptureInternal.captureLayers(
+                ScreenCaptureInternal.LayerCaptureArgs.Builder(surface)
+                    .setSourceCrop(Rect(0, 0, width, height))
+                    .build()
+            )
+        val bitmap = capture?.asBitmap()
+        capture?.hardwareBuffer?.close()
+        if (bitmap == null) {
+            snapshotSkipped = "capture failed"
+            Log.w(TAG, "lock screen capture failed")
+            return
+        }
+        pendingSnapshot.set(Snapshot(bitmap, start))
+        val took = SystemClock.uptimeMillis() - start
+        Log.i(TAG, "lock screen captured ${width}x$height in $took ms")
+    }
+
+    private fun buildContent() {
+        val view = page ?: return
+        view.removeAllViews()
+        clockTime = null
+        clockDate = null
+        val res = context.resources
+        fun dp(value: Int) = (value * res.displayMetrics.density).toInt()
+        view.setBackgroundColor(Color.WHITE) // Opaque paper over every keyguard view.
+        fun lockedAtText() =
+            TextView(context).apply {
+                setTextColor(Color.BLACK)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 22f)
+                gravity = Gravity.CENTER
+                text = context.getString(R.string.hibreak_eink_sleep_locked_at, lockedAt)
+            }
+        fun column() =
+            LinearLayout(context).apply {
+                orientation = LinearLayout.VERTICAL
+                gravity = Gravity.CENTER
+            }
+        val wrap = LinearLayout.LayoutParams.WRAP_CONTENT
+        val match = LinearLayout.LayoutParams.MATCH_PARENT
+        val content: View =
+            when (kind) {
+                Kind.PICTURE ->
+                    column().apply {
+                        addView(
+                            ImageView(context).apply {
+                                setImageResource(R.drawable.hibreak_eink_sleep_logo)
+                                scaleType = ImageView.ScaleType.FIT_CENTER
+                            },
+                            LinearLayout.LayoutParams(dp(192), dp(96)),
+                        )
+                        addView(
+                            lockedAtText(),
+                            LinearLayout.LayoutParams(wrap, wrap).apply { topMargin = dp(24) },
+                        )
+                    }
+                Kind.CLOCK ->
+                    column().apply {
+                        val time =
+                            TextView(context).apply {
+                                setTextColor(Color.BLACK)
+                                gravity = Gravity.CENTER
+                                maxLines = 1
+                                includeFontPadding = false
+                                setAutoSizeTextTypeUniformWithConfiguration(
+                                    32, 160, 2, TypedValue.COMPLEX_UNIT_SP)
+                            }
+                        val date =
+                            TextView(context).apply {
+                                setTextColor(Color.BLACK)
+                                setTextSize(TypedValue.COMPLEX_UNIT_SP, 26f)
+                                gravity = Gravity.CENTER
+                            }
+                        addView(time, LinearLayout.LayoutParams(match, dp(180)))
+                        addView(
+                            date,
+                            LinearLayout.LayoutParams(wrap, wrap).apply { topMargin = dp(8) },
+                        )
+                        setPadding(dp(24), 0, dp(24), 0)
+                        clockTime = time
+                        clockDate = date
+                    }
+                Kind.LOCK_SCREEN ->
+                    ImageView(context).apply {
+                        val snapshot = shownSnapshot
+                        setImageBitmap(snapshot?.bitmap)
+                        // The capture is in window coordinates.
+                        scaleType = ImageView.ScaleType.MATRIX
+                        val location = IntArray(2)
+                        view.getLocationInWindow(location)
+                        imageMatrix =
+                            Matrix().apply {
+                                setTranslate(-location[0].toFloat(), -location[1].toFloat())
+                            }
+                    }
+                Kind.CUSTOM ->
+                    column().apply {
+                        addView(
+                            ImageView(context).apply {
+                                setImageBitmap(customImage?.bitmap)
+                                scaleType = ImageView.ScaleType.FIT_CENTER
+                            },
+                            LinearLayout.LayoutParams(match, 0, 1f),
+                        )
+                        if (showLockTime) {
+                            addView(
+                                lockedAtText(),
+                                LinearLayout.LayoutParams(wrap, wrap).apply {
+                                    topMargin = dp(16)
+                                    bottomMargin = dp(48)
+                                },
+                            )
+                        }
+                    }
+            }
+        view.addView(content, FrameLayout.LayoutParams(match, match))
+        if (kind == Kind.CLOCK) updateClock()
+    }
+
+    private fun updateClock() {
+        val now = Date()
+        val locale = Locale.getDefault()
+        val skeleton = if (DateFormat.is24HourFormat(context, userTracker.userId)) "Hm" else "hm"
+        clockTime?.text =
+            android.icu.text.SimpleDateFormat(
+                    DateFormat.getBestDateTimePattern(locale, skeleton), locale)
+                .format(now)
+        clockDate?.text =
+            android.icu.text.SimpleDateFormat(
+                    DateFormat.getBestDateTimePattern(locale, "EEEEMMMMd"), locale)
+                .format(now)
+    }
+
+    /**
+     * Reports the first frame that draws the page while it is actually visible (the keyguard may
+     * only become visible later in going to sleep) and the display is on (a draw skipped with the
+     * display off still applies pending transactions) once SurfaceFlinger has presented it: the
+     * transaction completed callback of that frame, then its present fence.
+     */
+    private fun watchPresented(view: PageView, current: Int) {
+        removePresentListener()
+        val observer = view.viewTreeObserver
+        val listener =
+            object : ViewTreeObserver.OnPreDrawListener {
+                override fun onPreDraw(): Boolean {
+                    if (generation != current) {
+                        removePresentListener()
+                        return true
+                    }
+                    if (!isEffectivelyVisible(view) || !isDisplayOn(view)) return true
+                    removePresentListener()
+                    val transaction = SurfaceControl.Transaction()
+                    transaction.addTransactionCompletedListener(bgExecutor) { stats ->
+                        stats.presentFence.use { fence ->
+                            if (fence.isValid) fence.await(PRESENT_FENCE_WAIT)
+                        }
+                        context.mainExecutor.execute {
+                            if (generation == current) {
+                                sleepScreenGate.onPagePresented(SystemClock.uptimeMillis())
+                            }
+                        }
+                    }
+                    if (view.rootSurfaceControl?.applyTransactionOnDraw(transaction) != true) {
+                        transaction.close()
+                        // No surface to attach to: fall back to the frame commit callback.
+                        view.viewTreeObserver.registerFrameCommitCallback {
+                            if (generation == current) {
+                                sleepScreenGate.onPagePresented(SystemClock.uptimeMillis())
+                            }
+                        }
+                    }
+                    return true
+                }
+            }
+        observer.addOnPreDrawListener(listener)
+        presentListener = observer to listener
+        view.invalidate()
+    }
+
+    private fun removePresentListener() {
+        val (observer, listener) = presentListener ?: return
+        presentListener = null
+        if (observer.isAlive) observer.removeOnPreDrawListener(listener)
+    }
+
+    /** Attached, in a visible window, every ancestor visible and not fully transparent. */
+    private fun isEffectivelyVisible(view: View): Boolean {
+        if (!view.isShown || view.windowVisibility != View.VISIBLE) return false
+        var current: View? = view
+        while (current != null) {
+            if (current.alpha <= 0f) return false
+            current = current.parent as? View
+        }
+        return true
+    }
+
+    private fun isDisplayOn(view: PageView): Boolean {
+        if (view.screenOff) return false
+        val state = view.display?.state ?: return false
+        return state == Display.STATE_ON || state == Display.STATE_DOZE ||
+            state == Display.STATE_VR
+    }
+
+    /** Picture mode: the AOD notification icons stay above the opaque page while it is shown. */
+    private fun iconsZ() = if (shown && kind == Kind.PICTURE) PAGE_Z + 1f else 0f
+
+    private fun setIconsAbovePage(above: Boolean) {
+        root?.findViewById<View>(ICONS_ID)?.translationZ = if (above) PAGE_Z + 1f else 0f
+    }
+
+    private fun readSetting(key: String): String? =
+        Settings.Secure.getStringForUser(
+            userTracker.userContext.contentResolver, key, userTracker.userId)
+
+    private fun readIntSetting(key: String, default: Int): Int =
+        Settings.Secure.getIntForUser(
+            userTracker.userContext.contentResolver, key, default, userTracker.userId)
+
+    private fun customImageKey(): String? {
+        val token = readSetting(EinkSleepScreenGate.SETTING_IMAGE)
+        return if (TextUtils.isEmpty(token)) null else "${userTracker.userId}/$token"
+    }
+
+    /**
+     * Custom image mode: keep the chosen image decoded so the page can show it at once when
+     * going to sleep. Read through the E-Ink app's provider in the current user; the app keeps
+     * its own copy, already fitted to the display.
+     */
+    private fun reloadCustomImage() {
+        if (readSetting(EinkSleepScreenGate.SETTING_MODE) != EinkSleepScreenGate.MODE_CUSTOM) {
+            customImage = null
+            customImageError = null
+            customImageLoading = null
+            return
+        }
+        val key = customImageKey()
+        if (key == null) {
+            customImage = null
+            customImageError = "not chosen"
+            customImageLoading = null
+            return
+        }
+        if (customImage?.key == key || customImageLoading == key) return
+        customImageLoading = key
+        val userContext = userTracker.userContext
+        val bounds =
+            context.getSystemService(WindowManager::class.java)?.maximumWindowMetrics?.bounds
+        val maxWidth = bounds?.width()?.takeIf { it > 0 } ?: 1080
+        val maxHeight = bounds?.height()?.takeIf { it > 0 } ?: 1920
+        bgExecutor.execute {
+            var bitmap: Bitmap? = null
+            var error: String? = null
+            try {
+                val source = ImageDecoder.createSource(userContext.contentResolver, IMAGE_URI)
+                bitmap =
+                    ImageDecoder.decodeBitmap(source) { decoder, info, _ ->
+                        decoder.allocator = ImageDecoder.ALLOCATOR_HARDWARE
+                        val w = info.size.width
+                        val h = info.size.height
+                        val scale = minOf(1f, maxWidth.toFloat() / w, maxHeight.toFloat() / h)
+                        if (scale < 1f) {
+                            decoder.setTargetSize(
+                                (w * scale).toInt().coerceAtLeast(1),
+                                (h * scale).toInt().coerceAtLeast(1),
+                            )
+                        }
+                    }
+            } catch (e: Exception) {
+                error = "unreadable (${e.javaClass.simpleName}: ${e.message})"
+            }
+            context.mainExecutor.execute {
+                if (customImageLoading != key) return@execute
+                customImageLoading = null
+                if (bitmap != null) {
+                    customImage = CustomImage(key, bitmap)
+                    customImageError = null
+                    Log.i(TAG, "custom image loaded ${bitmap.width}x${bitmap.height}")
+                } else {
+                    customImage = null
+                    customImageError = error
+                    Log.w(TAG, "custom image $error")
+                }
+            }
+        }
+    }
+
+    companion object {
+        private const val TAG = "EinkSleepScreen"
+        /** Above every keyguard view; the AOD icons use PAGE_Z + 1 in picture mode. */
+        private const val PAGE_Z = 1000f
+        private val ICONS_ID = R.id.aod_notification_icon_container
+        /** Bound for waiting on the present fence of the page frame (off the main thread). */
+        private val PRESENT_FENCE_WAIT: Duration = Duration.ofMillis(500)
+        /** A lock screen capture older than this is not from this sleep. */
+        private const val SNAPSHOT_MAX_AGE_MS = 5000L
+        /** The E-Ink app's read-only copy of the chosen image. */
+        private val IMAGE_URI: Uri =
+            Uri.parse("content://net.dianqk.hibreak.eink.sleepscreen/image")
+    }
+}
