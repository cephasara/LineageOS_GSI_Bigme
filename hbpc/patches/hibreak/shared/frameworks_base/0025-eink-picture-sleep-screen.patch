+package com.android.systemui.doze
+
+import android.content.Context
+import android.os.Handler
+import android.os.SystemClock
+import android.os.SystemProperties
+import android.util.Log
+import com.android.keyguard.EinkKeyguard
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.res.R
+import javax.inject.Inject
+
+/**
+ * E-Ink sleep screen: holds the doze screen-off request until the sleep page has been presented
+ * and the panel had time to finish its update. Without this the display turns off within a few
+ * tens of milliseconds of going to sleep and cuts the E-Ink update short, leaving the previous
+ * image on the panel.
+ *
+ * The page ([com.android.systemui.keyguard.ui.view.layout.sections.EinkSleepScreenSection])
+ * registers itself as [page] and reports when it is shown and when a frame containing it has
+ * been presented. [DozeScreenState] asks to wait before requesting the display OFF on the first
+ * DOZE transition. [EinkSleepScreenRefresher] (clock mode) turns the display on again for a
+ * bounded window with [awaitRefresh] so that a redrawn page reaches the panel. Every wait ends:
+ * after the settle time from presentation, or after its timeout.
+ *
+ * Main thread only, except [onStartedGoingToSleep].
+ */
+@SysUISingleton
+open class EinkSleepScreenGate @Inject constructor(
+    private val context: Context,
+    @Main private val handler: Handler,
+) {
+    /** The visible sleep page, as seen by the doze parts. */
+    interface Page {
+        /**
+         * Redraw the page content for a refresh while asleep (clock mode) and watch for the next
+         * presented frame. Returns false if the page is not shown or has nothing to refresh.
+         */
+        fun refresh(): Boolean
+
+        /**
+         * Called on a binder thread at the very start of going to sleep, before SystemUI reacts
+         * to it, so the page can capture the keyguard as it is still shown (lock screen mode).
+         */
+        fun onStartedGoingToSleep() {}
+    }
+
+    /** Set by the section of the active keyguard blueprint. */
+    @Volatile var page: Page? = null
+
+    private var shownAt = NONE
+    private var presentedAt = NONE
+    private var waitStart = NONE
+    private var release: Runnable? = null
+    private var onCancelled: Runnable? = null
+    private var label = ""
+
+    private val settled = Runnable { finish("settled") }
+    private val timedOut = Runnable { finish("timeout") }
+
+    /** Whether the doze screen-off waits for the sleep page (AOD off is checked by the caller). */
+    open fun isWaitEnabled(): Boolean = isEnabled(context)
+
+    /** A screen-off wait or a refresh window is pending. */
+    open fun isWaiting(): Boolean = release != null
+
+    /** KeyguardService binder thread: the device starts going to sleep. */
+    open fun onStartedGoingToSleep() {
+        try {
+            page?.onStartedGoingToSleep()
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "going-to-sleep hook failed", e)
+        }
+    }
+
+    /** The page became visible for this sleep. */
+    open fun onPageShown(uptime: Long) {
+        shownAt = uptime
+        presentedAt = NONE
+    }
+
+    /** A frame containing the visible page has been presented on the display. */
+    open fun onPagePresented(uptime: Long) {
+        if (shownAt == NONE || presentedAt != NONE) return
+        presentedAt = uptime
+        Log.i(TAG, "${label}page presented +${uptime - shownAt} ms")
+        if (release != null) scheduleSettle()
+    }
+
+    /** The page was removed (waking up). A pending wait runs into its timeout or is cancelled. */
+    open fun onPageHidden() {
+        shownAt = NONE
+        presentedAt = NONE
+        handler.removeCallbacks(settled)
+    }
+
+    /**
+     * Run [onRelease] once the page has been presented and settled, or after the timeout. A
+     * previous wait is cancelled without running its callback.
+     */
+    open fun awaitScreenOff(onRelease: Runnable) {
+        cancel()
+        label = ""
+        release = onRelease
+        waitStart = SystemClock.uptimeMillis()
+        Log.i(TAG, "screen-off control: waiting" +
+            (if (presentedAt != NONE) " (page presented)"
+                else if (shownAt != NONE) " (page shown)" else " (page not shown yet)"))
+        handler.postDelayed(timedOut, context.resources.getInteger(
+            R.integer.config_einkSleepTimeoutMs).toLong())
+        if (presentedAt != NONE) scheduleSettle()
+    }
+
+    /**
+     * Refresh window while asleep with the display off: the page redraws itself, [screenOn]
+     * turns the display on, and [onRelease] (display off again) runs once the redrawn page was
+     * presented and settled, or after config_einkSleepRefreshTimeoutMs. [cancelled] runs instead
+     * if the window is dropped (waking up). Returns false, running nothing, when no shown page
+     * can refresh or another wait is pending.
+     */
+    open fun awaitRefresh(
+        reason: String,
+        screenOn: Runnable,
+        onRelease: Runnable,
+        cancelled: Runnable,
+    ): Boolean {
+        if (release != null) return false
+        val current = page ?: return false
+        shownAt = SystemClock.uptimeMillis()
+        presentedAt = NONE
+        if (!current.refresh()) {
+            shownAt = NONE
+            return false
+        }
+        label = "refresh: "
+        release = onRelease
+        onCancelled = cancelled
+        waitStart = shownAt
+        Log.i(TAG, "refresh ($reason): display on")
+        handler.postDelayed(timedOut, context.resources.getInteger(
+            R.integer.config_einkSleepRefreshTimeoutMs).toLong())
+        screenOn.run()
+        return true
+    }
+
+    /** Drop a pending wait without releasing (the doze state moved on, e.g. waking up). */
+    open fun cancel() {
+        if (release == null) return
+        handler.removeCallbacks(settled)
+        handler.removeCallbacks(timedOut)
+        release = null
+        val cancelled = onCancelled
+        onCancelled = null
+        val elapsed = SystemClock.uptimeMillis() - waitStart
+        Log.i(TAG, "${label.ifEmpty { "screen-off " }}wait cancelled +$elapsed ms")
+        cancelled?.run()
+    }
+
+    private fun scheduleSettle() {
+        handler.removeCallbacks(settled)
+        val settle = context.resources.getInteger(R.integer.config_einkSleepSettleMs).toLong()
+        val delay = (presentedAt + settle - SystemClock.uptimeMillis()).coerceAtLeast(0L)
+        handler.postDelayed(settled, delay)
+    }
+
+    private fun finish(reason: String) {
+        val callback = release ?: return
+        handler.removeCallbacks(settled)
+        handler.removeCallbacks(timedOut)
+        release = null
+        onCancelled = null
+        val elapsed = SystemClock.uptimeMillis() - waitStart
+        Log.i(TAG, "$label$reason, releasing screen off +$elapsed ms")
+        callback.run()
+    }
+
+    companion object {
+        const val TAG = "EinkSleepScreen"
+        /** Kill switch, default on. false: no forced doze component, no screen-off wait. */
+        const val PROP_WAIT = "persist.debug.hibreak.sleep_screen_wait"
+        private const val NONE = -1L
+
+        /** Settings.Secure key written by the E-Ink app (per user). */
+        const val SETTING_MODE = "hibreak_sleep_screen_mode"
+        /** Settings.Secure: version token of the custom image; empty or missing: none. */
+        const val SETTING_IMAGE = "hibreak_sleep_screen_image"
+        /** Settings.Secure int: show "Locked at" under the custom image (default 1). */
+        const val SETTING_IMAGE_TIME = "hibreak_sleep_screen_image_time"
+
+        const val MODE_PICTURE = "picture"
+        const val MODE_LOCK_SCREEN = "lockscreen"
+        const val MODE_CUSTOM = "custom"
+        private const val MODE_CLOCK_PREFIX = "clock_"
+        private val CLOCK_INTERVALS = intArrayOf(1, 5, 15)
+
+        /** Minutes between clock updates for clock_1/clock_5/clock_15, otherwise 0. */
+        @JvmStatic
+        fun clockInterval(mode: String?): Int {
+            if (mode == null || !mode.startsWith(MODE_CLOCK_PREFIX)) return 0
+            val minutes = mode.substring(MODE_CLOCK_PREFIX.length).toIntOrNull() ?: return 0
+            return if (minutes in CLOCK_INTERVALS) minutes else 0
+        }
+
+        /**
+         * E-Ink keyguard policy and the kill switch. The doze dream that runs this wait with
+         * ambient display off is started by system_server (framework config_einkDozeOnSleep,
+         * same kill switch); without it SystemUI behaves as before.
+         */
+        @JvmStatic
+        fun isEnabled(context: Context): Boolean =
+            EinkKeyguard.isEnabled(context) && SystemProperties.getBoolean(PROP_WAIT, true)
+    }
+}
