new file mode 100644
index 0000000..1ac2e88
--- /dev/null
+++ b/bigme-eink/overlay/frameworks/base/packages/SystemUI/res/values/hibreak_opaque_surfaces.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <color name="shade_panel_fallback">@android:color/white</color>
+    <color name="notification_scrim_fallback">@android:color/white</color>
+    <bool name="config_supportBlurredWallpaper">false</bool>
+    <!-- Expanded groups keep one framed background instead of a stroked box per child. -->
+    <bool name="config_showGroupNotificationBgWhenExpanded">true</bool>
+    <!-- Media output content corners match the 28dp dialog window edge. -->
+    <dimen name="media_output_dialog_corner_radius">28dp</dimen>
+</resources>
