+    <!-- E-Ink defaults: users can re-enable any scale after first boot. -->
+    <fraction name="def_window_animation_scale">0%</fraction>
+    <fraction name="def_window_transition_scale">0%</fraction>
+
+</resources>
diff --git a/hibreak-common.mk b/hibreak-common.mk
new file mode 100644
index 0000000..8a054bd
--- /dev/null
+++ b/hibreak-common.mk
@@ -0,0 +1,11 @@
+# HiBreak Pro Color GSI: keep the existing kernel/vendor and signing identity.
+$(call inherit-product, device/phh/treble/bigme-device/device.mk)
+$(call inherit-product, device/phh/treble/bigme-display/display.mk)
+$(call inherit-product, device/phh/treble/bigme-eink/eink.mk)
+PRODUCT_COMPRESSED_APEX := false
+# HiBreak Pro Color vendor is VNDK 31 only. Assign (not append) after the upstream
+# inherits so the 28/29/30 and gsi_release.mk 32-34 snapshots are not shipped.
+PRODUCT_EXTRA_VNDK_VERSIONS := 31
+PRODUCT_PACKAGE_OVERLAYS := device/phh/treble/bigme-device/overlay device/phh/treble/bigme-eink/overlay $(PRODUCT_PACKAGE_OVERLAYS)
+PRODUCT_SYSTEM_PROPERTIES += ro.adb.secure=1
+PRODUCT_SYSTEM_PROPERTIES += persist.sys.usb.config=none
diff --git a/lineage_arm64_bgN4.mk b/lineage_arm64_bgN4.mk
index 20e52c5..7e755af 100644
--- a/lineage_arm64_bgN4.mk
+++ b/lineage_arm64_bgN4.mk
@@ -2,7 +2,7 @@ TARGET_GAPPS_ARCH := arm64
 include build/make/target/product/aosp_arm64.mk
 $(call inherit-product, device/phh/treble/base.mk)
 
-$(call inherit-product-if-exists, vendor/gapps/arm64/arm64-vendor.mk)
+$(call inherit-product, vendor/gapps/arm64/arm64-vendor.mk)
 $(call inherit-product, device/phh/treble/lineage.mk)
 
