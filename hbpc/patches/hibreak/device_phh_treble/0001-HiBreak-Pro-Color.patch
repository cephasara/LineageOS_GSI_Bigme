From: HiBreak Pro Color <hibreak@localhost>
Date: Sat, 5 Sep 2026 18:16:23 +0800
Subject: [PATCH] HiBreak Pro Color: Android 16 device/phh/treble essentials

Ported from the validated 22.2 baseline; keep the existing kernel/vendor.
Ship only the VNDK 31 snapshot used by the HiBreak Pro Color vendor.
Run the XRZ composer at 120 Hz like stock 3.4.6 (persist.vendor.xrz.fps=120) and render at 40 Hz by default (config_defaultRefreshRate).
The white default wallpaper is overlaid only where the framework ships one (nodpi, sw600dp-nodpi, sw720dp-nodpi); the five density/television copies are gone. eink.mk comment updated (the sleep screen exists now).
The white wallpaper is also overlaid at hdpi, xhdpi, xxhdpi and xxxhdpi: vendor/lineage/overlay/common ships its own wallpaper at those densities, and on this 300 dpi panel its xhdpi copy was chosen over nodpi. config_wallpaperCropperPackage names com.android.wallpaper (ThemePicker); the phh value com.android.wallpaperpicker is not installed.
---

diff --git a/bigme-device/Android.bp b/bigme-device/Android.bp
new file mode 100644
index 0000000..6b30158
--- /dev/null
+++ b/bigme-device/Android.bp
@@ -0,0 +1,9 @@
+package {
+    default_applicable_licenses: ["Android-Apache-2.0"],
+}
+
+override_android_app {
+    name: "HiBreakProvision",
+    base: "Provision",
+    overrides: ["Provision", "LineageSetupWizard", "SetupWizard"],
+}
diff --git a/bigme-device/device.mk b/bigme-device/device.mk
new file mode 100644
index 0000000..6bed12e
--- /dev/null
+++ b/bigme-device/device.mk
@@ -0,0 +1,5 @@
+# Silent first boot is intentional for this HiBreak-only GSI.
+PRODUCT_PACKAGES += HiBreakProvision
+
+# Only present when explicitly selected by build-hibreak.py --debug-adb.
+-include device/phh/treble/bigme-debug-adb/debug.mk
diff --git a/bigme-device/overlay/frameworks/base/core/res/res/values/config.xml b/bigme-device/overlay/frameworks/base/core/res/res/values/config.xml
new file mode 100644
index 0000000..656de1d
--- /dev/null
+++ b/bigme-device/overlay/frameworks/base/core/res/res/values/config.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <integer name="config_defaultNightMode">1</integer>
+    <!-- The XRZ composer offers one 120 Hz mode (persist.vendor.xrz.fps). Render at
+         40 Hz (120 / 3) by default; each frame is a full client composite and the
+         panel cannot show more. Hyper raises min_refresh_rate to the full rate. -->
+    <integer name="config_defaultRefreshRate">40</integer>
+    <!-- Fallback CROP_AND_SET_WALLPAPER handler: the installed picker (ThemePicker). -->
+    <string name="config_wallpaperCropperPackage" translatable="false">com.android.wallpaper</string>
+</resources>
diff --git a/bigme-display/.gitignore b/bigme-display/.gitignore
new file mode 100644
index 0000000..f9f473e
--- /dev/null
+++ b/bigme-display/.gitignore
@@ -0,0 +1 @@
+/eink_key
diff --git a/bigme-display/display.mk b/bigme-display/display.mk
new file mode 100644
index 0000000..a3b3b1d
--- /dev/null
+++ b/bigme-display/display.mk
@@ -0,0 +1,16 @@
+# HiBreak Pro Color display/input compatibility, retained after debug cleanup.
+PRODUCT_COPY_FILES += \
+    device/phh/treble/bigme-display/eink_key:$(TARGET_COPY_OUT_SYSTEM)/eink_key \
+    device/phh/treble/bigme-display/elan_ktf.idc:$(TARGET_COPY_OUT_SYSTEM)/usr/idc/elan_ktf.idc \
+    device/phh/treble/bigme-display/fts_ts_pen.idc:$(TARGET_COPY_OUT_SYSTEM)/usr/idc/fts_ts_pen.idc
+PRODUCT_SYSTEM_PROPERTIES += \
+    ro.bigme.force_client_composition=true \
+    persist.vendor.xrz.fps=120 \
+    persist.vendor.xrz.fps_low=40 \
+    persist.vendor.xrz.fps_high=50 \
+    ro.vendor.xrz.display_policy_version=12 \
+    ro.vendor.xrz.phy_rotation=270 \
+    ro.vendor.xrz.screen_type=61 \
+    ro.vendor.xrz.support_eink_animation=1 \
+    ro.vendor.xrz.support_follow_system_rotate=1 \
+    vendor.xrz.disable_eink_vsync=1
diff --git a/bigme-display/elan_ktf.idc b/bigme-display/elan_ktf.idc
new file mode 100644
index 0000000..4bb7abf
--- /dev/null
+++ b/bigme-display/elan_ktf.idc
@@ -0,0 +1,4 @@
+# Bigme HiBreak Pro Color touch panel is mounted 270 degrees from Android's
+# portrait logical display.
+touch.orientationAware = 1
+touch.orientation = ORIENTATION_270
diff --git a/bigme-display/fts_ts_pen.idc b/bigme-display/fts_ts_pen.idc
new file mode 100644
index 0000000..df41241
--- /dev/null
+++ b/bigme-display/fts_ts_pen.idc
@@ -0,0 +1,4 @@
+# Bigme HiBreak Pro Color pen digitizer shares the landscape physical panel
+# orientation with the touch controller.
+touch.orientationAware = 1
+touch.orientation = ORIENTATION_270
diff --git a/bigme-eink/eink.mk b/bigme-eink/eink.mk
new file mode 100644
index 0000000..98e3816
--- /dev/null
+++ b/bigme-eink/eink.mk
@@ -0,0 +1,5 @@
+# HiBreak Pro Color E-Ink services (settings app, daemon) and display properties.
+$(call inherit-product, vendor/a9_services/a9_services.mk)
+PRODUCT_SYSTEM_PROPERTIES += \
+    debug.sf.nobootanimation=1 \
+    ro.surface_flinger.supports_background_blur=0
