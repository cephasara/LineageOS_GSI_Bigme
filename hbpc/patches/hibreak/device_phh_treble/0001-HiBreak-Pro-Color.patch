diff --git a/bigme-eink/overlay/frameworks/base/core/res/res/values/hibreak_eink_rendering_defaults.xml b/bigme-eink/overlay/frameworks/base/core/res/res/values/hibreak_eink_rendering_defaults.xml
new file mode 100644
index 0000000..3029ea4
--- /dev/null
+++ b/bigme-eink/overlay/frameworks/base/core/res/res/values/hibreak_eink_rendering_defaults.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Avoid full-window transition frames that leave E-Ink ghosting. -->
+    <bool name="config_disableTransitionAnimation">true</bool>
+
+    <!-- A blinking caret causes a permanent 500 ms partial-update loop. -->
+    <bool name="config_einkStaticTextCursor">true</bool>
+    <!-- Shared framework policy, with no application/device-name branches. -->
+    <bool name="config_flatWindowAppearance">true</bool>
+    <bool name="config_staticTouchFeedback">true</bool>
+</resources>
